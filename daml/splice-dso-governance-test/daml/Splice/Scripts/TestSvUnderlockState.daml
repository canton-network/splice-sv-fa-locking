module Splice.Scripts.TestSvUnderlockState where

import DA.Action (unless)
import DA.Assert
import DA.Date
import DA.Either (isLeft)
import DA.Foldable (forA_)
import DA.Time

import Daml.Script

import Splice.DSO.SvState

-- Shared values
----------------

t0 : Time
t0 = datetime 2027 Jan 1 0 0 0

-- | `n` days after `t0`.
day : Int -> Time
day n = t0 `addRelTime` days n

permanentGrace : RelTime
permanentGrace = days 30

-- | An underlock to `weightFactor` that becomes permanent at `permanentAt`.
event : Time -> Decimal -> UnderlockEvent
event permanentAt weightFactor = UnderlockEvent with permanentAt; weightFactor

adjState : Decimal -> [UnderlockEvent] -> RewardAdjustmentState
adjState permanentWeightFactor recoverableUnderlocks = RewardAdjustmentState with
  permanentWeightFactor
  recoverableUnderlocks
  lastAdjustedAt = None

-- | `recoverableUnderlocks` has the latest deadline first, factors strictly increase along the list,
-- and every factor is below `permanentWeightFactor`.
invariantHolds : RewardAdjustmentState -> Bool
invariantHolds s =
  and (zipWith (\newer older -> newer.permanentAt >= older.permanentAt && newer.weightFactor < older.weightFactor) events (drop 1 events))
  && all (\e -> e.weightFactor < s.permanentWeightFactor) events
  where events = s.recoverableUnderlocks

checkInvariant : RewardAdjustmentState -> Script ()
checkInvariant s = unless (invariantHolds s) $ abort ("invariant violated: " <> show s)

-- | The temporary update `DsoRules_ExecuteSvUnderlockInstruction` makes, with the default 30-day permanent grace period.
applyAt : Time -> Decimal -> RewardAdjustmentState -> RewardAdjustmentState
applyAt = applyWarrantedFactor permanentGrace

-- | The permanent enforcement `DsoRules_EnforceSvPermanentUnderlock` makes, as a pure function.
enforceAt : Time -> RewardAdjustmentState -> Either Text RewardAdjustmentState
enforceAt = enforcePermanentUnderlock

-- | Enforce, expecting it to succeed.
enforced : Time -> RewardAdjustmentState -> Script RewardAdjustmentState
enforced now s = either (\err -> abort ("enforcement failed: " <> err)) pure (enforceAt now s)

-- | The factor coupon creation applies, read back through `getAdjustedRewardWeight` with a weight of 10000
-- (exact for the two-decimal factors used here).
factorOf : RewardAdjustmentState -> Decimal
factorOf s = intToDecimal (getAdjustedRewardWeight (Some s) 10000) / 10000.0

-- applyWarrantedFactor
-----------------------

test_applyWarrantedFactor : Script ()
test_applyWarrantedFactor = script do
  let fresh = defaultRewardAdjustmentState

  -- A new underlock becomes permanent after the grace period
  applyAt (day 1) 0.6 fresh === adjState 1.0 [event (day 31) 0.6]

  -- Full recovery or no underlock at all: nothing recorded
  applyAt (day 1) 1.0 fresh === fresh
  applyAt (day 2) 1.0 (adjState 1.0 [event (day 31) 0.6]) === fresh

  -- Re-observing the same factor keeps the original deadline
  let single = adjState 1.0 [event (day 31) 0.6]
  applyAt (day 5) 0.6 single === single

  -- A deeper underlock is added in front with its own deadline, the older one stays
  let staggered = applyAt (day 4) 0.4 single
  staggered === adjState 1.0 [event (day 34) 0.4, event (day 31) 0.6]

  -- Partial recovery to a level that was recorded before: back to that underlock and its deadline
  applyAt (day 6) 0.6 staggered === single

  -- Partial recovery to a new level keeps the deadline of the oldest recovered underlock
  applyAt (day 6) 0.5 staggered === adjState 1.0 [event (day 34) 0.5, event (day 31) 0.6]
  applyAt (day 6) 0.8 staggered === adjState 1.0 [event (day 31) 0.8]

  -- Recovery above every recorded underlock clears them
  applyAt (day 6) 1.0 staggered === fresh

  -- An underlock past its deadline can no longer be recovered from, even before it's enforced
  applyAt (day 32) 1.0 staggered === single

  -- With a permanent factor: anything at or above it clears the recoverable underlocks, below it underlocks
  let permanent = adjState 0.6 [event (day 70) 0.4]
  applyAt (day 41) 1.0 permanent === adjState 0.6 []
  applyAt (day 41) 0.6 permanent === adjState 0.6 []
  applyAt (day 41) 0.4 permanent === permanent
  applyAt (day 41) 0.0 permanent === adjState 0.6 [event (day 71) 0.0, event (day 70) 0.4]

  -- lastAdjustedAt is left alone
  let withLastAdjusted = single with lastAdjustedAt = Some (day 1)
  (applyAt (day 5) 0.4 withLastAdjusted).lastAdjustedAt === Some (day 1)

  forA_ [single, staggered, permanent] checkInvariant

-- enforcePermanentUnderlock
----------------------------

test_enforcePermanentUnderlock : Script ()
test_enforcePermanentUnderlock = script do
  let staggered = adjState 1.0 [event (day 34) 0.4, event (day 31) 0.6]

  -- Nothing past its deadline: fails
  assert $ isLeft (enforceAt (day 30) staggered)
  assert $ isLeft (enforceAt (day 100) defaultRewardAdjustmentState)

  -- An underlock exactly at its deadline becomes permanent; later ones stay recoverable
  enforced (day 31) staggered >>= (=== adjState 0.6 [event (day 34) 0.4])
  enforced (day 33) staggered >>= (=== adjState 0.6 [event (day 34) 0.4])

  -- Both past their deadline: the lowest factor becomes permanent
  enforced (day 34) staggered >>= (=== adjState 0.4 [])

  -- An existing lower permanent factor is never raised
  enforced (day 34) (adjState 0.3 [event (day 34) 0.2]) >>= (=== adjState 0.2 [])

  -- lastAdjustedAt is left alone
  s <- enforced (day 34) (staggered with lastAdjustedAt = Some (day 4))
  s.lastAdjustedAt === Some (day 4)

  enforced (day 31) staggered >>= checkInvariant

-- Coupon weight
----------------

-- | Underlocks take effect immediately: the factor is the newest recorded underlock's, otherwise the permanent factor.
test_couponFactor : Script ()
test_couponFactor = script do
  factorOf defaultRewardAdjustmentState === 1.0
  factorOf (adjState 0.6 []) === 0.6
  factorOf (adjState 1.0 [event (day 31) 0.6]) === 0.6

  -- The newest underlock has the lowest factor
  factorOf (adjState 1.0 [event (day 34) 0.4, event (day 31) 0.6]) === 0.4

  -- A recoverable underlock below the permanent factor takes precedence
  factorOf (adjState 0.6 [event (day 70) 0.4]) === 0.4

  -- The permanent factor applies if it's lower (the state functions never produce this, the `min` guards against it)
  factorOf (adjState 0.3 [event (day 70) 0.4]) === 0.3

test_getAdjustedRewardWeight : Script ()
test_getAdjustedRewardWeight = script do
  getAdjustedRewardWeight None 30000 === 30000
  getAdjustedRewardWeight (Some defaultRewardAdjustmentState) 30000 === 30000
  getAdjustedRewardWeight (Some (adjState 1.0 [event (day 31) 0.6])) 30000 === 18000
  getAdjustedRewardWeight (Some (adjState 0.0 [])) 30000 === 0

  -- Rounds down
  getAdjustedRewardWeight (Some (adjState 0.6 [])) 3 === 1

-- CIP examples, step by step through temporary updates and enforcement
-----------------------------------------------------------------------

-- | Temporary loss and recovery: the factor drops immediately and comes back on recovery.
test_cipTemporaryLossAndRecovery : Script ()
test_cipTemporaryLossAndRecovery = script do
  let s1 = applyAt (day 0) 0.6 defaultRewardAdjustmentState
  s1 === adjState 1.0 [event (day 30) 0.6]
  factorOf s1 === 0.6

  let s2 = applyAt (day 10) 1.0 s1
  s2 === defaultRewardAdjustmentState
  factorOf s2 === 1.0
  forA_ [s1, s2] checkInvariant

-- | CIP-0127 "Permanent Loss of Reward Weight": 0% at t1, 60% at t1+10, 40% at t1+20, enforcement after t1+30,
-- then a recovery that can only get back to the permanent 60%.
test_cipPermanentLoss : Script ()
test_cipPermanentLoss = script do
  let s1 = applyAt (day 0) 0.0 defaultRewardAdjustmentState
  s1 === adjState 1.0 [event (day 30) 0.0]

  -- Locking for Tier 2 recovers the 0% underlock, the 60% one keeps its deadline
  let s2 = applyAt (day 10) 0.6 s1
  s2 === adjState 1.0 [event (day 30) 0.6]
  factorOf s2 === 0.6

  -- Dropping to Tier 3 adds a 40% underlock with its own, later deadline
  let s3 = applyAt (day 20) 0.4 s2
  s3 === adjState 1.0 [event (day 50) 0.4, event (day 30) 0.6]
  factorOf s3 === 0.4

  -- After t1+30 the 60% underlock is made permanent
  s4 <- enforced (day 31) s3
  s4 === adjState 0.6 [event (day 50) 0.4]

  -- Locking for Tier 1 removes the pending deadline, the permanent 60% remains
  let s5 = applyAt (day 32) 1.0 s4
  s5 === adjState 0.6 []
  factorOf s5 === 0.6

  -- Same outcome if the recovery is observed before anyone enforced: the 60% underlock is past its deadline
  factorOf (applyAt (day 32) 1.0 s3) === 0.6
  forA_ [s1, s2, s3, s4, s5] checkInvariant

-- | A permanent factor from the past survives any later recovery.
test_cipPermanentSurvivesRecovery : Script ()
test_cipPermanentSurvivesRecovery = script do
  let s1 = applyAt (day 0) 0.6 defaultRewardAdjustmentState
  s2 <- enforced (day 30) s1
  s2 === adjState 0.6 []
  let s3 = applyAt (day 100) 1.0 s2
  s3 === adjState 0.6 []
  factorOf s3 === 0.6
  forA_ [s1, s2, s3] checkInvariant

-- | A tightening schedule at an anniversary is a new underlock whose permanent grace period starts at the anniversary.
test_cipAnniversaryUnderlock : Script ()
test_cipAnniversaryUnderlock = script do
  let anniversary = day 365
  s1 <- enforced (day 30) (applyAt (day 0) 0.6 defaultRewardAdjustmentState)
  let s2 = applyAt anniversary 0.0 s1
  s2 === adjState 0.6 [event (anniversary `addRelTime` permanentGrace) 0.0]
  factorOf s2 === 0.0
  forA_ [s1, s2] checkInvariant

-- | The invariant holds after every temporary update and enforcement of a longer mixed sequence.
test_invariantOverSequence : Script ()
test_invariantOverSequence = script do
  let steps =
        [ (day 0, 0.6), (day 2, 0.4), (day 3, 0.4), (day 5, 0.0), (day 6, 0.5)
        , (day 20, 1.0), (day 21, 0.6), (day 40, 0.4), (day 52, 0.6), (day 90, 1.0), (day 91, 0.0)
        ]
      -- Enforce whatever is due before each temporary update, as an SV would
      step s (t, f) = applyAt t f (either (const s) identity (enforceAt t s))
      run (s, acc) step' = let s' = step s step' in (s', s' :: acc)
      (_, states) = foldl run (defaultRewardAdjustmentState, []) steps
  forA_ states checkInvariant
