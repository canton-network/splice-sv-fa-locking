test_SvRewards_With_InitialRound_In_FirstIssuanceCurve : Script ()
test_SvRewards_With_InitialRound_In_FirstIssuanceCurve = do

    let initialRound = 0
    let expectedIssuancePerSvRewardCoupon = 4.6832923545
 
    (app, dso, (sv1, sv2, sv3, sv4)) <- initDecentralizedSynchronizerWithNonZeroRound False initialRound False

    -- extra party to represent beneficiary
    extraBeneficiary <- allocateParty "beneficiary"

    -- create validator rights for sv1-4, so that runAmuletDepositBots can collect the rewards
    forA_ [sv1, sv2, sv3, sv4] $ \sv -> do
      submit sv $ createCmd ValidatorRight with
        dso
        user = sv
        validator = sv

    let checkSvRewardCouponsDoNotExist round = do
          [] <- queryFilter @SvRewardCoupon app.dso (\co -> co.round == round && co.beneficiary /= extraBeneficiary)
          pure ()
    let checkBalance sv amount = do
          [(_, amulet)] <- query @Amulet sv
          require (show sv <> " balance: expected " <> show amount <> " == " <> show amulet.amount.initialAmount)
            (amulet.amount.initialAmount == amount)
    let getSvRewardWeightAndState sv = do
          (name, info) <- getSvInfoByParty app sv
          [(rewardStateCid, _)] <- queryFilter @SvRewardState dso (\s -> s.svName == name)
          pure (info.svRewardWeight, rewardStateCid)

    let receiveSvRewardCouponFails sv round rulesCid = do
          (weight, rewardStateCid) <- getSvRewardWeightAndState sv
          -- check that collecting the reward coupon fails
          void $ submitMustFail (actAs sv <> readAs dso) $ exerciseCmd rulesCid DsoRules_ReceiveSvRewardCoupon with
            openRoundCid = round._1
            rewardStateCid
            beneficiaries = [(sv, weight)]
            sv = sv
    let receiveSvRewardCoupon : Party -> (ContractId OpenMiningRound, OpenMiningRound) -> ContractId DsoRules -> Script ()
        receiveSvRewardCoupon sv round rulesCid = do
          (weight, rewardStateCid) <- getSvRewardWeightAndState sv
          -- collect reward coupon
          void $ submit (actAs sv <> readAs dso) $ exerciseCmd rulesCid DsoRules_ReceiveSvRewardCoupon with
            openRoundCid = round._1
            rewardStateCid
            beneficiaries = [(sv, weight - 1), (extraBeneficiary, 1)]
            sv = sv
          -- check that the coupon exists and has the right weight
          coupons <- queryFilter @SvRewardCoupon sv (\co -> co.round == round._2.round)
          sortOn (.weight) (map (._2) coupons) === sortOn (.weight)
            [SvRewardCoupon with
                dso = app.dso
                sv
                beneficiary
                weight
                round = round._2.round
                svRightOwnerName = None
              | (beneficiary, weight) <- [(sv, weight - 1), (extraBeneficiary, 1)]]

    [(rulesCid, _)] <- query @DsoRules dso

    [round0, round1, _round2] <- getActiveOpenRoundsSorted app.dso
    [(_, openRound)] <- queryFilter @OpenMiningRound app.dso (\r -> r.round == round0._2.round)
    let createFee = openRound.transferConfigUsd.createFee.fee * openRound.amuletPrice

    -- round0 can be received by both SV1 and SV2
    passTime (hours 1)
    receiveSvRewardCoupon sv1 round0 rulesCid
    receiveSvRewardCoupon sv2 round0 rulesCid

    -- but not twice
    receiveSvRewardCouponFails sv1 round0 rulesCid
    receiveSvRewardCouponFails sv2 round0 rulesCid

    -- round1 can be received (intentionally skipping receiving it for SV2)
    receiveSvRewardCoupon sv1 round1 rulesCid

    -- let's collect the rewards for Round 0: requires two issuing round advances
    -- (create the issuing round and advance time for it to become open)
    runNextIssuance app
    runNextIssuance app

    runAmuletDepositBots app

    -- checking that the rewards are gone and the balances are right
    -- Note: SV1 weight is 10 and SV2 weight is 3
    checkSvRewardCouponsDoNotExist round0._2.round
    [(_, round)] <- queryFilter @IssuingMiningRound app.dso (\r -> r.round == round0._2.round)
    let sv1Weight = intToDecimal $ bpsMultiplier * 10 - 1
    let sv2Weight = intToDecimal $ bpsMultiplier * 3 - 1
    let sv1Balance0 = round.issuancePerSvRewardCoupon * sv1Weight - createFee
    let sv2Balance = round.issuancePerSvRewardCoupon * sv2Weight - createFee
    checkBalance sv1 sv1Balance0
    checkBalance sv2 sv2Balance

    require (show round.issuancePerSvRewardCoupon <> " initIssuancePerSvRewardCoupon: expected ") (round.issuancePerSvRewardCoupon == expectedIssuancePerSvRewardCoupon)

    -- also collect the round 1
    runNextIssuance app
    runAmuletDepositBots app
    checkSvRewardCouponsDoNotExist round1._2.round

    [(_, round)] <- queryFilter @IssuingMiningRound app.dso (\r -> r.round == round1._2.round)
    let sv1Balance1 =
            round.issuancePerSvRewardCoupon * sv1Weight - createFee
            + sv1Balance0
    checkBalance sv1 sv1Balance1
    checkBalance sv2 sv2Balance -- no balance change for SV2 as it did not collect round 1


    -- testing skipping
    -------------------

    -- get the new active rounds
    [round2, round3, _] <- getActiveOpenRoundsSorted app.dso

    -- skip one day
    passTime (days 1)

    -- round3 can be received despite round 2 not yet being recieved, i.e., we can skip rounds
    receiveSvRewardCoupon sv1 round3 rulesCid
    receiveSvRewardCoupon sv2 round3 rulesCid

    checkSvRewardCouponsDoNotExist round2._2.round

    -- check that the coupons for round 2 and 3 are marked as not collected
    [(_, sv1State)] <- queryFilter @SvRewardState dso (\s -> s.svName == "sv1")
    sv1State.state === RewardState with
      numRoundsMissed = 2
      numRoundsCollected = 3
      lastRoundCollected = Round (initialRound + 4)
      numCouponsIssued = 6
      rewardAdjustmentState = None

    [(_, sv2State)] <- queryFilter @SvRewardState dso (\s -> s.svName == "sv2")
    sv2State.state === RewardState with
      numRoundsMissed = 3
      numRoundsCollected = 2
      lastRoundCollected = Round (initialRound + 4)
      numCouponsIssued = 4
      rewardAdjustmentState = None

    -- round2 can no longer be received
    receiveSvRewardCouponFails sv1 round2 rulesCid
    receiveSvRewardCouponFails sv2 round2 rulesCid

    return ()

test_SvRewards_With_InitialRound_In_SecondIssuanceCurve : Script ()
test_SvRewards_With_InitialRound_In_SecondIssuanceCurve = do
    -- The 50k's round is falling in the second issuance curve (approx. 1 year after bootstrap)
    let initialRound = 50000
    let expectedIssuancePerSvRewardCoupon = 1.4049877064

    (app, dso, (sv1, sv2, sv3, sv4)) <- initDecentralizedSynchronizerWithNonZeroRound False initialRound False

    -- extra party to represent beneficiary
    extraBeneficiary <- allocateParty "beneficiary"

    -- create validator rights for sv1-4, so that runAmuletDepositBots can collect the rewards
    forA_ [sv1, sv2, sv3, sv4] $ \sv -> do
      submit sv $ createCmd ValidatorRight with
        dso
        user = sv
        validator = sv

    let checkSvRewardCouponsDoNotExist round = do
          [] <- queryFilter @SvRewardCoupon app.dso (\co -> co.round == round && co.beneficiary /= extraBeneficiary)
          pure ()
    let checkBalance sv amount = do
          [(_, amulet)] <- query @Amulet sv
          require (show sv <> " balance: expected " <> show amount <> " == " <> show amulet.amount.initialAmount)
            (amulet.amount.initialAmount == amount)
    let getSvRewardWeightAndState sv = do
          (name, info) <- getSvInfoByParty app sv
          [(rewardStateCid, _)] <- queryFilter @SvRewardState dso (\s -> s.svName == name)
          pure (info.svRewardWeight, rewardStateCid)

    let receiveSvRewardCouponFails sv round rulesCid = do
          (weight, rewardStateCid) <- getSvRewardWeightAndState sv
          -- check that collecting the reward coupon fails
          void $ submitMustFail (actAs sv <> readAs dso) $ exerciseCmd rulesCid DsoRules_ReceiveSvRewardCoupon with
            openRoundCid = round._1
            rewardStateCid
            beneficiaries = [(sv, weight)]
            sv = sv
    let receiveSvRewardCoupon : Party -> (ContractId OpenMiningRound, OpenMiningRound) -> ContractId DsoRules -> Script ()
        receiveSvRewardCoupon sv round rulesCid = do
          (weight, rewardStateCid) <- getSvRewardWeightAndState sv
          -- collect reward coupon
          void $ submit (actAs sv <> readAs dso) $ exerciseCmd rulesCid DsoRules_ReceiveSvRewardCoupon with
            openRoundCid = round._1
            rewardStateCid
            beneficiaries = [(sv, weight - 1), (extraBeneficiary, 1)]
            sv = sv
          -- check that the coupon exists and has the right weight
          coupons <- queryFilter @SvRewardCoupon sv (\co -> co.round == round._2.round)
          sortOn (.weight) (map (._2) coupons) === sortOn (.weight)
            [SvRewardCoupon with
                dso = app.dso
                sv
                beneficiary
                weight
                round = round._2.round
                svRightOwnerName = None
              | (beneficiary, weight) <- [(sv, weight - 1), (extraBeneficiary, 1)]]

    [(rulesCid, _)] <- query @DsoRules dso

    [round0, round1, _round2] <- getActiveOpenRoundsSorted app.dso
    [(_, openRound)] <- queryFilter @OpenMiningRound app.dso (\r -> r.round == round0._2.round)
    let createFee = openRound.transferConfigUsd.createFee.fee * openRound.amuletPrice

    -- round0 can be received by both SV1 and SV2
    passTime (hours 1)
    receiveSvRewardCoupon sv1 round0 rulesCid
    receiveSvRewardCoupon sv2 round0 rulesCid

    -- but not twice
    receiveSvRewardCouponFails sv1 round0 rulesCid
    receiveSvRewardCouponFails sv2 round0 rulesCid

    -- round1 can be received (intentionally skipping receiving it for SV2)
    receiveSvRewardCoupon sv1 round1 rulesCid

    -- let's collect the rewards for Round 0: requires two issuing round advances
    -- (create the issuing round and advance time for it to become open)
    runNextIssuance app
    runNextIssuance app

    runAmuletDepositBots app

    -- checking that the rewards are gone and the balances are right
    -- Note: SV1 weight is 10 and SV2 weight is 3
    checkSvRewardCouponsDoNotExist round0._2.round
    [(_, round)] <- queryFilter @IssuingMiningRound app.dso (\r -> r.round == round0._2.round)
    let sv1Weight = intToDecimal $ bpsMultiplier * 10 - 1
    let sv2Weight = intToDecimal $ bpsMultiplier * 3 - 1
    let sv1Balance0 = round.issuancePerSvRewardCoupon * sv1Weight - createFee
    let sv2Balance = round.issuancePerSvRewardCoupon * sv2Weight - createFee
    checkBalance sv1 sv1Balance0
    checkBalance sv2 sv2Balance

    require (show round.issuancePerSvRewardCoupon <> " initIssuancePerSvRewardCoupon: expected ") (round.issuancePerSvRewardCoupon == expectedIssuancePerSvRewardCoupon)

    -- also collect the round 1
    runNextIssuance app
    runAmuletDepositBots app
    checkSvRewardCouponsDoNotExist round1._2.round

    [(_, round)] <- queryFilter @IssuingMiningRound app.dso (\r -> r.round == round1._2.round)
    let sv1Balance1 =
            round.issuancePerSvRewardCoupon * sv1Weight - createFee
            + sv1Balance0
    checkBalance sv1 sv1Balance1
    checkBalance sv2 sv2Balance -- no balance change for SV2 as it did not collect round 1

    -- testing skipping
    -------------------

    -- get the new active rounds
    [round2, round3, _] <- getActiveOpenRoundsSorted app.dso

    -- skip one day
    passTime (days 1)

    -- round3 can be received despite round 2 not yet being recieved, i.e., we can skip rounds
    receiveSvRewardCoupon sv1 round3 rulesCid
    receiveSvRewardCoupon sv2 round3 rulesCid

    checkSvRewardCouponsDoNotExist round2._2.round

    -- check that the coupons for round 2 and 3 are marked as not collected
    [(_, sv1State)] <- queryFilter @SvRewardState dso (\s -> s.svName == "sv1")
    sv1State.state === RewardState with
      numRoundsMissed = 2
      numRoundsCollected = 3
      lastRoundCollected = Round (initialRound + 4)
      numCouponsIssued = 6
      rewardAdjustmentState = None

    [(_, sv2State)] <- queryFilter @SvRewardState dso (\s -> s.svName == "sv2")
    sv2State.state === RewardState with
      numRoundsMissed = 3
      numRoundsCollected = 2
      lastRoundCollected = Round (initialRound + 4)
      numCouponsIssued = 4
      rewardAdjustmentState = None

    -- round2 can no longer be received
    receiveSvRewardCouponFails sv1 round2 rulesCid
    receiveSvRewardCouponFails sv2 round2 rulesCid

test_SvRewardStateMerge = do
  (_, dso, (sv1, _, _, _)) <- initMainNet
  [(sv1RewardStateCid1, sv1RewardState)] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  -- create a dummy SvRewardState so we have a duplicate
  sv1RewardStateCid2 <- submit dso $ createCmd sv1RewardState
  rewardStates <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  length rewardStates === 2
  [(rulesCid, _)] <- query @DsoRules dso
  DsoRules_MergeSvRewardStateResult sv1RewardStateCid3 <- submit (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid (DsoRules_MergeSvRewardState "sv1" [sv1RewardStateCid1, sv1RewardStateCid2] (Some sv1))
  rewardStates <- queryFilter @SvRewardState dso (\state -> state.svName == "sv1")
  length rewardStates === 1
  -- Can't merge a single contract
  submitMustFail (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid (DsoRules_MergeSvRewardState "sv1" [sv1RewardStateCid3] (Some sv1))
  -- Cannot merge contracts for different SV names
  [(sv2RewardStateCid1, _)] <- queryFilter @SvRewardState dso (\state -> state.svName == "sv2")
  submitMustFail (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid (DsoRules_MergeSvRewardState "sv1" [sv1RewardStateCid3, sv2RewardStateCid1] (Some sv1))
  pure ()

testLifetimeSvRewardsTracking : Script ()
testLifetimeSvRewardsTracking = do
  (app, (dso), (sv1, sv2, _, _)) <- initMainNetWithSvUnderlockEnforcement
  [(amuletRulesCid, _)] <- query @AmuletRules dso

  -- Create validator rights for sv1-4, so that runAmuletDepositBots can collect the rewards
  forA_ [sv1, sv2] $ \sv -> do
    submit sv $ createCmd ValidatorRight with
      dso
      user = sv
      validator = sv

  [(svRightOwnerCid, svRightOwner)] <- queryFilter @SvRightOwner dso (\s -> s.rightOwnerName == "sv1")

  let checkSvRewardCouponsDoNotExist round = do
        [] <- queryFilter @SvRewardCoupon app.dso (\co -> co.round == round)
        pure ()
  let checkMintReceiptAmount dso amount = do
        [(_, receipt)] <- query @SvRewardMintReceipt dso
        unless (receipt.amount == amount) $ fail
          $ show receipt.svRightOwnerName
            <> " balance: expected "
            <> show amount
            <> " == "
            <> show receipt.amount
  let checkLifetimeRewardTotal : Party -> Party -> Decimal -> Script ()
      checkLifetimeRewardTotal dso sv amount = do
        (name, _) <- getSvInfoByParty app sv
        rewardStates <- queryFilter @SvRewardState dso (\s -> s.svName == name)
        let lifetimeTotal = sum $ flip map (snd <$> rewardStates) $ \r -> fromOptional 0.0 r.lifetimeRewardTotal
        require (show name <> " lifetimeRewardTotal: expected " <> show amount <> " == " <> show lifetimeTotal)
          (lifetimeTotal == amount)
  let receiveSvRewardCoupon : Party -> (ContractId OpenMiningRound, OpenMiningRound) -> ContractId DsoRules -> Script ()
      receiveSvRewardCoupon sv round rulesCid = do
        (name, _) <- getSvInfoByParty app sv
        [(rewardStateCid, _)] <- queryFilter @SvRewardState dso (\s -> s.svName == name)
        -- collect reward coupon
        void $ submit (actAs sv <> readAs dso) $ exerciseCmd rulesCid DsoRules_ReceiveSvRewardCouponV2 with
          sv = sv
          openRoundCid = round._1
          svRewardStates = TextMap.singleton svRightOwner.rightOwnerName (svRightOwnerCid, rewardStateCid)
          amuletRulesCid

  [(rulesCid, _)] <- query @DsoRules dso

  [round0, round1, round2] <- getActiveOpenRoundsSorted app.dso

  -- round0 can be received by both SV1 and SV2
  passTime (hours 1)
  receiveSvRewardCoupon sv1 round0 rulesCid
  receiveSvRewardCoupon sv1 round1 rulesCid

  runNextIssuance app
  runNextIssuance app

  runAmuletDepositBots app
  checkSvRewardCouponsDoNotExist round0._2.round

  [(_, round)] <- queryFilter @IssuingMiningRound app.dso (\r -> r.round == round0._2.round)
  let sv1Weight = 100000.0
      sv1Balance0 = round.issuancePerSvRewardCoupon * sv1Weight

  checkMintReceiptAmount dso sv1Balance0

  [(rewardReceiptCid, _)] <- query @SvRewardMintReceipt dso
  [(rewardStateCid, _)] <- queryFilter @SvRewardState dso (\s -> s.svName == "sv1")

  (sv1Name, _) <- getSvInfoByParty app sv1
  (sv2Name, _) <- getSvInfoByParty app sv2
  -- Should fail when no receiptCids are supplied
  submitMustFail (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid DsoRules_MergeSvRewardMintReceipts with
    receiptCids = []
    svOperator = sv1
    svRewardStateCid = rewardStateCid
    svName = sv1Name

  -- Should fail when svName doesn't match the SvRewardState
  submitMustFail (actAs sv1 <> actAs sv2 <> readAs dso) $ exerciseCmd rulesCid DsoRules_MergeSvRewardMintReceipts with
    receiptCids = [rewardReceiptCid]
    svOperator = sv2
    svRewardStateCid = rewardStateCid
    svName = sv2Name

  submit (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid DsoRules_MergeSvRewardMintReceipts with
    receiptCids = [rewardReceiptCid]
    svOperator = sv1
    svRewardStateCid = rewardStateCid
    svName = sv1Name

  checkLifetimeRewardTotal dso sv1 sv1Balance0

  receiveSvRewardCoupon sv1 round2 rulesCid
  runNextIssuance app

  runAmuletDepositBots app

  [(_, round)] <- queryFilter @IssuingMiningRound app.dso (\r -> r.round == round2._2.round)
  let sv1Weight = 100000.0
      sv1Balance1 = round.issuancePerSvRewardCoupon * sv1Weight

  checkMintReceiptAmount dso sv1Balance1

  [(rewardReceiptCid, _)] <- query @SvRewardMintReceipt dso
  [(rewardStateCid, _)] <- queryFilter @SvRewardState dso (\s -> s.svName == "sv1")

  submit (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid DsoRules_MergeSvRewardMintReceipts with
    receiptCids = [rewardReceiptCid]
    svOperator = sv1
    svRewardStateCid = rewardStateCid
    svName = sv1Name

  -- Check aggregated balances
  checkLifetimeRewardTotal dso sv1 $ sv1Balance1 + sv1Balance0

  pure ()

-- | `DsoRules_MergeSvRewardMintReceipts`: any SV operator can merge any right owner's receipts, and only matching receipts are accepted.
testMergeSvRewardMintReceipts : Script ()
testMergeSvRewardMintReceipts = do
  (_, dso, (sv1, sv2, _, _)) <- initMainNetWithSvUnderlockEnforcement
  [(rulesCid, _)] <- query @DsoRules dso
  let receipt name amount = submit dso $
        createCmd SvRewardMintReceipt with
          dso
          amount
          svRightOwnerName = name
      stateOf name = do
        [state] <- queryFilter @SvRewardState dso (\s -> s.svName == name)
        pure state
      merge submitter svName receiptCids = do
        (svRewardStateCid, _) <- stateOf svName
        pure $ exerciseCmd rulesCid DsoRules_MergeSvRewardMintReceipts with
          receiptCids
          svOperator = submitter
          svRewardStateCid
          svName
      lifetimeTotalOf name = (fromOptional 0.0 . (.lifetimeRewardTotal) . snd) <$> stateOf name

  -- Another SV's operator can merge sv1's receipts
  r1 <- receipt "sv1" 10.0
  merge sv2 "sv1" [r1] >>= submit (actAs sv2 <> readAs dso)
  lifetimeTotalOf "sv1" >>= (=== 10.0)
  None <- queryContractId dso r1

  -- A receipt for another right owner is rejected
  r2 <- receipt "sv2" 5.0
  merge sv1 "sv1" [r2] >>= submitMustFail (actAs sv1 <> readAs dso)

  -- A party that isn't an SV operator can't merge
  alice <- allocateParty "alice"
  r3 <- receipt "sv1" 1.0
  merge alice "sv1" [r3] >>= submitMustFail (actAs alice <> readAs dso)

  -- A right owner whose name differs from its node operator's
  rightOwner <- allocateParty "rightOwnerOnSv1"
  instructionCid <- submit dso $ exerciseCmd rulesCid DsoRules_AddSvRightOwner with
    rightOwnerName = "rightOwnerOnSv1"
    info = SvRightOwnerInfo with
      rightOwnerParty = rightOwner
      voteWeight = 1
      rewardWeight = 1000
      rewardNodeOperatorName = "sv1"
      beneficiaries = []
      svLifetimeRewardsAdjustment = 0.0
      ultimateSvOwner = None
  (openMiningRoundCid, _) :: _ <- getActiveOpenRoundsSorted dso
  rulesCid <- submit (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid DsoRules_ExecuteAddSvRightOwnerInstruction with
    instructionCid
    openMiningRoundCid
    svOperator = sv1
  r4 <- receipt "rightOwnerOnSv1" 7.0
  (svRewardStateCid, _) <- stateOf "rightOwnerOnSv1"
  submit (actAs sv1 <> readAs dso) $ exerciseCmd rulesCid DsoRules_MergeSvRewardMintReceipts with
    receiptCids = [r4]
    svOperator = sv1
    svRewardStateCid
    svName = "rightOwnerOnSv1"
  lifetimeTotalOf "rightOwnerOnSv1" >>= (=== 7.0)
  -- sv1's own total is unaffected
  lifetimeTotalOf "sv1" >>= (=== 10.0)
