-- | Instruction contracts recording governance decisions to be applied by any SV against whichever
-- contract is current at execution time.
module Splice.DSO.Instruction where

import DA.Assert (assertDeadlineExceeded)

import Splice.Amulet (FeaturedAppRight_UpdateConfig)
import Splice.Types
import Splice.Util

data FeaturedAppConfigUpdateInstruction_ExpireResult = FeaturedAppConfigUpdateInstruction_ExpireResult
  deriving (Serializable)

-- | A governance-approved change to a FeaturedAppRight config.
template FeaturedAppConfigUpdateInstruction with
    dso : Party
    provider : Party -- ^ Provider whose featured app right should be updated.
    update : FeaturedAppRight_UpdateConfig
    expiresAt : Time
  where
    signatory dso

    choice FeaturedAppConfigUpdateInstruction_Expire : FeaturedAppConfigUpdateInstruction_ExpireResult
      controller dso
      do assertDeadlineExceeded "expiresAt" expiresAt
         return FeaturedAppConfigUpdateInstruction_ExpireResult

data FeaturedAppUnderlockInstruction_ExpireResult = FeaturedAppUnderlockInstruction_ExpireResult {}
  deriving (Serializable)

-- | A record of governance consensus that a FeaturedApp provider was underlocked.
template FeaturedAppUnderlockInstruction with
    dso : Party
    provider : Party
    underlocked : Bool
      -- ^ True indicates that governance parties observed the given provider to be underlocked.
      -- False indicates that they observed their recovery from underlock.
    expiresAt : Time
  where
    signatory dso

    choice FeaturedAppUnderlockInstruction_Expire : FeaturedAppUnderlockInstruction_ExpireResult
      controller dso
      do assertDeadlineExceeded "expiresAt" expiresAt
         pure FeaturedAppUnderlockInstruction_ExpireResult

data RevokeFeaturedAppRightInstruction_ExpireResult = RevokeFeaturedAppRightInstruction_ExpireResult {}
  deriving (Serializable)

template RevokeFeaturedAppRightInstruction with
    dso : Party
    provider : Party
    expiresAt : Time
  where
    signatory dso

    choice RevokeFeaturedAppRightInstruction_Expire : RevokeFeaturedAppRightInstruction_ExpireResult
      controller dso
      do assertDeadlineExceeded "expiresAt" expiresAt
         pure RevokeFeaturedAppRightInstruction_ExpireResult

instance HasCheckedFetch FeaturedAppConfigUpdateInstruction ForDso where
  contractGroupId FeaturedAppConfigUpdateInstruction {..} = ForDso with dso

instance HasCheckedFetch FeaturedAppUnderlockInstruction ForDso where
  contractGroupId FeaturedAppUnderlockInstruction {..} = ForDso with dso

instance HasCheckedFetch RevokeFeaturedAppRightInstruction ForDso where
  contractGroupId RevokeFeaturedAppRightInstruction {..} = ForDso with dso
