-- | Templates to track per-sv state.
module Splice.DSO.SvState where

import Splice.Types

import Splice.DSO.DecentralizedSynchronizer
import Splice.Util

import DA.List (last)
import DA.Optional
import DA.Time


-- Checked fetches for per-sv state
---------------------------------------

data ForSv = ForSv with
    dso : Party
    svName : Text
  deriving (Eq, Show, Serializable)

data ForSvNode = ForSvNode with
    dso : Party
    sv : Party
    svName : Text
  deriving (Eq, Show, Serializable)


-- Reward collection
--------------------

-- | Reward collection state of an SV.
--
-- Note that we keep some extra aggregates in this state to make it easier to interpret it.
-- In principle, these could be derived from the transaction history, but that
-- would be much more onerous to implement.
data RewardState = RewardState with
    numRoundsMissed : Int -- ^ Number of rounds for which they missed collecting coupons.
    numRoundsCollected : Int -- ^ Number of rounds for which they collected coupons.
    lastRoundCollected : Round -- ^ Last round for which they collected reward coupons.
    numCouponsIssued : Int -- ^ Number of SV reward coupons issued by them for their beneficiaries.
    rewardAdjustmentState : Optional RewardAdjustmentState -- ^ Adjustment factor and associated state for the reward weight
  deriving (Eq, Show, Serializable)


-- |
data RewardAdjustmentState = RewardAdjustmentState
  with
    permanentWeightFactor : Decimal -- TODO: move to SvRightOwner for voting.
      -- ^ the permanent maximum weight factor due to permanent underlocking
    recoverableUnderlocks : [ UnderlockEvent ]
      -- ^ Still-recoverable underlocks, sorted by the time they become permanent, latest first.
      -- Additional invariant: weight factors are strictly increasing (less-penalizing later in the list)
    lastAdjustedAt : Optional Time
  deriving (Eq, Show, Serializable)


data UnderlockEvent = UnderlockEvent
  with
    startTime : Time
      -- ^ Start time of the underlock event; becomes effective after 7 days, and permanent after 30.
    newFactor : Decimal
      -- ^ the new weight factor
  deriving (Eq, Show, Serializable)


-- | State of reward collection for a sv identified by their sv name.
template SvRewardState with
    dso : Party
    svName : Text -- ^ sv right owner name
    state : RewardState
    lifetimeRewardTotal : Optional Decimal
      -- ^ Total amount of SV rewards minted for this SV rights owner.
  where
    signatory dso


-- Node State Management
------------------------

data NodeState = NodeState with
    synchronizerNodes : SynchronizerNodeConfigMap
      -- ^ The config for a synchronizer's CometBFT, sequencer, mediator and scan nodes under control of an SV party.
  deriving (Eq, Show, Serializable)

-- | State of a node managed by an SV operator party.
--
-- There is exactly one such state per SV operator party.
-- Even though every SV can operate at most one node at any one time,
-- there can though be multiple SV node states per SV, as the state of offboarded
-- nodes is kept around for debugging purposes.
template SvNodeState with
    dso : Party
    sv : Party -- ^ The SV operator party identifying the node.
    svName : Text -- ^ The SV name in whose name the node is operated.
    state : NodeState
  where
    signatory dso


-- SV status reporting
----------------------

-- | The status of an SV as seen from their SV node's perspective.
-- We generally add values here that are expected to regularly increase, so that
-- SV node operators can run alerting off of them.
data SvStatus = SvStatus with
    createdAt : Time
      -- ^ The wall clock time of the SV node at the time when the SV node started to
      -- gather the data points in this report to submit them.
    cometBftHeight : Int
      -- ^ The height of the CometBFT chain at the time of submission
    mediatorSynchronizerTime : Time
      -- ^ The latest synchronizer time observed on the mediator at the time of submission
    participantSynchronizerTime : Time
      -- ^ The latest synchronizer time observed on the participant at the time of submission
    latestOpenRound : Round
      -- ^ The maximum round number of the OpenMiningRound contracts at the time of submission
  deriving (Eq, Show, Serializable)

-- | A singleton contract per SV party that is used to regularly submit status reports.
--
-- Individual status reports serve as a heartbeat for a specific SV party and its associoated SV node
-- ; and to distribute that SVs view on the network to all other SVs.
template SvStatusReport with
    dso : Party
    sv : Party
      -- ^ The SV party that submitted this report.
    svName : Text
      -- ^ The name of the SV operator whose operator party was used to submit this report.
    number : Int
      -- ^ The number of this report, starting from 0.
    status : Optional SvStatus
      -- ^ None is used when initially creating the contract upon sv addition.
  where
    signatory dso


getAdjustedRewardWeight : RelTime -> Optional RewardAdjustmentState -> Time -> Int -> Int
getAdjustedRewardWeight _ None _ weight = weight
getAdjustedRewardWeight temporaryGracePeriod (Some state) now weight
  = floor $ (effectiveWeightFactor temporaryGracePeriod now state) * intToDecimal weight

defaultRewardAdjustmentState = RewardAdjustmentState with
  permanentWeightFactor = 1.0
  recoverableUnderlocks = []
  lastAdjustedAt = None

updateTemporaryUnderlockState : (CanAssert m) => Decimal -> Time -> Optional RewardAdjustmentState -> m (Optional RewardAdjustmentState)
updateTemporaryUnderlockState newRewardWeightFactor effectiveTime adjustmentState
  | newAdjustmentState == adjustmentState = assertFail "Underlock state must change when calling updateTemporaryUnderlockState"
  | otherwise = do
      require "newRewardWeightFactor must be nonnegative" $ newRewardWeightFactor >= 0.0
      require "newRewardWeightFactor must be no greater than permanentWeightFactor" $
        currentAdjustmentState.permanentWeightFactor <= newRewardWeightFactor
      pure newAdjustmentState
  where
    currentAdjustmentState = fromOptional defaultRewardAdjustmentState adjustmentState
    stillApplicableUnderlocks = currentAdjustmentState.recoverableUnderlocks
    newUnderlock = UnderlockEvent with
      newFactor = newRewardWeightFactor
      startTime = effectiveTime
    newRecoverableUnderlocks
      | newRewardWeightFactor == 1.0 = []
      | firstUnderlock::_ <- stillApplicableUnderlocks,
        firstUnderlock.newFactor == newRewardWeightFactor = stillApplicableUnderlocks
      | otherwise = newUnderlock::stillApplicableUnderlocks
    newFullAdjustmentState = currentAdjustmentState with
      recoverableUnderlocks = newRecoverableUnderlocks
    newAdjustmentState
      | newFullAdjustmentState == defaultRewardAdjustmentState = None
      | otherwise = Some newFullAdjustmentState

updatePermanentUnderlockState : (CanAssert m) => Time -> Optional RewardAdjustmentState -> m (Optional RewardAdjustmentState)
updatePermanentUnderlockState permanentBefore adjustmentState
  | Some state <- adjustmentState, (recoverableUnderlocks, permanent :: _) <- span isStillTemporary state.recoverableUnderlocks
    = pure $ Some RewardAdjustmentState with
          permanentWeightFactor = permanent.newFactor
          recoverableUnderlocks
          lastAdjustedAt = state.lastAdjustedAt
  | otherwise = assertFail "Must make an underlock permanent"
  where isStillTemporary = (< permanentBefore). startTime

promotePermanent : Time -> RewardAdjustmentState -> RewardAdjustmentState
promotePermanent permanentCutoff s =
  case span (\underlockEvent -> underlockEvent.startTime > permanentCutoff) s.recoverableUnderlocks of
    (_, []) -> s
    (temporary, p :: _) -> RewardAdjustmentState with
      permanentWeightFactor = min s.permanentWeightFactor p.newFactor
      recoverableUnderlocks = temporary
      lastAdjustedAt = s.lastAdjustedAt

applyWarrantedFactor : Time -> Decimal -> RewardAdjustmentState -> RewardAdjustmentState
applyWarrantedFactor now warranted s
  | warranted >= s.permanentWeightFactor = s with recoverableUnderlocks = []
  | otherwise = s with
    recoverableUnderlocks =
      let (recoveredUnderlocks, rest) = span (\underlockEvent -> underlockEvent.newFactor < warranted) s.recoverableUnderlocks
          start = if null recoveredUnderlocks then now else (last recoveredUnderlocks).startTime
      in case rest of
        underlockEvent :: _ | underlockEvent.newFactor == warranted -> rest
        _ -> (UnderlockEvent with startTime = start; newFactor = warranted) :: rest

effectiveWeightFactor : RelTime -> Time -> RewardAdjustmentState -> Decimal
effectiveWeightFactor temporaryGracePeriod now s =
  case dropWhile (\underlockEvent -> underlockEvent.startTime > now `addRelTime` negate temporaryGracePeriod) s.recoverableUnderlocks of
    underlockEvent :: _ -> underlockEvent.newFactor
    [] -> s.permanentWeightFactor

-- instances
------------

instance HasCheckedFetch SvRewardState ForSv where
  contractGroupId SvRewardState {..} = ForSv with dso; svName

instance HasCheckedFetch SvNodeState ForSvNode where
  contractGroupId SvNodeState {..} = ForSvNode with dso; sv; svName

instance HasCheckedFetch SvStatusReport ForSvNode where
  contractGroupId SvStatusReport {..} = ForSvNode with dso; sv; svName
