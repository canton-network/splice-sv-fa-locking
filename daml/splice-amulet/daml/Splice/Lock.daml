-- | Lock mechanics on `LockedAmulet`s, and the parts of lock transfers,
-- substitutions and TSv1 support that governance and vesting locks share.
module Splice.Lock where

import Prelude hiding (forA)
import DA.Assert
import DA.List.Total (head)
import DA.Map qualified as Map
import DA.Optional
import DA.Text qualified as Text
import DA.TextMap qualified as TextMap
import DA.Time
import DA.Traversable (forA)

import Splice.Amulet
import Splice.Amulet.TokenApiUtils
import Splice.Amulet.TwoStepTransfer (holdingToTransferInputs)
import Splice.AmuletConfig (getTokenStandardMaxTTL, governanceLockMinimumLockAmount)
import Splice.AmuletRules
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Expiry hiding (maxTime)
