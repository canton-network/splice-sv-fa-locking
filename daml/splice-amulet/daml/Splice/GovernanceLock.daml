module Splice.GovernanceLock where

import DA.Assert
import DA.Functor
import DA.Numeric
import DA.Optional
import DA.Time

import Splice.Amulet
import Splice.Amulet.TwoStepTransfer (holdingToTransferInputs)
import Splice.AmuletConfig (getGovernanceLockConfig)
import Splice.AmuletRules
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1
import Splice.Expiry
import Splice.ExternalPartyConfigState
import Splice.TokenStandard.Utils hiding (require)
import Splice.Types
import Splice.Util


data GovernanceLockType
  = GLS_FeaturedApp with
      provider : Party -- ^ Featured app provider party.
  | GLS_SuperValidatorRightsOwner with
      svName : Text  -- ^ Name of the SV rights owner for whom the funds are locked.
  deriving (Eq, Show, Serializable)

-- FIXME: add controllers specifications
data GovernanceLockSpecification
  = GovernanceLockSpecification with
      subject : GovernanceLockType
  deriving (Eq, Show, Serializable)

data VestingLockSpecification
  = VestingLockSpecification with
      subject : GovernanceLockType
  deriving (Eq, Show, Serializable)


template GovernanceLock
  with
    dso : Party
    owner : Party  -- ^ Lock owner
    amount : Decimal  -- ^ Locked amount
    lockedAmulet : ContractId LockedAmulet
    specification : GovernanceLockSpecification
  where
    signatory dso, owner
    ensure amount > 0.0

    choice GovernanceLock_Unlock : GovernanceLock_UnlockResult
      with
        unlockAmount : Optional Decimal -- ^ Amount to unlock. Defaults to the full amount if not set.
        unlockAt : Time  -- ^ Time as of which the unlock is to be registered and vesting starts. Must be in the future.
        extraArgs : ExtraArgs
        actors : [Party]
      controller actors
      do
        checkActors actors [[owner]] -- ^ TODO: custom controllers
        assertWithinDeadline "unlockAt" unlockAt

        (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context

        let vestingPeriod = vestingDurationFor specification.subject context
        let endTime = unlockAt `addRelTime` vestingPeriod
        let specification = governanceToVestingSpecification this.specification
        let vestingLockProperties = LockProperties with
              context = describeVestingSpecification specification
              expiresAt = endTime

        (vestingLockedHolding, governanceLock, vestingAmount) <- case guard (unlockAmount /= Some amount) >> unlockAmount of
          None -> do -- No split required, relock to change the expireAt and description.
            newLockedAmulet <- relockAmulet (ForOwner with dso; owner) lockedAmulet vestingLockProperties context
            pure (newLockedAmulet, None, amount)
          Some unlockAmount -> do -- Splitting.
            require' ("unlockAmount", unlockAmount) isGreaterR ("zero", 0.0)
            (vesting, stillLockedHolding, stillLockedAmount) <- splitLockedAmulet (ForOwner with dso; owner) lockedAmulet (unlockAmount, vestingLockProperties) context
            requireMinimumLock state stillLockedAmount
            requireMinimumLock state unlockAmount
            governanceLock <- create
              this with
                lockedAmulet = stillLockedHolding
                amount = amount - unlockAmount
            pure (vesting, Some governanceLock, unlockAmount)

        vestingLock <- create VestingLock with
          dso
          owner
          lockedAmulet = vestingLockedHolding
          vestingPeriod
          endTime
          vestingAmount
          specification

        pure $ GovernanceLock_UnlockResult with
          vestingLock
          governanceLock

  -- TODO: implement V2 Allocation interface on above. Most fields of the view are generated, as they are constants or specific presentations of the above.
  -- TODO: implement pending V1 transfer for the above, for backwards compatibility.
  -- TODO: substitution, probably with a loose function for implementation sharing.

data GovernanceLock_UnlockResult
  = GovernanceLock_UnlockResult with
      vestingLock : ContractId VestingLock
      governanceLock : Optional (ContractId GovernanceLock)
  deriving (Eq, Show, Serializable)

template VestingLock
  with
    dso : Party
    owner : Party
    lockedAmulet : ContractId LockedAmulet
    vestingPeriod : RelTime  -- ^ Duration over which the amount vests in a linear fashion.
    endTime : Time  -- ^ Time at which vesting completes.
    vestingAmount : Decimal  -- ^ The amount that is vesting.
    specification : VestingLockSpecification
  where
    signatory dso, owner
    ensure vestingAmount > 0.0 && vestingPeriod >= aunit

    -- | Withdraw all funds that have vested since the last withdrawal
    -- and the time of this request.
    choice VestingLock_Withdraw : VestingLock_WithdrawResult
      with
        requestedAt : Time -- ^ Time to use for determining the funds that have vested. Must be in the past.
        extraArgs : ExtraArgs
        actors : [Party]
      controller actors
      do
        checkActors actors [[owner]] -- ^ TODO: custom controllers
        assertDeadlineExceeded "requestedAt" requestedAt
        context <- externalPartyTransferFromChoiceContext dso extraArgs.context

        let retainedAmount = calculateUnvestedAmount requestedAt this

        case retainedAmount of
          None -> do -- No split or partial availability, and the holding is already available, so just make a final report and archive.
            pure VestingLock_WithdrawResult with
              vestingLock = None
              unlocked = toInterfaceContractId lockedAmulet
          Some stillLockedAmount -> do -- We have a fraction that is not the whole being withdrawn, do a partial unlock.
            require' ("withdraw amount", vestingAmount - stillLockedAmount) isGreaterR ("zero", 0.0)
            (locked, unlocked) <- partialUnlock (ForOwner with dso; owner) lockedAmulet stillLockedAmount context
            vestingLock <- Some <$> create this with
              lockedAmulet = locked
              vestingPeriod = endTime `subTime` requestedAt
              vestingAmount = stillLockedAmount
            pure VestingLock_WithdrawResult with
              vestingLock
              unlocked = toInterfaceContractId unlocked

  -- TODO: implement V2 Allocation interface on above. Most fields of the view are generated, as they are constants or specific presentations of the above.
  -- TODO: implement pending V1 transaction for the above, for backwards compatibility.
  -- TODO: substitution, probably with a loose function for implementation sharing.

data VestingLock_WithdrawResult
  = VestingLock_WithdrawResult with
      vestingLock : Optional (ContractId VestingLock)
      -- ^ Contract ID of the continuing vesting lock with remaining funds.
      unlocked : ContractId Holding
      -- ^ Holding of withdrawn available funds. May be either an Amulet or an expired LockedAmulet if the vesting period has passed. May be already spent in the latter case.
  deriving (Eq, Show, Serializable)

-- | Uses `None` to represent that no amount remains.
calculateUnvestedAmount : Time -> VestingLock -> Optional Decimal
calculateUnvestedAmount currentTime VestingLock{ .. }
    | currentTime <= (endTime `addRelTime` (- vestingPeriod)) = Some vestingAmount
    | currentTime >= endTime = None
    | otherwise = Some $ vestingAmount `mul` fractionRemaining
  where
    fractionRemaining = (endTime `subTime` currentTime) `divRelTime` vestingPeriod
    divRelTime : RelTime -> RelTime -> Numeric 37 -- Specifically valid and maximum cleanly represented range for 0 < a < b
    divRelTime = \a b -> (intToDecimal $ convertRelTimeToMicroseconds a) `div` (intToDecimal $ convertRelTimeToMicroseconds b)

-- Implementation for the LockForGovernance choice on ExternalPartyAmuletRules and core implementation of token standard v1 and v2 interfaces.

governanceLock_lockForGovernance_impl
  : Party
 -> Decimal
 -> [ContractId Holding]
 -> GovernanceLockSpecification
 -> ExtraArgs
 -> Party
 -> Update (ContractId GovernanceLock, Optional (ContractId Amulet))
governanceLock_lockForGovernance_impl dso amount inputs specification extraArgs owner = do
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  requireMinimumLock state amount
  let lockProperties = LockProperties with
        context = describeGovernanceSpecification specification
        expiresAt = maxBound
  ([lockedAmulet], changeHolding) <- lockAmulet (ForOwner with dso; owner) [(amount, lockProperties)] inputs context
  governanceLock <- create GovernanceLock with
    dso
    owner
    amount
    lockedAmulet
    specification
  pure $ (governanceLock, changeHolding)

  -- TODO: implement V2 AllocationFactory in terms of above.
  -- TODO: find and use binding point for "magic address" V1 token standard to above.

-- Helpers for

governanceToVestingSpecification : GovernanceLockSpecification -> VestingLockSpecification
governanceToVestingSpecification GovernanceLockSpecification {..} = VestingLockSpecification {..}

vestingToGovernanceSpecification : VestingLockSpecification -> GovernanceLockSpecification
vestingToGovernanceSpecification VestingLockSpecification {..} = GovernanceLockSpecification {..}

describeGovernanceLockType : GovernanceLockType -> Text
describeGovernanceLockType (GLS_FeaturedApp with provider) = "Featured App party " <> partyToText provider
describeGovernanceLockType (GLS_SuperValidatorRightsOwner with svName) = "Super Validator rights for " <> svName

describeGovernanceSpecification : GovernanceLockSpecification -> Text
describeGovernanceSpecification lock = "Locked to support " <> describeGovernanceLockType lock.subject

describeVestingSpecification : VestingLockSpecification -> Text
describeVestingSpecification lock = "Unlocking from supporting " <> describeGovernanceLockType lock.subject

-- Lock properties for LockSubject types

-- TODO: make configurable
vestingDurationFor : GovernanceLockType -> ExternalPartyTransferContext -> RelTime
vestingDurationFor (GLS_FeaturedApp _) _ = days 60
vestingDurationFor (GLS_SuperValidatorRightsOwner _) _ = days 365 + hours 6

requireMinimumLock : ExternalPartyConfigState -> Decimal -> Update ()
requireMinimumLock context amount = do
  require' ("locked amount", amount) isGreaterOrEqualR ("minimum governance lock amount", (getGovernanceLockConfig context.governanceLockConfig).minimumGovernanceLock)

unfeaturedPaymentContextAndConfigFromChoiceContext : Party -> ChoiceContext -> Update (ExternalPartyTransferContext, ExternalPartyConfigState)
unfeaturedPaymentContextAndConfigFromChoiceContext dso choiceContext = do
  (configStateCid, configState) <- getExternalPartyConfigStateFromChoiceContext dso choiceContext
  pure (ExternalPartyTransferContext with
          externalPartyConfigState = configStateCid
          featuredAppRight = None
       , configState )


-- Substitution
-- ============

-- DESIGN DECISION: should we use this type as the key instead of the stable identifiers?
-- ==> go for contract keys, as that is compatible with the long-term goal of fetching reference data via remote contract key lookups
-- FIXME: actually switch to keys
data SubstitutedLock = SubstitutedLock with
    owner : Party
    amount : Decimal
    specification : GovernanceLockSpecification
  deriving (Eq, Show, Serializable)

data SubstitutionTarget
  = ST_GovernanceLock with
      governanceLockCid : ContractId GovernanceLock
  | ST_VestingLock with
      vestingLockCid : ContractId VestingLock
  deriving (Eq, Show, Serializable)

template SubstitutionProposal with
    dso : Party
    substitutedLock : SubstitutedLock
    proposer : Party -- ^ Party that proposed the substitution
    amount : Decimal -- ^ Amount being substituted
    lockedAmulet : ContractId LockedAmulet -- ^ Amulet providing the funds
  where
    signatory dso, proposer
    observer substitutedLock.owner

    choice SubstitutionProposal_Accept : ()
      with
        target : SubstitutionTarget
        extraArgs : ExtraArgs
        -- TODO: add actors as part of adding support for custom substitution controllers
      controller substitutedLock.owner
      do
        -- fetch and archive the referenced lock
        let substitutedLockOwner = ForOwner with dso; owner = substitutedLock.owner
        (substitutedLockedAmulet, mkLock) <- case target of
          ST_GovernanceLock lockCid -> do
            lock <- fetchAndArchive substitutedLockOwner lockCid
            -- check that it matches the lock that we expect to substitute
            let actualLock = SubstitutedLock with
                  owner = lock.owner
                  amount = lock.amount
                  specification = lock.specification
            requireMatchExpected ("substituted lock", actualLock) substitutedLock
            let mkLock lockOwner lockAmount lockedAmulet = do
                  create GovernanceLock with
                    dso
                    owner = lockOwner
                    amount = lockAmount
                    lockedAmulet
                    specification = substitutedLock.specification
                  pure ()
            pure (lock.lockedAmulet, mkLock)
          ST_VestingLock lockCid -> do
            lock <- fetchAndArchive substitutedLockOwner lockCid
            -- check that it matches the lock that we expect to substitute
            let actualLock = SubstitutedLock with
                  owner = lock.owner
                  amount = lock.vestingAmount
                  specification = vestingToGovernanceSpecification lock.specification
            requireMatchExpected ("substituted lock", actualLock) substitutedLock
            let mkLock lockOwner lockAmount lockedAmulet = do
                  create VestingLock with
                    dso
                    owner = lockOwner
                    lockedAmulet
                    vestingPeriod = lock.vestingPeriod
                    endTime = lock.endTime
                    vestingAmount = lockAmount
                    specification = governanceToVestingSpecification substitutedLock.specification
                  pure () -- FIXME: decide whether we want an interface for locks, or use AnyContractId
            pure (lock.lockedAmulet, mkLock)

        if amount == substitutedLock.amount
          then do
            -- liquidate the whole amount
            -- FIXME: prudent engineering: check amount to be on the safe side
            unlockAmulet substitutedLockOwner substitutedLockedAmulet
            -- create new lock
            mkLock proposer amount lockedAmulet
          else do
            -- liquidate part of the amount
            context <- externalPartyTransferFromChoiceContext dso extraArgs.context
            let remainingAmount = substitutedLock.amount - amount
            (newLockedAmulet, _unlockedAmulet) <-
              partialUnlock substitutedLockOwner substitutedLockedAmulet remainingAmount context
            mkLock substitutedLock.owner remainingAmount newLockedAmulet
            mkLock proposer amount lockedAmulet

        pure ()

    choice SubstitutionProposal_Withdraw : () -- FIXME: proper type, above as well
      controller proposer
      do
        unlockAmulet (ForOwner with dso; owner = proposer) lockedAmulet
        pure ()

-- | Type to simplify passing in all the arguments required to create a substitution proposal.
--
-- TODO: move this to a separate utlity pacakge `splice-governance-lock-utils`, which then also contains the codecs to and from TSv2 choices
data CreateSubstitutionProposalArgs = CreateSubstitutionProposalArgs with
    dso : Party
    substitutedLock : SubstitutedLock
    proposer : Party -- ^ Party that proposed the substitution
    amount : Decimal -- ^ Amount being substituted
    inputHoldingCids : [ContractId Holding] -- ^ Holdings providing the funds
    extraArgs : ExtraArgs
  deriving (Eq, Show)


createSubstitutionProposal : CreateSubstitutionProposalArgs -> Update (ContractId SubstitutionProposal, Optional (ContractId Amulet))
createSubstitutionProposal CreateSubstitutionProposalArgs {..} = do
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  requireMinimumLock state amount
  let lockProperties = LockProperties with
        -- FIXME: context decscription reads a bit strangely
        context = "Substitution proposal for " <> describeGovernanceSpecification substitutedLock.specification
        expiresAt = maxBound
  ([lockedAmulet], changeHolding) <- lockAmulet (ForOwner with dso; owner = proposer) [(amount, lockProperties)] inputHoldingCids context
  proposal <- create SubstitutionProposal with
    dso
    substitutedLock
    proposer
    amount
    lockedAmulet
  pure $ (proposal, changeHolding)


-- Helpers for handling LockedAmulet
-- =================================

-- Invariant: _none_ of these functions move amounts to new parties or modify total amounts of amulet (except when minting from reward coupons).

type LockSpecification = (Decimal, LockProperties)
data LockProperties = LockProperties with
  context : Text
  expiresAt : Time

splitLockedAmulet : ForOwner -> ContractId LockedAmulet -> LockSpecification -> ExternalPartyTransferContext -> Update (ContractId LockedAmulet, ContractId LockedAmulet, Decimal)
splitLockedAmulet forOwner lockedAmuletCid amount context = do
  ([splitLock], remainder, remainderAmount) <- multiSplitLockedAmulet forOwner lockedAmuletCid [amount] context
  pure (splitLock, remainder, remainderAmount)

multiSplitLockedAmulet : ForOwner -> ContractId LockedAmulet -> [LockSpecification] -> ExternalPartyTransferContext -> Update ([ContractId LockedAmulet], ContractId LockedAmulet, Decimal)
multiSplitLockedAmulet forOwner lockedAmuletCid specs context = do
  (unlockedCid, (currentAmount, currentLockProps)) <- unlockAmulet forOwner lockedAmuletCid
  let remainderAmount = currentAmount - sum (fst <$> specs)
  (remainderLock::specifiedLocks, None) <- lockAmulet forOwner ((remainderAmount, currentLockProps) :: specs) [toInterfaceContractId unlockedCid] context
  pure (specifiedLocks, remainderLock, remainderAmount)

partialUnlock : ForOwner -> ContractId LockedAmulet -> Decimal -> ExternalPartyTransferContext -> Update (ContractId LockedAmulet, ContractId Amulet)
partialUnlock forOwner lockedAmuletCid stillLockedAmount context = do
  (unlockedAmuletCid, (_, lockProps)) <- unlockAmulet forOwner lockedAmuletCid
  ([newLockedCid], Some unlockedAmulet) <- lockAmulet forOwner [(stillLockedAmount, lockProps)] [toInterfaceContractId $ unlockedAmuletCid] context
  pure (newLockedCid, unlockedAmulet)

relockAmulet : ForOwner -> ContractId LockedAmulet -> LockProperties -> ExternalPartyTransferContext -> Update (ContractId LockedAmulet)
relockAmulet forOwner lockedAmuletCid newLockProperties context = do
  (amuletCid, (currentAmount, _)) <- unlockAmulet forOwner lockedAmuletCid
  ([newLockedCid], None) <- lockAmulet forOwner [(currentAmount, newLockProperties)] [toInterfaceContractId $ amuletCid] context
  pure newLockedCid

unlockAmulet : ForOwner -> ContractId LockedAmulet -> Update (ContractId Amulet, LockSpecification)
unlockAmulet forOwner lockedAmuletCid = do
  lock <- fetchChecked forOwner lockedAmuletCid
  unlockResult <- exercise lockedAmuletCid LockedAmulet_UnlockV2
  return (unlockResult.amuletCid, (lock.amulet.amount.initialAmount, LockProperties with context = fromOptional "governance" lock.lock.optContext; expiresAt = lock.lock.expiresAt))

lockAmulet : ForOwner -> [LockSpecification] -> [ContractId Holding] -> ExternalPartyTransferContext -> Update ([ContractId LockedAmulet], Optional (ContractId Amulet))
lockAmulet forOwner@ForOwner {..} amounts inputHoldingCids context = do
  -- lock the amulet
  transferInputs <- holdingToTransferInputs forOwner inputHoldingCids
  let transfer = Splice.AmuletRules.Transfer with
        sender = owner
        provider = owner -- the sender is serving as its own "app provider"
        outputs = amounts <&> \(amount, spec) ->
            TransferOutput with
              receiver = owner
              amount = amount
              receiverFeeRatio = 0.0 -- irrelevant as fees are always zero
              lock = Some TimeLock with
                expiresAt = spec.expiresAt -- We don't have any call to isLedgerTimeLE, so we can use the true maxBound here for arbitrary duration.
                holders = [dso]
                optContext = Some spec.context
              meta = Some (reasonToMeta ("lock for " <> spec.context) emptyMetadata)
        inputs = transferInputs
        beneficiaries = None

  result <- executeExternalPartyTransfer forOwner.dso context transfer
  let lockedAmulets = (\(TransferResultLockedAmulet lockedAmulet) -> lockedAmulet) <$> result.createdAmulets
  pure
    ( lockedAmulets
    , result.senderChangeAmulet
    )

fetchAmount : ForOwner -> ContractId LockedAmulet -> Update Decimal
fetchAmount forOwner holding = do
  holdingView <- view . toInterface @Holding <$> fetchChecked forOwner holding
  pure holdingView.amount


-- Instances
------------

instance HasCheckedFetch GovernanceLock ForOwner where
  contractGroupId GovernanceLock{..} = ForOwner with dso; owner = owner

instance HasCheckedFetch VestingLock ForOwner where
  contractGroupId VestingLock{..} = ForOwner with dso; owner = owner
