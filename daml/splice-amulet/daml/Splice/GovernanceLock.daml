module Splice.GovernanceLock where

import DA.Assert
import DA.Foldable (toList)
import DA.Map qualified as Map
import DA.Optional
import DA.Text qualified as Text
import DA.TextMap qualified as TextMap
import DA.Time

import Splice.Amulet
import Splice.Amulet.TwoStepTransfer (holdingToTransferInputs)
import Splice.AmuletConfig (getGovernanceLockConfig)
import Splice.AmuletRules
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as TransferInstructionV1
import Splice.Expiry
import Splice.Fees (relTimeToSeconds)
