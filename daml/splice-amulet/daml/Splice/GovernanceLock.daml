{-# LANGUAGE ApplicativeDo #-}

-- | Governance locks: `GovernanceLock` with its kind, substitution, transfer
-- and TSv1 support, and the TSv1 transfer factory for both lock types.
module Splice.GovernanceLock where

import Prelude hiding (forA)
import DA.Action (unless)
import DA.Assert
import DA.Foldable (forA_, toList)
import DA.Functor (($>))
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Optional
import DA.Text qualified as Text
import DA.Time
import DA.Traversable (forA)

import Splice.Amulet
import Splice.Amulet.TokenApiUtils
import Splice.AmuletConfig
  ( getTokenStandardMaxTTL
  , governanceLockFeaturedAppLockVestingDuration
  , governanceLockSuperValidatorLockVestingDuration
  )
import Splice.AmuletRules
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Api.Token.TransferEventsV2 as TransferEventsV2
import Splice.ExternalPartyConfigState
import Splice.Lock
import Splice.Lock.TSv1MemoParser
import Splice.Round
import Splice.TokenStandard.Utils hiding (require, reasonMetaKey)
import Splice.Types
import Splice.Util
import Splice.VestingLock

data GovernanceLockKind
  = GLK_FeaturedApp with
      provider : Party -- ^ Featured app provider party.
  | GLK_ProvisionalFeaturedApp with
      provider : Party -- ^ Provisional featured app provider party.
  | GLK_SuperValidatorRightsOwner with
      svName : Text  -- ^ Name of the SV rights owner for whom the funds are locked.
  deriving (Eq, Show, Serializable)

data GovernanceLockSpecification
  = GovernanceLockSpecification with
      kind : GovernanceLockKind
  deriving (Eq, Show, Serializable)

template GovernanceLock
  with
    dso : Party
    owner : Party  -- ^ Lock owner
    amount : Decimal  -- ^ Locked amount
    lockedAmulet : ContractId LockedAmulet
    specification : GovernanceLockSpecification
    originalLockCid : Optional AnyContractId
    requestedAt : Time  -- ^ Time of the request to create this lock.
  where
    signatory dso, owner
    observer governanceLockKindObservers specification.kind
    ensure amount > 0.0
    key ( GovernanceLockKey with dso; owner; specification ) : GovernanceLockKey
    maintainer key.dso

    choice GovernanceLock_Unlock : GovernanceLock_UnlockResult
      with
        unlockAmount : Decimal -- ^ Amount to unlock.
        unlockAt : Time  -- ^ Time as of which the unlock is to be registered and vesting starts. Must be in the future.
        extraArgs : ExtraArgs
        actors : [Party]
      controller actors
      do
        (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
        governanceLock_unlockImpl self this unlockAmount unlockAt actors context state

    choice GovernanceLock_MergeAndTopUp : GovernanceLock_MergeAndTopUpResult
      with
        topUpAmount : Decimal
          -- ^ Amount that should be deposited extra from liquid funds.
        lockInputs : [ContractId GovernanceLock]
          -- ^ Locks with the same owner and specification to merge into this lock
        holdingInputs : [ContractId Holding]
          -- ^ Holding inputs used to fund the top-up.
        svRewardCouponInputs : [ContractId SvRewardCoupon]
          -- ^ Sv Reward Coupon inputs used to fund the top-up.
        svRewardCouponPercentage : Decimal
          -- ^ Percentage (specified as a number between 0.0 and 1.0) of the sv reward coupons
          -- minting allowance to top-up a governance lock with. The remainder is returned as change.
        extraArgs : ExtraArgs
      controller owner
      do
        require' ("topUpAmount", topUpAmount) isGreaterOrEqualR ("zero", 0.0)
        require' ("svRewardCouponPercentage", svRewardCouponPercentage) isGreaterOrEqualR ("zero", 0.0)
        require' ("svRewardCouponPercentage", svRewardCouponPercentage) isLessOrEqualR ("one", 1.0)
        let forOwner = ForOwner with dso; owner

        (context, _) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context

        (holdingsFromSvRewardCoupons, svRewardMintAllowance) <- getSvRewardInputAmuletAndChange
          svRewardCouponInputs
          svRewardCouponPercentage
          extraArgs
          forOwner
          (toInterfaceContractId context.externalPartyConfigState)

        (unlockedAmuletCid, (_, lockProps)) <- unlockAmulet forOwner lockedAmulet

        -- Check if we have any locks to merge and extract required info
        unlockedAmountsAndHoldings : [(Decimal, ContractId Holding)] <- forA lockInputs $ \governanceLockCid -> do
          governanceLock <- fetchChecked @GovernanceLock forOwner governanceLockCid
          requireMatchExpected ("governanceLock.dso", governanceLock.dso) dso
          requireMatchExpected ("governanceLock.owner", governanceLock.owner) owner
          requireMatchExpected ("governanceLock.specification", governanceLock.specification) specification

          (amuletCid, (totalUnlockedLockAmount, _)) <- unlockAmulet forOwner governanceLock.lockedAmulet
          pure (totalUnlockedLockAmount, toInterfaceContractId amuletCid)

        let unlockedAmountFromMergeLocks : Decimal = sum [amt | (amt, _) <- unlockedAmountsAndHoldings]
            unlockedHoldingsFromMergeLocks : [ContractId Holding] = [holding | (_, holding) <- unlockedAmountsAndHoldings]
            newLockAmount = amount + topUpAmount + unlockedAmountFromMergeLocks + svRewardMintAllowance
            allInputHoldings = toInterfaceContractId unlockedAmuletCid
              :: holdingInputs
              <> unlockedHoldingsFromMergeLocks
              <> holdingsFromSvRewardCoupons

        ([newLockedAmulet], newChangeHolding) <- lockAmulet
          forOwner
          [(newLockAmount, lockProps)]
          allInputHoldings
          context
          $ if svRewardMintAllowance > 0.0
              then "(includes minting and locking " <> show svRewardMintAllowance <> " SV rewards)"
              else ""

        newGovernanceLock <- create this with
          amount = newLockAmount
          lockedAmulet = newLockedAmulet
          originalLockCid = Some $ fromOptional (toAnyContractId self) originalLockCid

        pure $ GovernanceLock_MergeAndTopUpResult with
          governanceLock = newGovernanceLock
          changeHolding = newChangeHolding

    choice GovernanceLock_DsoConvertProvisionalFeaturedAppLock : GovernanceLock_DsoConvertProvisionalFeaturedAppLockResult
      with
        featuredAppRightCid : ContractId FeaturedAppRight
      controller dso
      do
        case specification.kind of
          GLK_ProvisionalFeaturedApp provider -> do
            fetchChecked (ForOwner with dso; owner = provider) featuredAppRightCid
            create this with
              specification = specification with
                kind = GLK_FeaturedApp with provider
            pure GovernanceLock_DsoConvertProvisionalFeaturedAppLockResult
          kind -> error $ "GovernanceLock_DsoConvertProvisionalFeaturedAppLock: cannot convert lock of kind " <> show kind

    choice GovernanceLock_DsoSubstitute : GovernanceLock_DsoSubstituteResult
      -- ^ Release `substitutedAmount` of the locked funds to the owner as part of an approved
      -- substitution. Only the accept step of a `GovernanceLockSubstitution` calls this choice.
      with
        substitutedAmount : Decimal
        extraArgs : ExtraArgs
      controller dso
      do
        governanceLock_substituteImpl self this substitutedAmount extraArgs

    choice GovernanceLock_DsoSplitForSubstitution : GovernanceLock_DsoSplitForSubstitutionResult
      -- ^ Split `splitAmount` of the locked funds off into a `LockedAmulet` for a new lock with
      -- `newSpecification`, as part of an approved substitution proposed by the owner of this lock.
      -- Only the accept step of a `GovernanceLockSubstitution` calls this choice.
      with
        splitAmount : Decimal
        newSpecification : GovernanceLockSpecification
        extraArgs : ExtraArgs
      controller dso
      do
        governanceLock_splitForSubstitutionImpl self this splitAmount newSpecification extraArgs

    choice GovernanceLock_DsoTransfer : GovernanceLock_DsoTransferResult
      -- ^ Release `transferredAmount` of the locked funds as part of an approved transfer.
      -- The accept step of a `GovernanceLockTransfer` calls this choice, and locks the unlocked
      -- funds again for the receiver, as only that step has the receiver's authority.
      with
        transferredAmount : Decimal
        extraArgs : ExtraArgs
      controller dso
      do
        governanceLock_dsoTransferImpl self this transferredAmount extraArgs

    interface instance V1.TransferInstruction for GovernanceLock where
      view = V1.TransferInstructionView with
          originalInstructionCid = toInterfaceContractId . (fromAnyContractId @GovernanceLock) <$> originalLockCid
          transfer = V1.Transfer with
            sender = owner
            receiver = lockManagerParty
            amount
            instrumentId = amuletInstrumentId dso
            requestedAt
            executeBefore = maxBound
            inputHoldingCids = []
            meta = encodeGovernanceLockMetadata this
          status = V1.TransferPendingInternalWorkflow with pendingActions = Map.empty
          meta = emptyMetadata
      transferInstruction_acceptImpl _ _ = assertFail "Transfers representing governance locks cannot be accepted"
      transferInstruction_rejectImpl _ _ = assertFail "Transfers representing governance locks cannot be rejected"
      transferInstruction_withdrawImpl _ _ = assertFail "Transfers representing governance locks cannot be withdrawn"
      transferInstruction_updateImpl _ _ = assertFail "Transfers representing governance locks cannot be updated"

governanceLock_unlockImpl : ContractId GovernanceLock -> GovernanceLock -> Decimal -> Time -> [Party] -> ExternalPartyTransferContext -> ExternalPartyConfigState -> Update GovernanceLock_UnlockResult
governanceLock_unlockImpl self this@(GovernanceLock {..}) unlockAmount vestingStartTime actors context state
    = do
        checkActors actors [[owner]]
        assertWithinDeadline "vestingStartTime" vestingStartTime
        assertDeadlineExceeded "vestingStartTime - 1 day" (vestingStartTime `addRelTime` days (-1))
        require' ("unlockAmount", unlockAmount) isLessOrEqualR ("amount", amount)
        let isFullUnlock = unlockAmount == amount
        require' ("unlockAmount", unlockAmount) isGreaterR ("zero", 0.0)
        unless isFullUnlock $ do
          requireMinimumLock state unlockAmount
          requireMinimumLock state (amount - unlockAmount)

        let vestingPeriod = vestingDurationFor specification.kind state
        let endTime = vestingStartTime `addRelTime` vestingPeriod
        let optSpecification = if vestingPeriod == days 0 then None else governanceToVestingSpecification this.specification
        let forOwner = ForOwner with dso; owner
        let vestingLockProperties specification = LockProperties with
              context = describeVestingSpecification specification
              expiresAt = endTime

        (optVestingLockedAmulet, optStillLocked, unlockedAmulet) <- case optSpecification of
          None -> do
            (optStillLocked, unlockedAmulet) <- partialUnlock forOwner lockedAmulet unlockAmount context
            pure (None, optStillLocked, Some unlockedAmulet)
          Some specification -> do
            (optStillLocked, vestingLockedAmulet) <- splitLockedAmulet forOwner lockedAmulet (unlockAmount, vestingLockProperties specification) context
            pure (Some (vestingLockedAmulet, specification), optStillLocked, None)

        governanceLock <- forA optStillLocked (\(lockedAmulet, stillLockedAmount) -> create
          this with
            lockedAmulet
            amount = stillLockedAmount)

        vestingLock <- forA optVestingLockedAmulet (\((lockedAmulet, vestingAmount), specification) -> create VestingLock with
          dso
          owner
          lockedAmulet
          vestingPeriod
          endTime
          vestingAmount
          specification
          originalLockCid = guard isFullUnlock $> coerceContractId self)

        pure GovernanceLock_UnlockResult with
          vestingLock
          governanceLock
          unlockedAmulet

data GovernanceLock_UnlockResult
  = GovernanceLock_UnlockResult with
      vestingLock : Optional (ContractId VestingLock)
      governanceLock : Optional (ContractId GovernanceLock)
      unlockedAmulet : Optional (ContractId Amulet)
  deriving (Eq, Show, Serializable)

data GovernanceLock_MergeAndTopUpResult
  = GovernanceLock_MergeAndTopUpResult with
      governanceLock : ContractId GovernanceLock
      changeHolding : Optional (ContractId Amulet)
  deriving (Eq, Show, Serializable)

data GovernanceLock_DsoConvertProvisionalFeaturedAppLockResult
   = GovernanceLock_DsoConvertProvisionalFeaturedAppLockResult
   deriving (Serializable)

-- | Implementation for the LockForGovernance choice on ExternalPartyAmuletRules and core implementation of token standard interfaces.
governanceLock_lockForGovernance_impl
  : Party
 -> Decimal
 -> [ContractId Holding]
 -> GovernanceLockSpecification
 -> ExtraArgs
 -> Party
 -> Time
 -> Update (GovernanceLock, ContractId GovernanceLock, Optional (ContractId Amulet))
governanceLock_lockForGovernance_impl dso amount inputs specification extraArgs owner requestedAt = do
  assertWithinDeadline "requestedAt + 1 day" $ requestedAt `addRelTime` days 1
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  requireMinimumLock state amount
  let lockProperties = LockProperties with
        context = describeGovernanceSpecification specification
        expiresAt = maxBound
  ([lockedAmulet], changeHolding) <- lockAmulet (ForOwner with dso; owner) [(amount, lockProperties)] inputs context ""
  let governanceLock = GovernanceLock with
        dso
        owner
        amount
        lockedAmulet
        specification
        requestedAt
        originalLockCid = None
  governanceLockCid <- create governanceLock
  pure (governanceLock, governanceLockCid, changeHolding)

governanceLockKindObservers : GovernanceLockKind -> [Party]
governanceLockKindObservers (GLK_FeaturedApp party) = [party]
governanceLockKindObservers (GLK_ProvisionalFeaturedApp party) = [party]
governanceLockKindObservers (GLK_SuperValidatorRightsOwner _) = []

-- | The kind of the `VestingLock` that unlocking a governance lock of this
-- kind creates. `None` for kinds that never vest.
toVestingLockKind : GovernanceLockKind -> Optional VestingLockKind
toVestingLockKind (GLK_FeaturedApp provider) = Some (VLK_FeaturedApp provider)
toVestingLockKind (GLK_ProvisionalFeaturedApp _) = None
toVestingLockKind (GLK_SuperValidatorRightsOwner svName) =
  Some (VLK_SuperValidatorRightsOwner svName)

governanceToVestingSpecification : GovernanceLockSpecification -> Optional VestingLockSpecification
governanceToVestingSpecification GovernanceLockSpecification {..} = case toVestingLockKind kind of
  None -> None
  Some kind -> Some VestingLockSpecification with kind

describeGovernanceLockKind : GovernanceLockKind -> Text
describeGovernanceLockKind (GLK_FeaturedApp with provider) = "Featured App party " <> partyToText provider
describeGovernanceLockKind (GLK_ProvisionalFeaturedApp with provider) = "Provisional Featured App party " <> partyToText provider
describeGovernanceLockKind (GLK_SuperValidatorRightsOwner with svName) = "SV rights for " <> svName

describeGovernanceSpecification : GovernanceLockSpecification -> Text
describeGovernanceSpecification lock = "Locked to support " <> describeGovernanceLockKind lock.kind

-- Lock properties for LockSubject types

vestingDurationFor : GovernanceLockKind -> ExternalPartyConfigState -> RelTime
vestingDurationFor (GLK_FeaturedApp _) state = governanceLockFeaturedAppLockVestingDuration state.governanceLockConfig
vestingDurationFor (GLK_ProvisionalFeaturedApp _) _ = days 0
vestingDurationFor (GLK_SuperValidatorRightsOwner _) state = governanceLockSuperValidatorLockVestingDuration state.governanceLockConfig

-- Substitution
-- ============

data GovernanceLockKey = GovernanceLockKey with
    dso : Party
    owner : Party
    specification : GovernanceLockSpecification
  deriving (Eq, Show, Serializable)

-- | A proposal for a substitution of a governance lock.
template GovernanceLockSubstitution with
    target : GovernanceLockKey
    owner : Party -- ^ Party that proposed the substitution
    amount : Decimal -- ^ Amount being substituted
    lockedAmulet : Optional (ContractId LockedAmulet)
    requestedAt : Time -- ^ Time of the request to create the proposal.
    expiresAt : Time -- ^ Time after which the registry admin may withdraw the proposal.
    originalSubstitutionCid : Optional (ContractId GovernanceLockSubstitution)
      -- ^ Contract id of the first proposal of this workflow. `None` for the first proposal itself.
  where
    signatory target.dso, owner
    observer target.owner, governanceLockKindObservers target.specification.kind
    -- A proposal by the target lock owner is funded by the target lock, not by `lockedAmulet`
    ensure if owner == target.owner then isNone lockedAmulet else True

    choice GovernanceLockSubstitution_Accept : GovernanceLockSubstitution_AcceptResult
      with
        actors : [Party]
        extraArgs : ExtraArgs
      controller actors
      do
        governanceLockSubstitution_acceptImpl self this actors extraArgs

    choice GovernanceLockSubstitution_Withdraw : GovernanceLockSubstitution_WithdrawResult
      with
        actors : [Party]
      controller actors
      do
        governanceLockSubstitution_withdrawImpl self this actors

    choice GovernanceLockSubstitution_Reject : GovernanceLockSubstitution_RejectResult
      with
        actors : [Party]
      controller actors
      do
        governanceLockSubstitution_rejectImpl self this actors

    choice GovernanceLockSubstitution_DsoExpire : GovernanceLockSubstitution_DsoExpireResult
      controller target.dso
      do
        assertDeadlineExceeded "GovernanceLockSubstitution.expiresAt" expiresAt
        forA_ lockedAmulet $ unlockAmulet (ForOwner with dso = target.dso; owner)
        pure GovernanceLockSubstitution_DsoExpireResult

    interface instance V1.TransferInstruction for GovernanceLockSubstitution where
      view = substitution_transferInstructionView SubstitutionTransferInstructionViewArgs with
        admin = target.dso
        targetOwner = target.owner
        proposer = owner
        amount
        meta = substitutionGovernanceLockMetadata target.specification
        requestedAt
        expiresAt
        lockedAmulet
        originalSubstitutionCid = toInterfaceContractId <$> originalSubstitutionCid

      transferInstruction_acceptImpl self V1.TransferInstruction_Accept{..} = do
        result <- governanceLockSubstitution_acceptImpl (coerceContractId self) this [target.owner] extraArgs
        pure $ substitutionTransferResult_completed result.unlockedAmulet
      transferInstruction_rejectImpl self _ = do
        result <- governanceLockSubstitution_rejectImpl (coerceContractId self) this [target.owner]
        pure $ substitutionTransferResult_failed result.unlockedAmulet
      transferInstruction_withdrawImpl self _ = do
        result <- governanceLockSubstitution_withdrawImpl (coerceContractId self) this [owner]
        pure $ substitutionTransferResult_failed result.unlockedAmulet
      transferInstruction_updateImpl _ _ = assertFail substitutionTransferUpdateUnsupported

data GovernanceLockSubstitution_AcceptResult
  = GovernanceLockSubstitution_AcceptResult with
      lockCid : ContractId GovernanceLock
      remainingLockCid : Optional (ContractId GovernanceLock)
      unlockedAmulet : Optional (ContractId Amulet)
        -- ^ The substituted funds, returned to the owner of the target lock.
        -- `None` if the proposer is the owner of the target lock, as no funds are then returned.
  deriving (Eq, Show, Serializable)

data GovernanceLockSubstitution_WithdrawResult
  = GovernanceLockSubstitution_WithdrawResult with
    unlockedAmulet : Optional (ContractId Amulet)
      -- ^ The funds returned to the proposer. `None` if the proposal did not lock any funds.
  deriving (Eq, Show, Serializable)

data GovernanceLockSubstitution_RejectResult
  = GovernanceLockSubstitution_RejectResult with
    unlockedAmulet : Optional (ContractId Amulet)
      -- ^ The funds returned to the proposer. `None` if the proposal did not lock any funds.
  deriving (Eq, Show, Serializable)

data GovernanceLockSubstitution_DsoExpireResult = GovernanceLockSubstitution_DsoExpireResult
  deriving (Serializable)

data GovernanceLock_DsoSubstituteResult = GovernanceLock_DsoSubstituteResult with
    remainingLockCid : Optional (ContractId GovernanceLock)
      -- ^ The lock that keeps the funds that were not substituted, if any.
    unlockedAmulet : ContractId Amulet
      -- ^ The substituted funds, returned to the owner.
  deriving (Eq, Show, Serializable)

governanceLock_substituteImpl : ContractId GovernanceLock -> GovernanceLock -> Decimal -> ExtraArgs -> Update GovernanceLock_DsoSubstituteResult
governanceLock_substituteImpl self this@GovernanceLock{..} substitutedAmount extraArgs = do
  let forOwner = ForOwner with dso; owner
  case substitutedAmount `compare` amount of
    LT -> do
      (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
      (Some (newLockedAmulet, remainingAmount), unlockedAmulet) <- partialUnlock forOwner lockedAmulet substitutedAmount context
      requireMinimumLock state remainingAmount
      requireMinimumLock state substitutedAmount
      remainingLockCid <- create this with
        amount = remainingAmount
        lockedAmulet = newLockedAmulet
        originalLockCid = Some $ fromOptional (toAnyContractId self) originalLockCid
      pure GovernanceLock_DsoSubstituteResult with
        remainingLockCid = Some remainingLockCid
        unlockedAmulet
    EQ -> do
      (unlockedAmulet, _) <- unlockAmulet forOwner lockedAmulet
      pure GovernanceLock_DsoSubstituteResult with
        remainingLockCid = None
        unlockedAmulet
    GT ->
      fail $ "substituted lock has less funds (" <> show amount <> ") than the amount proposed to be substituted (" <> show substitutedAmount <> ")"

data GovernanceLock_DsoSplitForSubstitutionResult = GovernanceLock_DsoSplitForSubstitutionResult with
    remainingLockCid : Optional (ContractId GovernanceLock)
      -- ^ The lock that keeps the funds that were not split off, if any.
    splitAmulet : ContractId LockedAmulet
      -- ^ The funds that were split off, locked for the new lock.
  deriving (Eq, Show, Serializable)

governanceLock_splitForSubstitutionImpl : ContractId GovernanceLock -> GovernanceLock -> Decimal -> GovernanceLockSpecification -> ExtraArgs -> Update GovernanceLock_DsoSplitForSubstitutionResult
governanceLock_splitForSubstitutionImpl self this@GovernanceLock{..} splitAmount newSpecification extraArgs = do
  let forOwner = ForOwner with dso; owner
      splitLockProperties = LockProperties with
        context = describeGovernanceSpecification newSpecification
        expiresAt = maxBound
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  case splitAmount `compare` amount of
    LT -> do
      (Some (newLockedAmulet, remainingAmount), (splitAmulet, _)) <- splitLockedAmulet forOwner lockedAmulet (splitAmount, splitLockProperties) context
      requireMinimumLock state remainingAmount
      requireMinimumLock state splitAmount
      remainingLockCid <- create this with
        amount = remainingAmount
        lockedAmulet = newLockedAmulet
        originalLockCid = Some $ fromOptional (toAnyContractId self) originalLockCid
      pure GovernanceLock_DsoSplitForSubstitutionResult with
        remainingLockCid = Some remainingLockCid
        splitAmulet
    EQ -> do
      splitAmulet <- relockAmulet forOwner lockedAmulet splitLockProperties context
      pure GovernanceLock_DsoSplitForSubstitutionResult with
        remainingLockCid = None
        splitAmulet
    GT ->
      fail $ "substituted lock has less funds (" <> show amount <> ") than the amount proposed to be substituted (" <> show splitAmount <> ")"

governanceLockSubstitution_acceptImpl : ContractId GovernanceLockSubstitution -> GovernanceLockSubstitution -> [Party] -> ExtraArgs -> Update GovernanceLockSubstitution_AcceptResult
governanceLockSubstitution_acceptImpl self GovernanceLockSubstitution{..} actors extraArgs = do
  checkActors actors [[target.owner]]
  (lockCid, _lock) <- fetchByKey @GovernanceLock target
  (newLockedAmulet, remainingLockCid, unlockedAmulet) <- case lockedAmulet of
    Some proposalLockedAmulet -> do
      substituteResult <- exercise lockCid GovernanceLock_DsoSubstitute with
        substitutedAmount = amount
        extraArgs
      pure (proposalLockedAmulet, substituteResult.remainingLockCid, Some substituteResult.unlockedAmulet)
    None -> do
      -- The proposer is the owner of the target lock, so the target lock funds the new lock
      splitResult <- exercise lockCid GovernanceLock_DsoSplitForSubstitution with
        splitAmount = amount
        newSpecification = target.specification
        extraArgs
      pure (splitResult.splitAmulet, splitResult.remainingLockCid, None)
  newLockCid <- create GovernanceLock with
    dso = target.dso
    owner
    amount
    lockedAmulet = newLockedAmulet
    specification = target.specification
    originalLockCid = Some $ toAnyContractId self
    requestedAt = requestedAt
  pure GovernanceLockSubstitution_AcceptResult with
    lockCid = newLockCid
    remainingLockCid
    unlockedAmulet

governanceLockSubstitution_withdrawImpl : ContractId GovernanceLockSubstitution -> GovernanceLockSubstitution -> [Party] -> Update GovernanceLockSubstitution_WithdrawResult
governanceLockSubstitution_withdrawImpl _self this actors = do
  checkActors actors [[this.owner]]
  GovernanceLockSubstitution_WithdrawResult <$> substitution_returnFunds this.target.dso this.owner this.lockedAmulet

governanceLockSubstitution_rejectImpl : ContractId GovernanceLockSubstitution -> GovernanceLockSubstitution -> [Party] -> Update GovernanceLockSubstitution_RejectResult
governanceLockSubstitution_rejectImpl _self this actors = do
  checkActors actors [[this.target.owner]]
  GovernanceLockSubstitution_RejectResult <$> substitution_returnFunds this.target.dso this.owner this.lockedAmulet

-- | Memo of a substitution proposal of a `GovernanceLock`: the memo of the new lock plus the accept request.
substitutionGovernanceLockMetadata : GovernanceLockSpecification -> Metadata
substitutionGovernanceLockMetadata = encodeGovernanceLockMetadataWithRequest governanceLockRequestAcceptToSubstituteLock

data AnySubstitution
  = AS_Governance with
      governanceLockKey : GovernanceLockKey
  | AS_Vesting with
      vestingLockKey : VestingLockKey
  deriving (Eq, Show, Serializable)

-- | Type to simplify passing in all the arguments required to create a substitution proposal.
--
data CreateSubstitutionArgs = CreateSubstitutionArgs with
    dso : Party
    substitution : AnySubstitution
    owner : Party -- ^ Party that proposed the substitution
    amount : Decimal -- ^ Amount being substituted
    inputHoldingCids : [ContractId Holding] -- ^ Holdings providing the funds
    extraArgs : ExtraArgs
    requestedAt : Time -- ^ Time of the request to create the proposal
  deriving (Eq, Show, Serializable)

createSubstitution : CreateSubstitutionArgs -> Update (ContractId V1.TransferInstruction, V1.TransferInstruction, Optional (ContractId Amulet))
createSubstitution CreateSubstitutionArgs {..} = do
  assertDeadlineExceeded "requestedAt" requestedAt
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  requireMinimumLock state amount
  let isSelfSubstitution = case substitution of
        AS_Governance{governanceLockKey} -> governanceLockKey.owner == owner
        AS_Vesting{vestingLockKey} -> vestingLockKey.owner == owner
  let lockProperties = LockProperties with
        -- TODO(canton-network/splice-sv-fa-locking#118): context decscription reads a bit strangely
        -- TODO(canton-network/splice-sv-fa-locking#118): actually format this at all.
        context = "" -- "Substitution proposal for " <> describeGovernanceLockKind target.specification
        expiresAt = maxBound
  -- A substitution proposed by the owner of the target lock is funded by the target lock on acceptance,
  -- so it locks no funds and ignores `inputHoldingCids`
  (lockedAmulet, changeHolding) <- if isSelfSubstitution
    then pure (None, None)
    else do
      ([lockedAmulet], changeHolding) <- lockAmulet (ForOwner with dso; owner) [(amount, lockProperties)] inputHoldingCids context ""
      pure (Some lockedAmulet, changeHolding)
  let forOwner = ForOwner with dso; owner
  let expiresAt = requestedAt `addRelTime` getTokenStandardMaxTTL state.transferConfig
  case substitution of
    (AS_Governance with ..) -> do
      substitutionCid <- create GovernanceLockSubstitution with
        target = governanceLockKey
        owner
        amount
        lockedAmulet
        requestedAt
        expiresAt
        originalSubstitutionCid = None
      substitution <- fetchChecked forOwner substitutionCid
      pure (toInterfaceContractId substitutionCid, toInterface substitution, changeHolding)
    (AS_Vesting with ..) -> do
      substitutionCid <- create VestingLockSubstitution with
        target = vestingLockKey
        owner
        amount
        lockedAmulet
        requestedAt
        expiresAt
        originalSubstitutionCid = None
      substitution <- fetchChecked forOwner substitutionCid
      pure (toInterfaceContractId substitutionCid, toInterface substitution, changeHolding)

-- Transfer
-- ========

instance LockKeyForOwner GovernanceLockKey where
  lockKeyDso = (.dso)
  lockKeyOwner = (.owner)

transferGovernanceLockMetadata : GovernanceLockSpecification -> Metadata
transferGovernanceLockMetadata = encodeGovernanceLockMetadataWithRequest governanceLockRequestAcceptToTransferLock

-- | A proposal by the owner of `GovernanceLock`s to transfer all or part of
-- them to a new owner. The proposal holds no funds: on accept, the locks
-- matching `transfer.source` are resolved by key, merged and split.
template GovernanceLockTransfer with
    transfer : LockTransfer GovernanceLockKey
      -- ^ The transfer's terms.
    expiresAt : Time
      -- ^ When the transfer proposal expires.
  where
    signatory lockKeyDso transfer, lockKeyOwner transfer
    observer transfer.receiver
    ensure isValidLockTransfer transfer

    choice GovernanceLockTransfer_Accept : GovernanceLockTransfer_AcceptResult
      with
        actors : [Party]
        extraArgs : ExtraArgs
      controller actors
      do
        governanceLockTransfer_acceptImpl self this actors extraArgs

    choice GovernanceLockTransfer_Withdraw : GovernanceLockTransfer_WithdrawResult
      with
        actors : [Party]
      controller actors
      do
        governanceLockTransfer_withdrawImpl this actors

    choice GovernanceLockTransfer_Reject : GovernanceLockTransfer_RejectResult
      with
        actors : [Party]
      controller actors
      do
        governanceLockTransfer_rejectImpl this actors

    interface instance V1.TransferInstruction for GovernanceLockTransfer where
      view = transfer_transferInstructionView TransferTransferInstructionViewArgs with
        transfer
        expiresAt
        meta = transferGovernanceLockMetadata (lockTransferSource transfer).specification

      transferInstruction_acceptImpl self V1.TransferInstruction_Accept{..} = do
        governanceLockTransfer_acceptImpl (fromInterfaceContractId self) this [transfer.receiver] extraArgs
        pure $ transferTransferResult_completed

      transferInstruction_rejectImpl _self _arg = do
        governanceLockTransfer_rejectImpl this [transfer.receiver]
        pure $ transferTransferResult_failed

      transferInstruction_withdrawImpl _self _arg = do
        governanceLockTransfer_withdrawImpl this [lockKeyOwner transfer]
        pure $ transferTransferResult_failed

      transferInstruction_updateImpl _ _ = assertFail transferTransferUpdateUnsupported

    choice GovernanceLockTransfer_DsoExpire : GovernanceLockTransfer_DsoExpireResult
      -- ^ Garbage-collect proposal that receiver never accepted, so SV nodes
      -- are not left storing it forever.
      controller lockKeyDso transfer
      do
        assertDeadlineExceeded "GovernanceLockTransfer.expiresAt" expiresAt
        pure GovernanceLockTransfer_DsoExpireResult

data GovernanceLockTransfer_DsoExpireResult = GovernanceLockTransfer_DsoExpireResult
  deriving (Serializable)

data GovernanceLockTransfer_AcceptResult
  = GovernanceLockTransfer_AcceptResult with
    lockCid : ContractId GovernanceLock
      -- ^ The new lock of the receiver, which holds the transferred funds.
    remainingLockCid : Optional (ContractId GovernanceLock)
      -- ^ The lock of the sender that keeps the funds that were not transferred, if any.
    lockedAmulet : ContractId LockedAmulet
      -- ^ The transferred funds, now locked for the owner of the new lock.
  deriving (Serializable)

data GovernanceLockTransfer_WithdrawResult = GovernanceLockTransfer_WithdrawResult
  deriving (Serializable)

data GovernanceLockTransfer_RejectResult = GovernanceLockTransfer_RejectResult
  deriving (Serializable)

data GovernanceLock_DsoTransferResult
  = GovernanceLock_DsoTransferResult with
    remainingLockCid : Optional (ContractId GovernanceLock)
      -- ^ The lock that keeps the funds that were not transferred, if any.
    unlockedAmulet : ContractId Amulet
      -- ^ The transferred funds, returned to the owner of the source lock.
  deriving (Serializable)

-- | Creates a proposal to transfer `amount` of the governance locks with key
-- `source` from their owner to `receiver`. Requires the authority of the
-- source's DSO party and `owner`. The proposal expires
-- `tokenStandardMaxTTL` after `requestedAt`.
--
-- The source locks are not looked up: they will be resolved by key when the
-- receiver accepts. So no funds move, and a proposal for a key that matches no
-- lock is still created.
createGovernanceLockTransfer
  :  LockTransferArgs GovernanceLockKey
  -> Update (ContractId GovernanceLockTransfer)
createGovernanceLockTransfer LockTransferArgs{transfer, extraArgs} = do
  validateLockTransfer transfer
  expiresAt <- lockTransferExpiresAt transfer extraArgs
  create GovernanceLockTransfer with
    transfer
    expiresAt

governanceLock_dsoTransferImpl : ContractId GovernanceLock -> GovernanceLock -> Decimal -> ExtraArgs -> Update GovernanceLock_DsoTransferResult
governanceLock_dsoTransferImpl self this@GovernanceLock{..} transferredAmount extraArgs = do
  let forOwner = ForOwner with dso; owner
  case transferredAmount `compare` amount of
    LT -> do
      (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
      (Some (newLockedAmulet, remainingAmount), unlockedAmulet) <- partialUnlock forOwner lockedAmulet transferredAmount context
      requireMinimumLock state remainingAmount
      requireMinimumLock state transferredAmount
      remainingLockCid <- create this with
        amount = remainingAmount
        lockedAmulet = newLockedAmulet
        originalLockCid = Some $ fromOptional (toAnyContractId self) originalLockCid
      pure GovernanceLock_DsoTransferResult with
        remainingLockCid = Some remainingLockCid
        unlockedAmulet
    EQ -> do
      (unlockedAmulet, _) <- unlockAmulet forOwner lockedAmulet
      pure GovernanceLock_DsoTransferResult with
        remainingLockCid = None
        unlockedAmulet
    GT ->
      fail $ "transferred lock has less funds (" <> show amount <> ") than the amount proposed to be transferred (" <> show transferredAmount <> ")"

governanceLockTransfer_acceptImpl : ContractId GovernanceLockTransfer -> GovernanceLockTransfer -> [Party] -> ExtraArgs -> Update GovernanceLockTransfer_AcceptResult
governanceLockTransfer_acceptImpl self GovernanceLockTransfer{..} actors extraArgs = do
  checkActors actors [[transfer.receiver]]
  let dso = lockKeyDso transfer
      source = lockTransferSource transfer
  (lockCid, _lock) <- fetchByKey @GovernanceLock source
  result <- exercise lockCid GovernanceLock_DsoTransfer with
    transferredAmount = transfer.amount
    extraArgs
  -- Lock the unlocked funds of the sender again, now for the receiver.
  -- This needs the authority of the receiver, which is the controller of this choice.
  (context, _) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  let lockProperties = LockProperties with
        context = describeGovernanceSpecification source.specification
        expiresAt = maxBound
  ([newLockedAmulet], None) <- lockAmuletFor
    (ForOwner with dso; owner = lockKeyOwner transfer)
    transfer.receiver
    [(transfer.amount, lockProperties)]
    [toInterfaceContractId result.unlockedAmulet]
    context
    ""
  newLockCid <- create GovernanceLock with
    dso
    owner = transfer.receiver
    amount = transfer.amount
    lockedAmulet = newLockedAmulet
    specification = source.specification
    originalLockCid = Some $ toAnyContractId self
    requestedAt = transfer.requestedAt
  pure GovernanceLockTransfer_AcceptResult with
    lockCid = newLockCid
    remainingLockCid = result.remainingLockCid
    lockedAmulet = newLockedAmulet

governanceLockTransfer_withdrawImpl : GovernanceLockTransfer -> [Party] -> Update GovernanceLockTransfer_WithdrawResult
governanceLockTransfer_withdrawImpl GovernanceLockTransfer{..} actors = do
  checkActors actors [[lockKeyOwner transfer]]
  pure GovernanceLockTransfer_WithdrawResult

governanceLockTransfer_rejectImpl : GovernanceLockTransfer -> [Party] -> Update GovernanceLockTransfer_RejectResult
governanceLockTransfer_rejectImpl GovernanceLockTransfer{..} actors = do
  checkActors actors [[transfer.receiver]]
  pure GovernanceLockTransfer_RejectResult

-- Metadata
-- ========

encodeGovernanceLockSpecMetadata : GovernanceLockSpecification -> Metadata
encodeGovernanceLockSpecMetadata spec =
  let (tag, subject) = governanceLockKindToTagAndSubject spec.kind
  in encodeCommonLockMetadata tag subject LS_Locked emptyMetadata

encodeGovernanceLockMetadata : GovernanceLock -> Metadata
encodeGovernanceLockMetadata GovernanceLock{specification} =
  let meta = encodeGovernanceLockSpecMetadata specification
      memo = encodeLockCompatMemo meta
  in reasonToMeta memo meta

encodeGovernanceLockMetadataWithRequest : Text -> GovernanceLockSpecification -> Metadata
encodeGovernanceLockMetadataWithRequest request spec =
  let meta = encodeRequestMetadata request <> encodeGovernanceLockSpecMetadata spec
      memo = encodeLockCompatMemo meta
  in reasonToMeta memo meta

governanceLockKindToTagAndSubject : GovernanceLockKind -> (LockKindTag, Text)
governanceLockKindToTagAndSubject (GLK_FeaturedApp provider) = (LKT_FeaturedApp, partyToText provider)
governanceLockKindToTagAndSubject (GLK_ProvisionalFeaturedApp provider) = (LKT_ProvisionalFeaturedApp, partyToText provider)
governanceLockKindToTagAndSubject (GLK_SuperValidatorRightsOwner svName) = (LKT_SuperValidator, svName)

-- TSv1 support
-- ============

governanceLock_transferFactoryV1_transferImpl
  :  Party
  -> [Party]
  -> V1.TransferFactory_Transfer
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_transferImpl dso actors arg@V1.TransferFactory_Transfer{expectedAdmin, transfer} = do
  checkActors actors [[transfer.sender]]

  -- validate call to factory and retrieve context
  requireMatchExpected ("admin", expectedAdmin) dso
  requireMatchExpected ("instrumentId", transfer.instrumentId) (amuletInstrumentId dso)
  assertDeadlineExceeded "transfer.requestedAt" transfer.requestedAt
  assertWithinDeadline "transfer.executeBefore" transfer.executeBefore

  request <- parseGovernanceLockRequestTSv1 dso transfer.receiver transfer.meta

  case request of
    GLR_CreateGovernanceLock{governanceSpecification} ->
      governanceLock_transferFactoryV1_lockImpl dso arg governanceSpecification
    GLR_UnlockGovernanceLock{governanceSpecification, unlockAmount, vestingStartTime} ->
      governanceLock_transferFactoryV1_unlockImpl dso arg governanceSpecification unlockAmount vestingStartTime
    GLR_TransferGovernanceLock{governanceSpecification,  newOwner, transferAmount} ->
      governanceLock_transferFactoryV1_transferLockImpl dso arg governanceSpecification  newOwner transferAmount
    GLR_WithdrawVestingLock{vestingSpecification, vestedUntilTime, vestingPeriod, vestingEndTime} ->
      vestingLock_transferFactoryV1_withdrawImpl dso arg vestingSpecification vestedUntilTime vestingPeriod vestingEndTime
    GLR_SubstituteLock{substitution} ->
      governanceLock_transferFactoryV1_substituteImpl dso arg substitution

governanceLock_transferFactoryV1_lockImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> GovernanceLockSpecification
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_lockImpl dso V1.TransferFactory_Transfer{transfer, extraArgs} specification = do
  (lock, lockCid, changeCid) <- governanceLock_lockForGovernance_impl
    dso transfer.amount transfer.inputHoldingCids specification extraArgs transfer.sender transfer.requestedAt

  let lockTransfer = (view $ toInterface @V1.TransferInstruction lock).transfer
  requireMatchExpected ("lock transfer", lockTransfer) transfer with
    executeBefore = lockTransfer.executeBefore
    inputHoldingCids = lockTransfer.inputHoldingCids
    meta = lockTransfer.meta

  pure $ V1.TransferInstructionResult with
    output = V1.TransferInstructionResult_Pending with
      transferInstructionCid = toInterfaceContractId $ lockCid
    senderChangeCids = optionalToList $ toInterfaceContractId <$> changeCid
    meta = emptyMetadata

governanceLock_transferFactoryV1_unlockImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> GovernanceLockSpecification
  -> Decimal
  -> Time
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_unlockImpl dso V1.TransferFactory_Transfer{transfer, extraArgs} specification unlockAmount vestingStartTime = do
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  (lockCid, lock) <- fetchByKey @GovernanceLock $ GovernanceLockKey with
    dso
    owner = transfer.sender
    specification
  potentiallyUnsafeArchive lockCid
  result <- governanceLock_unlockImpl lockCid lock unlockAmount vestingStartTime [transfer.sender] context state
  pure V1.TransferInstructionResult with
    output = case result.vestingLock of
      Some vestingLock -> V1.TransferInstructionResult_Pending with
        transferInstructionCid = toInterfaceContractId vestingLock
      None -> V1.TransferInstructionResult_Completed with
        receiverHoldingCids = []
    senderChangeCids = toList $ fmap toInterfaceContractId result.unlockedAmulet
    meta = emptyMetadata

governanceLock_transferFactoryV1_transferLockImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> GovernanceLockSpecification
  -> Party
  -> Decimal
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_transferLockImpl _dso V1.TransferFactory_Transfer{..} _specification _newOwner _transferAmount = do
  error "unimplemented"

governanceLock_transferFactoryV1_substituteImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> AnySubstitution
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_substituteImpl dso V1.TransferFactory_Transfer{..} substitution = do
  (substitutionCid, substitution, changeCid) <- createSubstitution CreateSubstitutionArgs with
    dso
    substitution
    owner = transfer.sender
    amount = transfer.amount
    inputHoldingCids = transfer.inputHoldingCids
    extraArgs
    requestedAt = transfer.requestedAt

  let substitutionTransfer = (view substitution).transfer
  requireMatchExpected ("substitution transfer", substitutionTransfer) transfer with
    -- The receiver of the substitution is the owner of the target lock, not `lockManagerParty`
    receiver = substitutionTransfer.receiver
    executeBefore = substitutionTransfer.executeBefore
    inputHoldingCids = substitutionTransfer.inputHoldingCids
    meta = substitutionTransfer.meta

  pure V1.TransferInstructionResult with
    output = V1.TransferInstructionResult_Pending with
      transferInstructionCid = substitutionCid
    senderChangeCids = optionalToList $ toInterfaceContractId <$> changeCid
    meta = emptyMetadata

-- Parsers
----------

governanceLockKindFromTagAndSubject : CanAssert m => LockKindTag -> Text -> m GovernanceLockKind
governanceLockKindFromTagAndSubject tag subject =
    case tag of
      LKT_FeaturedApp -> GLK_FeaturedApp <$> parseProvider
      LKT_ProvisionalFeaturedApp -> GLK_ProvisionalFeaturedApp <$> parseProvider
      LKT_SuperValidator -> GLK_SuperValidatorRightsOwner <$> parseSvName
  where
    tagText = lockKindTagToText tag
    parseProvider = case partyFromText subject of
      Some p -> pure p
      None -> assertFail $ "Invalid provider for " <> tagText <> ": " <> subject
    parseSvName
      | Text.isPred (\c -> c == "-" || Text.isAlphaNum c) subject = pure subject
      | otherwise = assertFail $ "Invalid SV name for " <> tagText <> ": " <> subject

data GovernanceLockRequest
  = GLR_CreateGovernanceLock with
      governanceSpecification : GovernanceLockSpecification
  | GLR_UnlockGovernanceLock with
      governanceSpecification : GovernanceLockSpecification
      unlockAmount : Decimal
      vestingStartTime : Time
  | GLR_TransferGovernanceLock with
      governanceSpecification : GovernanceLockSpecification
      newOwner : Party
      transferAmount : Decimal
  | GLR_WithdrawVestingLock with
      vestingSpecification : VestingLockSpecification
      vestedUntilTime : Time
      vestingPeriod : RelTime
      vestingEndTime : Time
  | GLR_SubstituteLock with
      substitution : AnySubstitution
  deriving (Show)

governanceLockSubjectParser : Parser Metadata Text
governanceLockSubjectParser = requiredMetadataParser lockSubjectMetaKey

governanceLockKindParser' : LockKindTag -> Parser Metadata GovernanceLockKind
governanceLockKindParser' tag = governanceLockSubjectParser >>= governanceLockKindFromTagAndSubject tag

governanceLockKindParser : Parser Metadata GovernanceLockKind
governanceLockKindParser = lockKindTagParser >>= governanceLockKindParser'

-- | Converts a parsed lock kind to the kind of a vesting lock. Fails for kinds
-- that never vest.
toVestingLockKindParser : GovernanceLockKind -> Parser i VestingLockKind
toVestingLockKindParser kind = case toVestingLockKind kind of
  None ->
    let (tag, _) = governanceLockKindToTagAndSubject kind
    in assertFail $
      "Invalid lock kind for a vesting lock: '"
        <> lockKindTagToText tag <> "'"
  Some vestingKind -> pure vestingKind

vestingLockKindParser : Parser Metadata VestingLockKind
vestingLockKindParser = governanceLockKindParser >>= toVestingLockKindParser

governanceLockSpecificationParser : Parser Metadata GovernanceLockKind -> Parser Metadata GovernanceLockSpecification
governanceLockSpecificationParser kindParser =
  GovernanceLockSpecification <$> kindParser

vestingLockSpecificationParser : Parser Metadata VestingLockKind -> Parser Metadata VestingLockSpecification
vestingLockSpecificationParser kindParser =
  VestingLockSpecification <$> kindParser

glr_createGovernanceLock_parser : Parser Metadata GovernanceLockKind -> Parser Metadata GovernanceLockRequest
glr_createGovernanceLock_parser kindParser =
  GLR_CreateGovernanceLock <$> governanceLockSpecificationParser kindParser

glr_unlockGovernanceLock_parser : Parser Metadata GovernanceLockKind -> Parser Metadata GovernanceLockRequest
glr_unlockGovernanceLock_parser kindParser =
  GLR_UnlockGovernanceLock <$>
    governanceLockSpecificationParser kindParser <*>
    unlockAmountParser <*>
    vestingStartTimeParser

glr_transferGovernanceLock_parser : Parser Metadata GovernanceLockKind -> Parser Metadata GovernanceLockRequest
glr_transferGovernanceLock_parser kindParser =
  GLR_TransferGovernanceLock <$>
    governanceLockSpecificationParser kindParser <*>
    partyFromMetadataParser newLockOwnerMetaKey <*>
    transferAmountParser

glr_withdrawVestingLock_parser : Parser Metadata VestingLockKind -> Parser Metadata GovernanceLockRequest
glr_withdrawVestingLock_parser kindParser =
  GLR_WithdrawVestingLock <$>
    vestingLockSpecificationParser kindParser <*>
    vestedUntilTimeParser <*>
    vestingDurationParser <*>
    vestingEndTimeParser

glr_substituteLock_parser : LockKindTag -> Party -> Parser Metadata GovernanceLockRequest
glr_substituteLock_parser tag admin = do
  targetState <- lockStateParser
  targetOwner <- partyFromMetadataParser targetLockOwnerMetaKey
  GLR_SubstituteLock <$> case targetState of
    LS_Locked -> do
      kind <- governanceLockKindParser' tag
      pure
        $ AS_Governance with
          governanceLockKey = GovernanceLockKey with
            dso = admin
            owner = targetOwner
            specification = GovernanceLockSpecification kind
    LS_Vesting -> do
      kind <- governanceLockKindParser' tag >>= toVestingLockKindParser
      vestingPeriod <- vestingDurationParser
      endTime <- vestingEndTimeParser
      pure
        $ AS_Vesting with
          vestingLockKey = VestingLockKey with
            dso = admin
            owner = targetOwner
            specification = VestingLockSpecification kind
            vestingPeriod
            endTime

governanceLockRequestTSv1Parser : Party -> Party -> Parser Metadata GovernanceLockRequest
governanceLockRequestTSv1Parser admin receiver = requiredMetadataParser requestMetaKey >>= (\tag -> checkReceiverIsLockManager *> case tag of
    r | r == governanceLockRequestCreateLock -> do glr_createGovernanceLock_parser governanceLockKindParser
    r | r == governanceLockRequestUnlockAndStartVesting -> glr_unlockGovernanceLock_parser governanceLockKindParser
    r | r == governanceLockRequestTransferLock -> glr_transferGovernanceLock_parser governanceLockKindParser
    r | r == governanceLockRequestWithdrawVestedFunds -> glr_withdrawVestingLock_parser vestingLockKindParser
    r | r == governanceLockRequestSubstituteLock -> lockKindTagParser >>= \tag -> glr_substituteLock_parser tag admin
    r -> assertFail $ "Invalid request: '" <> r <> "'")
  where
    checkReceiverIsLockManager : Parser Metadata ()
    checkReceiverIsLockManager =
      unless (receiver == lockManagerParty) $ assertFail ("Invalid receiver: '" <> show receiver <> "'")

parseGovernanceLockRequestTSv1 : CanAssert m => Party -> Party -> Metadata -> m GovernanceLockRequest
parseGovernanceLockRequestTSv1 admin receiver rawMeta = do
  meta <- parseGovernanceLockMetadata rawMeta
  assertParsed (governanceLockRequestTSv1Parser admin receiver) meta

-- SV Reward Coupon Helpers
---------------------------

fetchAndValidateIssuingMiningRounds : [AnyValue] -> ForDso -> Update (Map Round IssuingMiningRound, Map Round (ContractId IssuingMiningRound))
fetchAndValidateIssuingMiningRounds vals forDso = do
  issuingMiningRounds <- forA vals $ \(AV_ContractId cid) -> do
    let issuingMiningRoundCid = fromAnyContractId cid
    issuingMiningRound <- fetchReferenceData @IssuingMiningRound forDso issuingMiningRoundCid
    let round = issuingMiningRound.round
    assertDeadlineExceeded ("issuingMiningRound[" <> show round.number <> "].opensAt") issuingMiningRound.opensAt
    pure (round, (issuingMiningRound, issuingMiningRoundCid))
  let issuingMiningRounds' = [(round, miningRound) | (round, (miningRound, _)) <- issuingMiningRounds]
      issuingMiningRoundCids = [(round, miningRoundCid) | (round, (_, miningRoundCid)) <- issuingMiningRounds]
  pure (Map.fromList issuingMiningRounds', Map.fromList issuingMiningRoundCids)

getSvRewardInputAmuletAndChange
  : [ContractId SvRewardCoupon]
  -> Decimal
  -> ExtraArgs
  -> ForOwner
  -> ContractId TransferEventsV2.EventLog
  -> Update ([ContractId Holding], Decimal)
getSvRewardInputAmuletAndChange [] _ _ _ _ = pure ([], 0.0)
getSvRewardInputAmuletAndChange svRewardCouponInputs svRewardCouponPercentage extraArgs forOwner transferEventsV2EventLog = do
  let dso = forOwner.dso
  (currentIssuingMiningRoundCids, openMiningRoundCid) <- getMiningRoundsFromChoiceContext extraArgs.context
  (_, issuingMiningRoundCidsMap) <-
    fetchAndValidateIssuingMiningRounds (toAnyValue <$> currentIssuingMiningRoundCids) $ ForDso with dso

  let transferContext = TransferContext with
        openMiningRound = openMiningRoundCid
        issuingMiningRounds = issuingMiningRoundCidsMap
        validatorRights = Map.empty
        featuredAppRight = None
      transfer = Splice.AmuletRules.Transfer with
        sender = forOwner.owner
        provider = forOwner.owner -- the sender is serving as its own "app provider"
        outputs = []
        inputs = fmap InputSvRewardCoupon svRewardCouponInputs
        beneficiaries = None
      rewardsConfig = RewardsIssuanceConfig with
        issueAppRewards = False
        issueValidatorRewards = False

  result <- executeTransfer transferEventsV2EventLog rewardsConfig transferContext dso [] transfer
  let (Some changeFromSvCouponRewards) : Optional (ContractId Amulet) = result.senderChangeAmulet

  amulet <- fetchChecked forOwner changeFromSvCouponRewards
  let svRewardMintAllowance = amulet.amount.initialAmount * svRewardCouponPercentage

  pure ([toInterfaceContractId changeFromSvCouponRewards], svRewardMintAllowance)

-- Instances
------------

instance HasCheckedFetch GovernanceLock ForOwner where
  contractGroupId GovernanceLock{..} = ForOwner with dso; owner = owner

instance HasCheckedFetch GovernanceLockSubstitution ForOwner where
  contractGroupId GovernanceLockSubstitution{..} = ForOwner with dso = target.dso; owner
