module Splice.GovernanceLock.Substitution (
  -- * Templates and choices
  GovernanceLockSubstitution(..),
  GovernanceLockSubstitution_DsoExpire(..),
  GovernanceLockSubstitution_DsoExpireResult(..),

  -- * Operations
  GovernanceLockProposeSubstitutionArgs(..),
  governanceLock_proposeSubstitution,
  governanceLockSubstitution_operations,
) where

import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.Map qualified as Map
import DA.Optional
import DA.Set qualified as Set
import DA.Time

import Splice.Amulet
import Splice.AmuletConfig (getTokenStandardMaxTTL)
import Splice.AmuletRules
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.ExternalPartyConfigState
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.GovernanceLock.Proposal
import Splice.TokenStandard.Utils
import Splice.Types
import Splice.Util

-- | A proposal for a substitution of a governance lock.
template GovernanceLockSubstitution with
    target : GovernanceLockKey
    owner : Party -- ^ Party that proposed the substitution
    amount : Decimal -- ^ Amount being substituted
    lockedAmulet : Optional (ContractId LockedAmulet)
    requestedAt : Time -- ^ Time of the request to create the proposal.
    expiresAt : Time -- ^ Time after which the DSO party may withdraw the proposal.
    originalSubstitutionCid : Optional (ContractId GovernanceLockSubstitution)
      -- ^ Contract id of the first proposal of this workflow. `None` for the first proposal itself.
    newUnlockControllers : Optional ControllersSpecification -- ^ New custom unlock controllers of the substituted lock.
    newSubstitutionControllers : Optional ControllersSpecification -- ^ New custom substitution controllers of the substituted lock.
    newVestingControllers : Optional ControllersSpecification -- ^ New custom vesting controllers of the substituted lock.
    votes : Optional (Map.Map Party Bool) -- ^ Votes recorded so far.
  where
    signatory target.dso, owner
    observer target.owner, governanceLockObservers target.specification,
             (Set.fromList $ concat (governanceLockSubstitutionControllers this).controllers)
    -- A proposal by the target lock owner is funded by the target lock, not by `lockedAmulet`
    ensure if owner == target.owner then isNone lockedAmulet else True &&
      either error (const True) (validateNewGovernanceLockControllers target.specification newUnlockControllers newSubstitutionControllers newVestingControllers)

    choice GovernanceLockSubstitution_DsoExpire : GovernanceLockSubstitution_DsoExpireResult
      controller target.dso
      do
        assertDeadlineExceeded "GovernanceLockSubstitution.expiresAt" expiresAt
        substitution_returnFunds target.dso owner target.specification lockedAmulet
        pure GovernanceLockSubstitution_DsoExpireResult

    interface instance V1.TransferInstruction for GovernanceLockSubstitution where
      view = proposal_transferInstructionViewV1 governanceLockSubstitution_operations "substitution" target.owner this
      transferInstruction_acceptImpl = proposal_transferInstructionV1_acceptImpl governanceLockSubstitution_operations this [target.owner]
      transferInstruction_rejectImpl = proposal_transferInstructionV1_rejectImpl governanceLockSubstitution_operations this [target.owner]
      transferInstruction_withdrawImpl = proposal_transferInstructionV1_withdrawImpl governanceLockSubstitution_operations this
      transferInstruction_updateImpl _ _ = fail "Transfers representing governance lock substitutions cannot be updated"

    interface instance V2.TransferInstruction for GovernanceLockSubstitution where
      view = proposal_transferInstructionViewV2 governanceLockSubstitution_operations this
      transferInstruction_acceptImpl = proposal_transferInstructionV2_acceptImpl governanceLockSubstitution_operations this
      transferInstruction_rejectImpl = proposal_transferInstructionV2_rejectImpl governanceLockSubstitution_operations this
      transferInstruction_withdrawImpl = proposal_transferInstructionV2_withdrawImpl governanceLockSubstitution_operations this
      transferInstruction_acceptExtraObservers _ = observer this
      transferInstruction_rejectExtraObservers _ = observer this
      transferInstruction_withdrawExtraObservers _ = observer this

data GovernanceLockSubstitution_DsoExpireResult = GovernanceLockSubstitution_DsoExpireResult {}
  deriving (Serializable)

governanceLockSubstitution_proposalView : GovernanceLockSubstitution -> ProposalView GovernanceLockSubstitution
governanceLockSubstitution_proposalView proposal@GovernanceLockSubstitution{..} = ProposalView with
  lockKey = target
  proposers = [owner]
  controllers = governanceLockSubstitutionControllers proposal
  votes = fromOptional Map.empty votes
  amount
  lockedAmulet
  requestedAt
  expiresAt
  originalProposalCid = originalSubstitutionCid
  meta = governanceLockSubstitutionMetadata proposal

governanceLockSubstitutionControllers : GovernanceLockSubstitution -> ControllersSpecification
governanceLockSubstitutionControllers GovernanceLockSubstitution{target, owner} =
  let optControllers = case target.specification of
        GLS_FullLock spec -> spec.substitutionControllers
        GLS_VestingLock spec -> spec.vestingControllers
      controllerSets = optional [[]] (.controllers) optControllers
  in makeControllersSpecification $ fmap (\s -> target.owner :: owner :: s) controllerSets

-- | Memo of a substitution proposal of a `GovernanceLock`: the memo of the new lock plus the accept request.
governanceLockSubstitutionMetadata : GovernanceLockSubstitution -> Metadata
governanceLockSubstitutionMetadata GovernanceLockSubstitution{..} =
  encodeGovernanceLockMetadataWithRequest'
    (<> encodeGovernanceLockNewCustomControllersMetadataEntries newUnlockControllers newSubstitutionControllers newVestingControllers)
    "accept-to-substitute-lock"
    target.specification

data GovernanceLock_SubstitutionResult_Completed = GovernanceLock_SubstitutionResult_Completed with
  lockCid : ContractId GovernanceLock
  remainingLockCid : Optional (ContractId GovernanceLock)
  unlockedAmulet : Optional (ContractId Amulet)
    -- ^ The substituted funds, returned to the owner of the target lock.
    -- `None` if the proposer is the owner of the target lock, as no funds are then returned.

type GovernanceLock_SubstitutionResult = ProposalUpdateResult GovernanceLockSubstitution GovernanceLock_SubstitutionResult_Completed

governanceLock_substitutionResult_completed_transferInstructionResult : GovernanceLock_SubstitutionResult_Completed -> V2.TransferInstructionResult
governanceLock_substitutionResult_completed_transferInstructionResult GovernanceLock_SubstitutionResult_Completed{..} =
  V2.TransferInstructionResult with
    output = V2.TransferInstructionResult_Completed with
      receiverHoldingCids = toInterfaceContractId <$> optionalToList unlockedAmulet
    senderChangeCids = []
    meta = emptyMetadata

-- | Type to simplify passing in all the arguments required to create a substitution proposal.
data GovernanceLockProposeSubstitutionArgs = GovernanceLockProposeSubstitutionArgs with
  dso : Party
  target : GovernanceLockKey
  owner : Party -- ^ Party that proposed the substitution
  newUnlockControllers : Optional ControllersSpecification -- ^ New custom unlock controllers of the substituted lock.
  newSubstitutionControllers : Optional ControllersSpecification -- ^ New custom substitution controllers of the substituted lock.
  newVestingControllers : Optional ControllersSpecification -- ^ New custom vesting controllers of the substituted lock.
  amount : Decimal -- ^ Amount being substituted
  inputHoldingCids : [ContractId Holding] -- ^ Holdings providing the funds
  extraArgs : ExtraArgs
  requestedAt : Time -- ^ Time of the request to create the proposal
  reason : Text -- ^ Memo of the request to create the proposal, which the transfer legs report as their reason
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState

governanceLock_proposeSubstitution : GovernanceLockProposeSubstitutionArgs -> Update (GovernanceLock_SubstitutionResult, Optional (ContractId Amulet))
governanceLock_proposeSubstitution GovernanceLockProposeSubstitutionArgs {..} = do
  assertInPast24Hours "requestedAt" requestedAt
  requireMinimumLock state amount
  -- A substitution proposed by the owner of the target lock is funded by the target lock on acceptance,
  -- so it locks no funds and ignores `inputHoldingCids`
  (lockedAmulet, changeHolding) <- if target.owner == owner
    then pure (None, None)
    else do
      ([lockedAmulet], changeHolding) <- lockAmulet
        (ForOwner with dso; owner)
        [(amount, governanceLockExpiresAt target.specification)]
        inputHoldingCids
        context
        reason
      pure (Some lockedAmulet, changeHolding)
  let maxExpiresAt = requestedAt `addRelTime` getTokenStandardMaxTTL state.transferConfig
  expiresAt <- case target.specification of
    GLS_FullLock _ -> pure maxExpiresAt
    GLS_VestingLock VestingLockSpecification{endTime} -> do
      assertWithinDeadline "target lock endTime" endTime
      pure $ min maxExpiresAt endTime

  validateNewGovernanceLockControllers target.specification newUnlockControllers newSubstitutionControllers newVestingControllers

  result <- proposal_create governanceLockSubstitution_operations ProposalUpdateArgs with
    proposalCid = None
    proposal = GovernanceLockSubstitution with
      target
      owner
      newUnlockControllers
      newSubstitutionControllers
      newVestingControllers
      amount
      lockedAmulet
      votes = Some Map.empty
      requestedAt
      expiresAt
      originalSubstitutionCid = None
    actors = [owner]
    reason
    getContext = pure (context, state)

  pure (result, changeHolding)

governanceLock_executeSubstitution : ProposalExecuteArgs GovernanceLockSubstitution -> Update GovernanceLock_SubstitutionResult_Completed
governanceLock_executeSubstitution ProposalExecuteArgs{..} = do
  let GovernanceLock_DsoMergeResult{lockCid} = merged
      GovernanceLockSubstitution{..} = proposal
  -- The target lock owner may not be a controller of the substitution, so act on the target lock
  -- through choices that provide the authority of its owner
  (newLockedAmulet, remainingLockCid, unlockedAmulet) <- case lockedAmulet of
    Some proposalLockedAmulet -> do
      substituteResult <- exercise lockCid GovernanceLock_DsoSubstitute with
        substitutedAmount = amount
        reason
        context
        state
      pure (proposalLockedAmulet, substituteResult.remainingLockCid, Some substituteResult.unlockedAmulet)
    None -> do
      -- The proposer is the owner of the target lock, so the target lock funds the new lock
      splitResult <- exercise lockCid GovernanceLock_DsoSplitForSubstitution with
        splitAmount = amount
        newSpecification = target.specification
        reason
        context
        state
      pure (splitResult.splitAmulet, splitResult.remainingLockCid, None)
  newLockCid <- create GovernanceLock with
    dso = target.dso
    owner
    amount
    lockedAmulet = newLockedAmulet
    specification = setNewGovernanceLockControllers target.specification newUnlockControllers newSubstitutionControllers newVestingControllers
    originalLockCid = toAnyContractId <$> proposalCid
    requestedAt = requestedAt
  pure GovernanceLock_SubstitutionResult_Completed with
    lockCid = newLockCid
    remainingLockCid
    unlockedAmulet

-- | Unlocks the funds of a substitution proposal, which returns them to the proposer.
-- Returns `None` if the proposal did not lock any funds, or if the lock of the funds has expired.
substitution_returnFunds : Party -> Party -> GovernanceLockSpecification -> Optional (ContractId LockedAmulet) -> Update (Optional (ContractId Amulet))
substitution_returnFunds _ _ _ None = pure None
substitution_returnFunds dso proposer specification (Some lockedAmuletCid) = do
  lockExpired <- isLedgerTimeGE (governanceLockExpiresAt specification)
  if lockExpired
    then pure None
    else Some . fst <$> unlockAmulet (ForOwner with dso; owner = proposer) lockedAmuletCid

governanceLockSubstitution_operations : ProposalOperations GovernanceLockSubstitution GovernanceLock_SubstitutionResult_Completed
governanceLockSubstitution_operations = ProposalOperations with
  makeView = governanceLockSubstitution_proposalView
  recreate = \votes originalSubstitutionCid proposal ->
    let updatedProposal = proposal with votes = Some votes; originalSubstitutionCid
    in (, updatedProposal) <$> create updatedProposal
  execute = governanceLock_executeSubstitution
  completedResult = governanceLock_substitutionResult_completed_transferInstructionResult
  rejectedResult = Some $ \ProposalUpdateArgs{proposal = GovernanceLockSubstitution{..}} -> do
    unlockedAmulet <- substitution_returnFunds target.dso owner target.specification lockedAmulet
    pure V2.TransferInstructionResult with
      output = V2.TransferInstructionResult_Failed
      senderChangeCids = toInterfaceContractId <$> optionalToList unlockedAmulet
      meta = emptyMetadata

-- Instances
------------

instance HasCheckedFetch GovernanceLockSubstitution ForDso where
  contractGroupId GovernanceLockSubstitution{..} = ForDso with dso = target.dso
