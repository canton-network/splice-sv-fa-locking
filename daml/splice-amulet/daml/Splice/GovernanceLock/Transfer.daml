-- | Proposals to transfer some or all of a `GovernanceLock`, approved by a full
-- lock's substitution controllers, and by a vesting lock's vesting controllers.
module Splice.GovernanceLock.Transfer (
  -- * Templates and choices
  GovernanceLockTransfer(..),
  GovernanceLockTransfer_DsoExpire(..),
  GovernanceLockTransfer_DsoExpireResult(..),

  -- * State and operations
  governanceLockTransferMetadata,
  GovernanceLockProposeTransferArgs(..),
  governanceLock_proposeTransfer,
) where

import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.List qualified as List
import DA.Map qualified as Map
import DA.Optional
import DA.Time

import Splice.Amulet
import Splice.AmuletConfig (getTokenStandardMaxTTL)
import Splice.AmuletRules
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.ExternalPartyConfigState
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.GovernanceLock.Proposal qualified as Proposal
import Splice.TokenStandard.Utils hiding (require, require')
import Splice.Types
import Splice.Util

template GovernanceLockTransfer with
    source : GovernanceLockKey
      -- ^ Source locks to be transferred. Locks are resolved by key.
    receiver : Party
      -- ^ New owner, who accepts the transfer.
    amount : Decimal
      -- ^ Amount moved out of the source locks.
    requestedAt : Time
      -- ^ When the proposers requested the transfer.
    expiresAt : Time
      -- ^ When the transfer proposal expires.
    proposers : Optional [Party]
      -- ^ The parties that proposed the transfer.
    newControllers : Optional GovernanceLockControllers
      -- ^ New custom controllers of the transferred lock.
      -- Note: the new controllers are specified by the proposers of the transfer, rather than the receiver.
      -- This is an accepted departure from CIP-0127.
    votes : Optional Proposal.ProposalVotes
      -- ^ Votes recorded so far.
    originalProposalCid : Optional (ContractId GovernanceLockTransfer)
  where
    signatory source.dso, governanceLockTransferProposers this,
              -- Make the receiver a signatory once they've approved the transfer
              -- This is necessary for `governanceLock_executeTransfer` to have the authority of the receiver when locking amulet
              (if Map.lookup receiver (governanceLockTransferVotes this) == Some Proposal.PV_Accept
                then [receiver]
                else [])
    observer receiver, allControllers (governanceLockTransferControllers this)
    ensure validationSucceeds (validateGovernanceLockTransfer this)

    interface instance V1.TransferInstruction for GovernanceLockTransfer where
      view = Proposal.transferInstructionViewV1 "transfer" this
      transferInstruction_acceptImpl = Proposal.transferInstructionV1_acceptImpl this [receiver]
      transferInstruction_rejectImpl = Proposal.transferInstructionV1_rejectImpl this [receiver]
      transferInstruction_withdrawImpl = Proposal.transferInstructionV1_withdrawImpl this
      transferInstruction_updateImpl _ _ = fail "Transfers representing governance lock transfers cannot be updated"

    interface instance V2.TransferInstruction for GovernanceLockTransfer where
      view = Proposal.transferInstructionViewV2 receiver this
      transferInstruction_acceptImpl = Proposal.transferInstructionV2_acceptImpl this
      transferInstruction_rejectImpl = Proposal.transferInstructionV2_rejectImpl this
      transferInstruction_withdrawImpl = Proposal.transferInstructionV2_withdrawImpl this
      transferInstruction_acceptExtraObservers _ = observer this
      transferInstruction_rejectExtraObservers _ = observer this
      transferInstruction_withdrawExtraObservers _ = observer this

    choice GovernanceLockTransfer_DsoExpire : GovernanceLockTransfer_DsoExpireResult
      -- ^ Garbage-collect a proposal that was never accepted, so SV nodes are not left storing it forever.
      controller source.dso
      do
        assertDeadlineExceeded "GovernanceLockTransfer.expiresAt" expiresAt
        pure GovernanceLockTransfer_DsoExpireResult

data GovernanceLockTransfer_DsoExpireResult = GovernanceLockTransfer_DsoExpireResult {}
  deriving (Serializable)

-- | Invariants of lock transfer proposals.
-- To be used in the `GovernanceLockTransfer` template and in `governanceLock_proposeTransfer` to check invariants on creation.
validateGovernanceLockTransfer : CanAssert m => GovernanceLockTransfer -> m ()
validateGovernanceLockTransfer transfer@GovernanceLockTransfer{..} = do
  require' ("receiver", receiver) (notR isEqualR) ("lock owner", source.owner)
  require' ("amount", amount) isGreaterR ("zero", 0.0)
  require "non-empty proposers" (not $ null $ governanceLockTransferProposers transfer)
  require' ("source owner", source.owner) isMemberR ("proposers", governanceLockTransferProposers transfer)
  validateNewGovernanceLockControllers source.specification newControllers
  case source.specification of
    GLS_FullLock _ -> pure ()
    GLS_VestingLock v -> require' ("expiresAt", expiresAt) isLessOrEqualR ("vesting end time", v.endTime)

governanceLockTransferControllers : GovernanceLockTransfer -> ControllersSpecification
governanceLockTransferControllers GovernanceLockTransfer{source, receiver} =
  let optControllers = case source.specification of
        GLS_FullLock spec -> spec.controllers >>= (.substitutionControllers)
        GLS_VestingLock spec -> spec.vestingControllers
      controllerSets = optional [[]] (.controllers) optControllers
  in makeControllersSpecification $ fmap (\s -> source.owner :: receiver :: s) controllerSets

governanceLockTransferProposers : GovernanceLockTransfer -> [Party]
governanceLockTransferProposers transfer = fromOptional [transfer.source.owner] transfer.proposers

governanceLockTransferVotes : GovernanceLockTransfer -> Proposal.ProposalVotes
governanceLockTransferVotes transfer =
  -- Transfers created before custom controllers were added will have `votes = None`.
  -- In this case we must provide the proposers' acceptance, the same way it's provided on newly created transfers,
  -- otherwise a pre-existing transfer is stuck and can never be approved.
  fromOptional (Map.fromList $ fmap (, Proposal.PV_Accept) (governanceLockTransferProposers transfer)) transfer.votes

governanceLockTransferMetadata : GovernanceLockTransfer -> Metadata
governanceLockTransferMetadata GovernanceLockTransfer{..} =
  encodeGovernanceLockMetadataWithRequest'
    (<> encodeGovernanceLockNewCustomControllersMemoEntries newControllers)
    "accept-to-transfer-lock"
    source.specification

data GovernanceLock_TransferResult_Completed = GovernanceLock_TransferResult_Completed with
  lockCid : ContractId GovernanceLock
    -- ^ The new lock of the receiver, which holds the transferred funds.
  remainingLockCid : Optional (ContractId GovernanceLock)
    -- ^ The lock of the sender that keeps the funds that were not transferred, if any.
  lockedAmulet : ContractId LockedAmulet
    -- ^ The transferred funds, now locked for the owner of the new lock.

governanceLock_transferResult_completedToTransferInstructionResult : GovernanceLock_TransferResult_Completed -> V2.TransferInstructionResult
governanceLock_transferResult_completedToTransferInstructionResult _ =
  V2.TransferInstructionResult with
    output = V2.TransferInstructionResult_Completed with receiverHoldingCids = []
    senderChangeCids = []
    meta = emptyMetadata

data GovernanceLockProposeTransferArgs = GovernanceLockProposeTransferArgs with
  source : GovernanceLockKey
  proposers : [Party]
  receiver : Party
  newControllers : Optional GovernanceLockControllers
  amount : Decimal
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text
  requestedAt : Time

governanceLock_proposeTransfer : GovernanceLockProposeTransferArgs -> Update (Proposal.ProposalUpdateResult GovernanceLockTransfer GovernanceLock_TransferResult_Completed)
governanceLock_proposeTransfer GovernanceLockProposeTransferArgs{..} = do
  let maxExpiresAt = requestedAt `addRelTime` getTokenStandardMaxTTL state.transferConfig
  expiresAt <- case source.specification of
    GLS_FullLock _ -> pure maxExpiresAt
    GLS_VestingLock VestingLockSpecification{endTime} -> do
      assertWithinDeadline "source lock endTime" endTime
      pure $ min maxExpiresAt endTime

  assertInPast24Hours "requestedAt" requestedAt

  let sortedProposers = List.dedupSort proposers
      transfer = GovernanceLockTransfer with
        source
        proposers = Some sortedProposers
        receiver
        newControllers
        amount
        votes = Some Map.empty
        requestedAt
        expiresAt
        originalProposalCid = None

  validateGovernanceLockTransfer transfer

  Proposal.create Proposal.ProposalUpdateArgs with
    proposalCid = None
    proposal = transfer
    actors = sortedProposers
    reason
    getContext = pure (context, state)

governanceLock_executeTransfer : Proposal.ProposalExecuteArgs GovernanceLockTransfer -> Update GovernanceLock_TransferResult_Completed
governanceLock_executeTransfer Proposal.ProposalExecuteArgs{..} = do
  let GovernanceLockTransfer{..} = proposal
      lock = merged.lock
  result <- exercise merged.lockCid GovernanceLock_DsoTransfer with
    transferredAmount = amount
    reason
    context
    state
  -- Lock the unlocked funds of the sender again, now for the receiver.
  -- This needs the authority of the receiver.
  ([newLockedAmulet], None) <- lockAmuletFor
    (ForOwner with dso = lock.dso; owner = lock.owner)
    receiver
    [(amount, governanceLockExpiresAt lock.specification)]
    [toInterfaceContractId result.unlockedAmulet]
    context
    reason
  newLockCid <- create GovernanceLock with
    dso = lock.dso
    owner = receiver
    amount
    lockedAmulet = newLockedAmulet
    specification = setNewGovernanceLockControllers lock.specification newControllers
    originalLockCid = toAnyContractId <$> optional proposalCid Some originalProposalCid
    requestedAt
  pure GovernanceLock_TransferResult_Completed with
    lockCid = newLockCid
    remainingLockCid = result.remainingLockCid
    lockedAmulet = newLockedAmulet

-- Instances
------------

instance HasCheckedFetch GovernanceLockTransfer ForDso where
  contractGroupId GovernanceLockTransfer{..} = ForDso with dso = source.dso

instance Proposal.ProposalOperations GovernanceLockTransfer GovernanceLock_TransferResult_Completed where
  mkProposalView proposal@GovernanceLockTransfer{..} = Proposal.ProposalView with
    lockKey = source
    sender = source.owner
    proposers = governanceLockTransferProposers proposal
    controllers = governanceLockTransferControllers proposal
    votes = governanceLockTransferVotes proposal
    amount
    lockedAmulet = None
    requestedAt
    expiresAt
    originalProposalCid
    meta = governanceLockTransferMetadata proposal

  recreateProposal votes originalProposalCid proposal =
    let updatedProposal = proposal with votes = Some votes; originalProposalCid
    in (, updatedProposal) <$> create updatedProposal

  executeProposal = governanceLock_executeTransfer
  mkCompletedProposalResult = governanceLock_transferResult_completedToTransferInstructionResult

  rejectProposal = Proposal.defaultRejectProposal
