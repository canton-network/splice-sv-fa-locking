module Splice.GovernanceLock.Transfer (
  -- * Templates and choices
  GovernanceLockTransfer(..),
  GovernanceLockTransfer_DsoExpire(..),
  GovernanceLockTransfer_DsoExpireResult(..),

  -- * State and operations
  governanceLockTransferMetadata,
  GovernanceLockProposeTransferArgs(..),
  governanceLock_proposeTransfer,
  governanceLockTransfer_operations,
) where

import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.Map qualified as Map
import DA.Optional
import DA.Set qualified as Set
import DA.Time

import Splice.Amulet
import Splice.AmuletConfig (getTokenStandardMaxTTL)
import Splice.AmuletRules
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.ExternalPartyConfigState
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.GovernanceLock.Proposal
import Splice.TokenStandard.Utils hiding (require)
import Splice.Types
import Splice.Util

template GovernanceLockTransfer with
    source : GovernanceLockKey
      -- ^ Source locks to be transferred. Locks are resolved by key.
    receiver : Party
      -- ^ New owner, who accepts the transfer.
    amount : Decimal
      -- ^ Amount moved out of the source locks.
    requestedAt : Time
      -- ^ When the sender requested the transfer.
    expiresAt : Time
      -- ^ When the transfer proposal expires.
    newUnlockControllers : Optional ControllersSpecification
      -- ^ New custom unlock controllers of the transferred lock.
    newSubstitutionControllers : Optional ControllersSpecification
      -- ^ New custom substitution controllers of the transferred lock.
    newVestingControllers : Optional ControllersSpecification
      -- ^ New custom vesting controllers of the transferred lock.
    votes : Optional (Map.Map Party Bool)
      -- ^ Votes recorded so far.
    originalProposalCid : Optional (ContractId GovernanceLockTransfer)
  where
    signatory source.dso, source.owner,
              -- Make the receiver a signatory once they've approved the transfer
              -- This is necessary for `governanceLock_executeTransfer` to have the authority of the receiver when locking amulet
              optional [] (const [receiver]) (guard (Map.lookup receiver (fromOptional Map.empty votes) == Some True))
    observer receiver, (Set.fromList $ concat (governanceLockTransferControllers this).controllers)
    ensure governanceLockTransferIsValid this

    interface instance V1.TransferInstruction for GovernanceLockTransfer where
      view = proposal_transferInstructionViewV1 governanceLockTransfer_operations "transfer" receiver this
      transferInstruction_acceptImpl = proposal_transferInstructionV1_acceptImpl governanceLockTransfer_operations this [receiver]
      transferInstruction_rejectImpl = proposal_transferInstructionV1_rejectImpl governanceLockTransfer_operations this [receiver]
      transferInstruction_withdrawImpl = proposal_transferInstructionV1_withdrawImpl governanceLockTransfer_operations this [source.owner]
      transferInstruction_updateImpl _ _ = fail "Transfers representing governance lock transfers cannot be updated"

    interface instance V2.TransferInstruction for GovernanceLockTransfer where
      view = proposal_transferInstructionViewV2 governanceLockTransfer_operations this
      transferInstruction_acceptImpl = proposal_transferInstructionV2_acceptImpl governanceLockTransfer_operations this
      transferInstruction_rejectImpl = proposal_transferInstructionV2_rejectImpl governanceLockTransfer_operations this
      transferInstruction_withdrawImpl = proposal_transferInstructionV2_withdrawImpl governanceLockTransfer_operations this
      transferInstruction_acceptExtraObservers _ = observer this
      transferInstruction_rejectExtraObservers _ = observer this
      transferInstruction_withdrawExtraObservers _ = observer this

    choice GovernanceLockTransfer_DsoExpire : GovernanceLockTransfer_DsoExpireResult
      -- ^ Garbage-collect proposal that receiver never accepted, so SV nodes
      -- are not left storing it forever.
      controller source.dso
      do
        assertDeadlineExceeded "GovernanceLockTransfer.expiresAt" expiresAt
        pure GovernanceLockTransfer_DsoExpireResult

data GovernanceLockTransfer_DsoExpireResult = GovernanceLockTransfer_DsoExpireResult {}
  deriving (Serializable)

-- | Invariants of lock transfer proposals.
-- To be used in the `GovernanceLockTransfer` template to `ensure` basic invariants on direct create.
-- `governanceLock_proposeTransfer` checks all of this with clearer messages.
governanceLockTransferIsValid : GovernanceLockTransfer -> Bool
governanceLockTransferIsValid GovernanceLockTransfer{..} =
  let validEndTime = case source.specification of
        GLS_FullLock _ -> True
        GLS_VestingLock v -> expiresAt <= v.endTime
  in amount > 0.0 && receiver /= source.owner && validEndTime
    && either error (const True) (validateNewGovernanceLockControllers source.specification newUnlockControllers newSubstitutionControllers newVestingControllers)

governanceLockTransfer_proposalView : GovernanceLockTransfer -> ProposalView GovernanceLockTransfer
governanceLockTransfer_proposalView proposal@GovernanceLockTransfer{..} = ProposalView with
  lockKey = source
  proposers = [source.owner]
  controllers = governanceLockTransferControllers proposal
  votes = fromOptional Map.empty votes
  amount
  lockedAmulet = None
  requestedAt
  expiresAt
  originalProposalCid
  meta = governanceLockTransferMetadata proposal

governanceLockTransferControllers : GovernanceLockTransfer -> ControllersSpecification
governanceLockTransferControllers GovernanceLockTransfer{source, receiver} =
  let optControllers = case source.specification of
        GLS_FullLock spec -> spec.substitutionControllers
        GLS_VestingLock spec -> spec.vestingControllers
      controllerSets = optional [[]] (.controllers) optControllers
  in makeControllersSpecification $ fmap (\s -> source.owner :: receiver :: s) controllerSets

governanceLockTransferMetadata : GovernanceLockTransfer -> Metadata
governanceLockTransferMetadata GovernanceLockTransfer{..} =
  encodeGovernanceLockMetadataWithRequest'
    (<> encodeGovernanceLockNewCustomControllersMetadataEntries newUnlockControllers newSubstitutionControllers newVestingControllers)
    "accept-to-transfer-lock"
    source.specification

data GovernanceLock_TransferResult_Completed = GovernanceLock_TransferResult_Completed with
  lockCid : ContractId GovernanceLock
    -- ^ The new lock of the receiver, which holds the transferred funds.
  remainingLockCid : Optional (ContractId GovernanceLock)
    -- ^ The lock of the sender that keeps the funds that were not transferred, if any.
  lockedAmulet : ContractId LockedAmulet
    -- ^ The transferred funds, now locked for the owner of the new lock.

type GovernanceLock_TransferResult = ProposalUpdateResult GovernanceLockTransfer GovernanceLock_TransferResult_Completed

governanceLock_transferResult_completed_transferInstructionResult : GovernanceLock_TransferResult_Completed -> V2.TransferInstructionResult
governanceLock_transferResult_completed_transferInstructionResult GovernanceLock_TransferResult_Completed{..} =
  V2.TransferInstructionResult with
    output = V2.TransferInstructionResult_Completed with receiverHoldingCids = []
    senderChangeCids = []
    meta = emptyMetadata

data GovernanceLockProposeTransferArgs = GovernanceLockProposeTransferArgs with
  source : GovernanceLockKey
  receiver : Party
  newUnlockControllers : Optional ControllersSpecification
  newSubstitutionControllers : Optional ControllersSpecification
  newVestingControllers : Optional ControllersSpecification
  amount : Decimal
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text
  requestedAt : Time

governanceLock_proposeTransfer : GovernanceLockProposeTransferArgs -> Update GovernanceLock_TransferResult
governanceLock_proposeTransfer GovernanceLockProposeTransferArgs{..} = do
  let maxExpiresAt = requestedAt `addRelTime` getTokenStandardMaxTTL state.transferConfig
  expiresAt <- case source.specification of
    GLS_FullLock _ -> pure maxExpiresAt
    GLS_VestingLock VestingLockSpecification{endTime} -> do
      assertWithinDeadline "source lock endTime" endTime
      pure $ min maxExpiresAt endTime

  assertInPast24Hours "requestedAt" requestedAt
  require' ("receiver", receiver) (notR isEqualR) ("sender", source.owner)
  require' ("amount", amount) isGreaterR ("zero", 0.0)
  case source.specification of
    GLS_FullLock _ -> pure ()
    GLS_VestingLock VestingLockSpecification{endTime} -> require' ("expiresAt", expiresAt) isLessOrEqualR ("vesting endTime", endTime)

  validateNewGovernanceLockControllers source.specification newUnlockControllers newSubstitutionControllers newVestingControllers

  proposal_create governanceLockTransfer_operations ProposalUpdateArgs with
    proposalCid = None
    proposal = GovernanceLockTransfer with
      source
      receiver
      newUnlockControllers
      newSubstitutionControllers
      newVestingControllers
      amount
      votes = Some Map.empty
      requestedAt
      expiresAt
      originalProposalCid = None
    actors = [source.owner]
    reason
    getContext = pure (context, state)

governanceLock_executeTransfer : ProposalExecuteArgs GovernanceLockTransfer -> Update GovernanceLock_TransferResult_Completed
governanceLock_executeTransfer ProposalExecuteArgs{..} = do
  let GovernanceLockTransfer{..} = proposal
  let lock = merged.lock
  result <- governanceLock_dsoTransferImpl merged amount reason context state
  -- Lock the unlocked funds of the sender again, now for the receiver.
  -- This needs the authority of the receiver.
  ([newLockedAmulet], None) <- lockAmuletFor
    (ForOwner with dso = lock.dso; owner = lock.owner)
    receiver
    [(amount, governanceLockExpiresAt lock.specification)]
    [toInterfaceContractId result.unlockedAmulet]
    context
    reason
  newLockCid <- create GovernanceLock with
    dso = lock.dso
    owner = receiver
    amount
    lockedAmulet = newLockedAmulet
    specification = setNewGovernanceLockControllers lock.specification newUnlockControllers newSubstitutionControllers newVestingControllers
    originalLockCid = toAnyContractId <$> proposalCid
    requestedAt
  pure GovernanceLock_TransferResult_Completed with
    lockCid = newLockCid
    remainingLockCid = result.remainingLockCid
    lockedAmulet = newLockedAmulet

governanceLockTransfer_operations : ProposalOperations GovernanceLockTransfer GovernanceLock_TransferResult_Completed
governanceLockTransfer_operations = ProposalOperations with
  makeView = governanceLockTransfer_proposalView
  recreate = \votes originalProposalCid proposal ->
    let updatedProposal = proposal with votes = Some votes; originalProposalCid
    in (, updatedProposal) <$> create updatedProposal
  execute = governanceLock_executeTransfer
  completedResult = governanceLock_transferResult_completed_transferInstructionResult
  rejectedResult = None

-- Instances
------------

instance HasCheckedFetch GovernanceLockTransfer ForDso where
  contractGroupId GovernanceLockTransfer{..} = ForDso with dso = source.dso
