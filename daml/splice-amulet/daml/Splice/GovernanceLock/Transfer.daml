module Splice.GovernanceLock.Transfer (
  -- * Templates and choices
  GovernanceLockTransfer(..),
  GovernanceLockTransfer_DsoExpire(..),
  GovernanceLockTransfer_DsoExpireResult(..),

  -- * State and operations
  governanceLockTransferMetadata,
  GovernanceLock_TransferResult(..),
  governanceLock_transferResult_transferInstructionResult,
  GovernanceLockProposeTransferArgs(..),
  governanceLock_proposeTransfer,
) where

import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.List qualified as List
import DA.Map qualified as Map
import DA.Optional
import DA.Set qualified as Set
import DA.Time

import Splice.Amulet
import Splice.Amulet.TokenApiUtils
import Splice.AmuletConfig (getTokenStandardMaxTTL)
import Splice.AmuletRules
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.ExternalPartyConfigState
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.TokenStandard.Utils
import Splice.Types
import Splice.Util

template GovernanceLockTransfer with
    source : GovernanceLockKey
      -- ^ Source locks to be transferred. Locks are resolved by key.
    receiver : Party
      -- ^ New owner, who accepts the transfer.
    -- TODO: support new custom controllers specified by receiver
    amount : Decimal
      -- ^ Amount moved out of the source locks.
    approvals : Optional (Map.Map Party Bool)
      -- ^ Approvals recorded so far.
    requestedAt : Time
      -- ^ When the sender requested the transfer.
    expiresAt : Time
      -- ^ When the transfer proposal expires.
    originalProposalCid : Optional (ContractId GovernanceLockTransfer)
  where
    signatory source.dso, source.owner,
              -- Make the receiver a signatory once they've approved the transfer
              -- This is necessary for `governanceLock_executeTransfer` to have the authority of the receiver when locking amulet
              optional [] (const [receiver]) (guard (Map.lookup receiver (governanceLockTransferApprovals this) == Some True))
    observer receiver, (Set.fromList $ concat (governanceLockTransferControllers this).controllers)
    ensure governanceLockTransferIsValid this

    interface instance V1.TransferInstruction for GovernanceLockTransfer where
      view = V1.TransferInstructionView with
        originalInstructionCid = toInterfaceContractId <$> originalProposalCid
        transfer = V1.Transfer with
          sender = source.owner
          receiver
          amount
          instrumentId = amuletInstrumentId source.dso
          requestedAt
          executeBefore = expiresAt
          inputHoldingCids = []
          meta = governanceLockTransferMetadata source.specification
        status = V1.TransferPendingInternalWorkflow with
          pendingActions =
            let (controllers, reqApprovals) = governanceLockTransferData this
                pendingControllers = List.dedupSort $ concat (controllersPendingApproval reqApprovals controllers).controllers
            in Map.fromListWithR (\x y -> x <> "; " <> y) $
              fmap (, "accept transfer") pendingControllers <>
              fmap (, "reject transfer") pendingControllers <>
              fmap (, "withdraw transfer") [source.owner]
        meta = emptyMetadata

      transferInstruction_acceptImpl self V1.TransferInstruction_Accept{..} = do
        downcast <$> governanceLockTransfer_accept (fromInterfaceContractId self) this [receiver] extraArgs

      transferInstruction_rejectImpl self V1.TransferInstruction_Reject{..} = do
        downcast <$> governanceLockTransfer_reject (fromInterfaceContractId self) this [receiver] extraArgs

      transferInstruction_withdrawImpl self V1.TransferInstruction_Withdraw{..} = do
        downcast <$> governanceLockTransfer_withdraw (fromInterfaceContractId self) this [source.owner] extraArgs

      transferInstruction_updateImpl _ _ = fail "Transfers representing governance lock transfers cannot be updated"

    interface instance V2.TransferInstruction for GovernanceLockTransfer where
      view =
        let v1View = view @V1.TransferInstruction (toInterface this)
        in V2.TransferInstructionView with
          originalInstructionCid = toInterfaceContractId <$> originalProposalCid
          transfer = upcast v1View.transfer
          expiresAt = Some expiresAt
          availableActions =
            let (controllers, reqApprovals) = governanceLockTransferData this
                pendingControllers = (controllersPendingApproval reqApprovals controllers).controllers
            in Map.fromList [(V2.TIA_Accept, pendingControllers), (V2.TIA_Reject, pendingControllers), (V2.TIA_Withdraw, [[source.owner]])]
          meta = emptyMetadata

      transferInstruction_acceptImpl self V2.TransferInstruction_Accept{..} = do
        -- V2.TransferInstruction_Accept is nonconsuming so we need to archive explicitly here
        -- governanceLockTransfer_update creates a new proposal when necessary
        potentiallyUnsafeArchive self
        governanceLockTransfer_accept (fromInterfaceContractId self) this actors extraArgs

      transferInstruction_rejectImpl self V2.TransferInstruction_Reject{..} = do
        -- V2.TransferInstruction_Reject is nonconsuming so we need to archive explicitly here
        -- governanceLockTransfer_update creates a new proposal when necessary
        potentiallyUnsafeArchive self
        governanceLockTransfer_reject (fromInterfaceContractId self) this actors extraArgs

      transferInstruction_withdrawImpl self V2.TransferInstruction_Withdraw{..} = do
        -- V2.TransferInstruction_Withdraw is nonconsuming so we need to archive explicitly here
        -- governanceLockTransfer_update creates a new proposal when necessary
        potentiallyUnsafeArchive self
        governanceLockTransfer_withdraw (fromInterfaceContractId self) this actors extraArgs

      transferInstruction_acceptExtraObservers _ = observer this
      transferInstruction_rejectExtraObservers _ = observer this
      transferInstruction_withdrawExtraObservers _ = observer this

    choice GovernanceLockTransfer_DsoExpire : GovernanceLockTransfer_DsoExpireResult
      -- ^ Garbage-collect proposal that receiver never accepted, so SV nodes
      -- are not left storing it forever.
      controller source.dso
      do
        assertDeadlineExceeded "GovernanceLockTransfer.expiresAt" expiresAt
        pure GovernanceLockTransfer_DsoExpireResult

data GovernanceLockTransfer_DsoExpireResult = GovernanceLockTransfer_DsoExpireResult {}
  deriving (Serializable)

-- | Invariants of lock transfer proposals.
-- To be used in the `GovernanceLockTransfer` template to `ensure` basic invariants on direct create.
-- `governanceLock_proposeTransfer` checks all of this with clearer messages.
governanceLockTransferIsValid : GovernanceLockTransfer -> Bool
governanceLockTransferIsValid GovernanceLockTransfer{..} =
  let validEndTime = case source.specification of
        GLS_FullLock _ -> True
        GLS_VestingLock v -> expiresAt <= v.endTime
  in amount > 0.0 && receiver /= source.owner && validEndTime

governanceLockTransferControllers : GovernanceLockTransfer -> ControllersSpecification
governanceLockTransferControllers GovernanceLockTransfer{source, receiver} =
  let optControllers = case source.specification of
        GLS_FullLock spec -> spec.substitutionControllers
        GLS_VestingLock spec -> spec.vestingControllers
      controllerSets = optional [[]] (.controllers) optControllers
  in makeControllersSpecification $ fmap (\s -> source.owner :: receiver :: s) controllerSets

governanceLockTransferApprovals : GovernanceLockTransfer -> Map.Map Party Bool
governanceLockTransferApprovals GovernanceLockTransfer{approvals} = fromOptional Map.empty approvals

governanceLockTransferData : GovernanceLockTransfer -> (ControllersSpecification, Map.Map Party Bool)
governanceLockTransferData proposal = (governanceLockTransferControllers proposal, governanceLockTransferApprovals proposal)

governanceLockTransferMetadata : GovernanceLockSpecification -> Metadata
governanceLockTransferMetadata = encodeGovernanceLockMetadataWithRequest "accept-to-transfer-lock"

data GovernanceLock_TransferResult
  = GovernanceLock_TransferResult_Pending with
      pendingProposalCid : ContractId GovernanceLockTransfer
      pendingProposal : GovernanceLockTransfer
  | GovernanceLock_TransferResult_Completed with
      lockCid : ContractId GovernanceLock
        -- ^ The new lock of the receiver, which holds the transferred funds.
      remainingLockCid : Optional (ContractId GovernanceLock)
        -- ^ The lock of the sender that keeps the funds that were not transferred, if any.
      lockedAmulet : ContractId LockedAmulet
        -- ^ The transferred funds, now locked for the owner of the new lock.

governanceLock_transferResult_transferInstructionResult : GovernanceLock_TransferResult -> V2.TransferInstructionResult
governanceLock_transferResult_transferInstructionResult result =
  V2.TransferInstructionResult with
    output = case result of
      GovernanceLock_TransferResult_Pending{..} ->
        V2.TransferInstructionResult_Pending with transferInstructionCid = toInterfaceContractId pendingProposalCid
      GovernanceLock_TransferResult_Completed{} ->
        V2.TransferInstructionResult_Completed with receiverHoldingCids = []
    senderChangeCids = []
    meta = emptyMetadata

data GovernanceLockProposeTransferArgs = GovernanceLockProposeTransferArgs with
  source : GovernanceLockKey
  receiver : Party
  amount : Decimal
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text
  requestedAt : Time

governanceLock_proposeTransfer : GovernanceLockProposeTransferArgs -> Update GovernanceLock_TransferResult
governanceLock_proposeTransfer GovernanceLockProposeTransferArgs{..} = do
  let emptyApprovals = Map.empty
      maxExpiresAt = requestedAt `addRelTime` getTokenStandardMaxTTL state.transferConfig
  expiresAt <- case source.specification of
    GLS_FullLock _ -> pure maxExpiresAt
    GLS_VestingLock VestingLockSpecification{endTime} -> do
      assertWithinDeadline "source lock endTime" endTime
      pure $ min maxExpiresAt endTime

  assertInPast24Hours "requestedAt" requestedAt
  require' ("receiver", receiver) (notR isEqualR) ("sender", source.owner)
  require' ("amount", amount) isGreaterR ("zero", 0.0)
  case source.specification of
    GLS_FullLock _ -> pure ()
    GLS_VestingLock VestingLockSpecification{endTime} -> require' ("expiresAt", expiresAt) isLessOrEqualR ("vesting endTime", endTime)

  let proposal = GovernanceLockTransfer with
        source
        receiver
        amount
        approvals = Some emptyApprovals
        requestedAt
        expiresAt
        originalProposalCid = None
      updateArgs = GovernanceLockTransferUpdateArgs with
        proposalCid = None
        proposal
        actors = [source.owner]
        reason
        getContext = pure (context, state)

  -- A rejected proposal is unexpected here
  --
  -- The proposal should either be accepted, if `actors` is a superset of one of the controller sets,
  -- or pending, if `actors` is a subset of one of the controller sets.
  --
  -- A rejected proposal means that `actors` is not in any of the controller sets, which we assert against above
  governanceLockTransfer_update' identity (\rejectors -> fail ("Unexpected proposal rejection by rejectors: " <> show rejectors)) updateArgs True

data GovernanceLockExecuteTransferArgs = GovernanceLockExecuteTransferArgs with
  merged : FetchAndMergeLocksResult
  proposalCid : Optional (ContractId GovernanceLockTransfer)
  proposal : GovernanceLockTransfer
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text

governanceLock_executeTransfer : GovernanceLockExecuteTransferArgs -> Update GovernanceLock_TransferResult
governanceLock_executeTransfer GovernanceLockExecuteTransferArgs{..} = do
  assertWithinDeadline "expiresAt" proposal.expiresAt
  let lock = merged.lock
      reason = reasonFromMeta $ governanceLockTransferMetadata lock.specification
  result <- governanceLock_dsoTransferImpl merged proposal.amount reason context state
  -- Lock the unlocked funds of the sender again, now for the receiver.
  -- This needs the authority of the receiver.
  ([newLockedAmulet], None) <- lockAmuletFor
    (ForOwner with dso = lock.dso; owner = lock.owner)
    proposal.receiver
    [(proposal.amount, governanceLockExpiresAt lock.specification)]
    [toInterfaceContractId result.unlockedAmulet]
    context
    reason
  newLockCid <- create GovernanceLock with
    dso = lock.dso
    owner = proposal.receiver
    amount = proposal.amount
    lockedAmulet = newLockedAmulet
    specification = lock.specification
    originalLockCid = toAnyContractId <$> proposalCid
    requestedAt = proposal.requestedAt
  pure GovernanceLock_TransferResult_Completed with
    lockCid = newLockCid
    remainingLockCid = result.remainingLockCid
    lockedAmulet = newLockedAmulet

data GovernanceLockTransferUpdateArgs = GovernanceLockTransferUpdateArgs with
  proposalCid : Optional (ContractId GovernanceLockTransfer)
  proposal : GovernanceLockTransfer
  actors : [Party]
  reason : Text
  getContext : Update (ExternalPartyTransferContext, ExternalPartyConfigState)

makeGovernanceLockTransferUpdateArgs : ContractId GovernanceLockTransfer -> GovernanceLockTransfer -> [Party] -> ExtraArgs -> GovernanceLockTransferUpdateArgs
makeGovernanceLockTransferUpdateArgs proposalCid proposal@GovernanceLockTransfer{..} actors extraArgs =
  GovernanceLockTransferUpdateArgs with
    proposalCid = Some proposalCid
    proposal
    actors
    reason = reasonFromMeta $ governanceLockTransferMetadata source.specification
    getContext = unfeaturedPaymentContextAndConfigFromChoiceContext source.dso extraArgs.context

governanceLockTransfer_update'
  :  (GovernanceLock_TransferResult -> a)
  -> ([Party] -> Update a)
  -> GovernanceLockTransferUpdateArgs
  -> Bool
  -> Update a
governanceLockTransfer_update' onPendingOrAccepted onRejected GovernanceLockTransferUpdateArgs{..} approved = do
  let (controllers, approvals) = governanceLockTransferData proposal
  result <- updateProposalApprovals controllers [proposal.source.owner] approved actors approvals
  case result of
    PAR_Pending{pendingApprovals} -> do
      let updatedProposal = proposal with
            approvals = Some pendingApprovals
            originalProposalCid = optional proposalCid Some proposal.originalProposalCid
      updatedProposalCid <- create updatedProposal
      pure $ onPendingOrAccepted GovernanceLock_TransferResult_Pending with
        pendingProposalCid = updatedProposalCid
        pendingProposal = updatedProposal

    PAR_Accepted{} -> do
      (context, state) <- getContext
      merged <- fetchAndMergeGovernanceLocks proposal.source context state reason
      onPendingOrAccepted <$> governanceLock_executeTransfer GovernanceLockExecuteTransferArgs with
        merged
        proposalCid
        proposal
        context
        state
        reason

    PAR_Rejected{rejectors} -> onRejected rejectors

governanceLockTransfer_update : GovernanceLockTransferUpdateArgs -> Bool -> Update V2.TransferInstructionResult
governanceLockTransfer_update =
  governanceLockTransfer_update' governanceLock_transferResult_transferInstructionResult \_ -> pure V2.TransferInstructionResult with
    output = V2.TransferInstructionResult_Failed
    senderChangeCids = []
    meta = emptyMetadata

governanceLockTransfer_accept : ContractId GovernanceLockTransfer -> GovernanceLockTransfer -> [Party] -> ExtraArgs -> Update V2.TransferInstructionResult
governanceLockTransfer_accept proposalCid proposal actors extraArgs = do
  let (controllers, approvals) = governanceLockTransferData proposal
  checkPendingControllers controllers actors approvals
  governanceLockTransfer_update (makeGovernanceLockTransferUpdateArgs proposalCid proposal actors extraArgs) True

governanceLockTransfer_reject : ContractId GovernanceLockTransfer -> GovernanceLockTransfer -> [Party] -> ExtraArgs -> Update V2.TransferInstructionResult
governanceLockTransfer_reject proposalCid proposal actors extraArgs = do
  let (controllers, approvals) = governanceLockTransferData proposal
  checkPendingControllers controllers actors approvals
  governanceLockTransfer_update (makeGovernanceLockTransferUpdateArgs proposalCid proposal actors extraArgs) False

governanceLockTransfer_withdraw : ContractId GovernanceLockTransfer -> GovernanceLockTransfer -> [Party] -> ExtraArgs -> Update V2.TransferInstructionResult
governanceLockTransfer_withdraw proposalCid proposal actors extraArgs = do
  checkActors actors [[proposal.source.owner]]
  governanceLockTransfer_update (makeGovernanceLockTransferUpdateArgs proposalCid proposal actors extraArgs) False

-- Instances
------------

instance HasCheckedFetch GovernanceLockTransfer ForDso where
  contractGroupId GovernanceLockTransfer{..} = ForDso with dso = source.dso
