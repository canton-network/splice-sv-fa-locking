module Splice.GovernanceLock.Unlock (
  GovernanceLock_UnlockResult(..),
  governanceLock_unlockResult_transferInstructionResult,
  GovernanceLockProposeUnlockArgs(..),
  governanceLock_proposeUnlock,
) where

import Prelude hiding (forA)
import DA.Action (unless)
import DA.Assert (assertDeadlineExceeded)
import DA.Functor (($>))
import DA.List qualified as List
import DA.Map qualified as Map
import DA.Optional
import DA.Set qualified as Set
import DA.Time
import DA.Traversable (forA)

import Splice.Amulet
import Splice.Amulet.TokenApiUtils
import Splice.AmuletConfig (getTokenStandardMaxTTL)
import Splice.AmuletRules
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.ExternalPartyConfigState
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.TokenStandard.Utils hiding (require, reasonMetaKey)
import Splice.Types
import Splice.Util

data UnlockProposalSpecification = UnlockProposalSpecification with
    target : GovernanceLockKey
    amount : Decimal -- ^ Amount being unlocked.
    -- TODO: add release notes to mention departure from CIP; we're not accepting a vestingStartTime from each approver
    vestingStartTime : Time -- ^ Time at which vesting is proposed to start.
  deriving (Eq, Show, Serializable)

template UnlockProposal
  with
    specification : UnlockProposalSpecification
    proposers : [Party]
    lockedAmulet : ContractId LockedAmulet
    approvals : Map.Map Party Bool -- ^ Approvals recorded so far.
    requestedAt : Time -- ^ Time of the request to create the proposal.
    expiresAt : Time -- ^ Time after which the DSO party may withdraw the proposal.
    originalProposalCid : Optional (ContractId UnlockProposal)
      -- ^ Contract id of the first proposal of this workflow. `None` for the first proposal itself.
  where
    signatory specification.target.dso, proposers
    -- TODO: should this include `governanceLockObservers specification.target.specification`?
    observer specification.target.owner, (Set.fromList $ concat (unlockProposalControllers specification).controllers)
    ensure specification.amount > 0.0 && (not $ null proposers) && either error (const True) (requireFullLock specification.target.specification)

    choice UnlockProposal_DsoExpire : UnlockProposal_DsoExpireResult
      controller specification.target.dso
      do
        assertDeadlineExceeded "expiresAt" expiresAt
        pure UnlockProposal_DsoExpireResult

    interface instance V1.TransferInstruction for UnlockProposal where
      view = V1.TransferInstructionView with
        originalInstructionCid = toInterfaceContractId <$> originalProposalCid
        transfer = V1.Transfer with
          sender = List.head proposers
          receiver = lockManagerParty
          amount = specification.amount
          instrumentId = amuletInstrumentId specification.target.dso
          requestedAt
          executeBefore = expiresAt
          inputHoldingCids = [toInterfaceContractId lockedAmulet]
          meta = unlockProposalMetadata specification.target.specification
        status = V1.TransferPendingInternalWorkflow with
          pendingActions =
            let pendingControllers = List.dedupSort $ concat (controllersPendingApproval approvals $ unlockProposalControllers specification).controllers
                pendingProposers = filter (\p -> not $ Map.member p approvals) proposers
            in Map.fromListWithR (\x y -> x <> "; " <> y) $
              fmap (, "accept unlock") pendingControllers <>
              fmap (, "reject unlock") pendingControllers <>
              fmap (, "withdraw unlock") pendingProposers
        meta = emptyMetadata

      transferInstruction_acceptImpl _ _ = fail "Transfers representing unlock proposals cannot be accepted through Token Standard v1"
      transferInstruction_rejectImpl _ _ = fail "Transfers representing unlock proposals cannot be rejected through Token Standard v1"
      transferInstruction_updateImpl _ _ = fail "Transfers representing unlock proposals cannot be updated"
      transferInstruction_withdrawImpl self V1.TransferInstruction_Withdraw{..} =
        downcast <$> unlockProposal_withdraw (fromInterfaceContractId self) this proposers extraArgs

    interface instance V2.TransferInstruction for UnlockProposal where
      view =
        let v1View = view @V1.TransferInstruction (toInterface this)
        in V2.TransferInstructionView with
          originalInstructionCid = toInterfaceContractId <$> originalProposalCid
          transfer = upcast v1View.transfer
          expiresAt = Some expiresAt
          availableActions =
            let pendingControllers = (controllersPendingApproval approvals $ unlockProposalControllers specification).controllers
                pendingProposers = filter (\p -> not $ Map.member p approvals) proposers
            in Map.fromList [(V2.TIA_Accept, pendingControllers), (V2.TIA_Reject, pendingControllers), (V2.TIA_Withdraw, [pendingProposers])]
          meta = emptyMetadata

      transferInstruction_acceptImpl self V2.TransferInstruction_Accept{..} = do
        -- V2.TransferInstruction_Accept is nonconsuming so we need to archive explicitly here
        -- unlockProposal_update will create a new proposal when necessary
        potentiallyUnsafeArchive self
        unlockProposal_approve (fromInterfaceContractId self) this actors extraArgs

      transferInstruction_rejectImpl self V2.TransferInstruction_Reject{..} = do
        -- V2.TransferInstruction_Reject is nonconsuming so we need to archive explicitly here
        -- unlockProposal_update will create a new proposal when necessary
        potentiallyUnsafeArchive self
        unlockProposal_reject (fromInterfaceContractId self) this actors extraArgs

      transferInstruction_withdrawImpl self V2.TransferInstruction_Withdraw{..} = do
        -- V2.TransferInstruction_Withdraw is nonconsuming so we need to archive explicitly here
        -- unlockProposal_update will create a new proposal when necessary
        potentiallyUnsafeArchive self
        unlockProposal_withdraw (fromInterfaceContractId self) this actors extraArgs

      transferInstruction_acceptExtraObservers _ = observer this
      transferInstruction_rejectExtraObservers _ = observer this
      transferInstruction_withdrawExtraObservers _ = observer this

data UnlockProposal_DsoExpireResult = UnlockProposal_DsoExpireResult {}
  deriving (Serializable)

unlockProposalControllers : UnlockProposalSpecification -> ControllersSpecification
unlockProposalControllers UnlockProposalSpecification{target} =
  makeControllersSpecification $ case requireFullLock @(Either Text) target.specification of
    Left _ -> [[target.owner]]
    Right spec -> optional [[target.owner]] (.controllers) spec.unlockControllers

unlockProposalMetadata : GovernanceLockSpecification -> Metadata
unlockProposalMetadata = encodeGovernanceLockMetadataWithRequest "accept-to-unlock-lock"

data GovernanceLock_UnlockResult
  = GovernanceLock_UnlockResult_Pending with
      pendingProposal : ContractId UnlockProposal
  | GovernanceLock_UnlockResult_Completed with
      vestingLock : Optional (ContractId GovernanceLock)
      governanceLock : Optional (ContractId GovernanceLock)
      unlockedAmulet : Optional (ContractId Amulet)

governanceLock_unlockResult_transferInstructionResult : GovernanceLock_UnlockResult -> V2.TransferInstructionResult
governanceLock_unlockResult_transferInstructionResult result =
  let
    (senderChangeCids, output) = case result of
      GovernanceLock_UnlockResult_Pending{..} ->
        ([], V2.TransferInstructionResult_Pending with transferInstructionCid = toInterfaceContractId pendingProposal)
      GovernanceLock_UnlockResult_Completed{..} ->
        (
          toInterfaceContractId <$> optionalToList unlockedAmulet,
          case vestingLock of
            Some v -> V2.TransferInstructionResult_Pending with transferInstructionCid = toInterfaceContractId v
            None -> V2.TransferInstructionResult_Completed with receiverHoldingCids = []
        )
  in V2.TransferInstructionResult with output; senderChangeCids; meta = emptyMetadata

data GovernanceLockProposeUnlockArgs = GovernanceLockProposeUnlockArgs with
  merged : FetchAndMergeLocksResult
  unlockAmount : Decimal
  optVestingStartTime : Optional Time
  actors : [Party]
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text
  requestedAt : Time

-- | Proposes to unlock `unlockAmount` of a governance lock. `optVestingStartTime` may only be `None` for locks that have no vesting period.
governanceLock_proposeUnlock : GovernanceLockProposeUnlockArgs -> Update GovernanceLock_UnlockResult
governanceLock_proposeUnlock GovernanceLockProposeUnlockArgs{..} = do
  assertInPast24Hours "requestedAt" requestedAt
  let lock = merged.lock
  fullSpec <- requireFullLock lock.specification

  let vestingPeriod = vestingDurationFor fullSpec.kind state.governanceLockConfig
      hasNoVestingPeriod = vestingPeriod == days 0
  vestingStartTime <- case (hasNoVestingPeriod, optVestingStartTime) of
        (True, _) -> pure $ fromOptional minBound optVestingStartTime
        (False, None) -> assertFail "Missing vestingStartTime"
        (False, Some vestingStartTime) -> do
          assertInNext24Hours "vestingStartTime" vestingStartTime
          pure vestingStartTime

  let specification = UnlockProposalSpecification with
        target = key lock
        amount = unlockAmount
        vestingStartTime
      proposers = List.dedupSort actors
      emptyApprovals = Map.empty

  checkPendingControllers (unlockProposalControllers specification) proposers emptyApprovals

  let updateArgs = UnlockProposalUpdateArgs with
        proposalCid = None
        proposal = UnlockProposal with
          specification
          proposers
          lockedAmulet = lock.lockedAmulet
          approvals = emptyApprovals
          requestedAt
          expiresAt = requestedAt `addRelTime` getTokenStandardMaxTTL state.transferConfig
          originalProposalCid = None
        actors = proposers
        context
        state
        reason

  -- A rejected proposal is unexpected here
  --
  -- The proposal should either be accepted, if `actors` is a superset of one of the controller sets,
  -- or pending, if `actors` is a subset of one of the controller sets.
  --
  -- A rejected proposal means that `actors` is not in any of the controller sets, which we assert against above
  unlockProposal_update' identity (\rejectors -> fail ("Unexpected proposal rejection by rejectors: " <> show rejectors)) updateArgs True

data GovernanceLockExecuteUnlockArgs = GovernanceLockExecuteUnlockArgs with
  merged : FetchAndMergeLocksResult
  unlockAmount : Decimal
  vestingStartTime : Time
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text

-- | Unlocks `unlockAmount` of a governance lock.
governanceLock_executeUnlock : GovernanceLockExecuteUnlockArgs -> Update GovernanceLock_UnlockResult
governanceLock_executeUnlock GovernanceLockExecuteUnlockArgs{..} = do
  let FetchAndMergeLocksResult{lockCid, lock} = merged
  potentiallyUnsafeArchive lockCid -- safe as the lock was checked when fetched/merged

  require' ("unlockAmount", unlockAmount) isLessOrEqualR ("amount", lock.amount)
  let isFullUnlock = unlockAmount == lock.amount
  require' ("unlockAmount", unlockAmount) isGreaterR ("zero", 0.0)
  unless isFullUnlock $ do
    requireMinimumLock state unlockAmount
    requireMinimumLock state (lock.amount - unlockAmount)

  fullSpec <- requireFullLock lock.specification
  let GovernanceLock{dso, owner, lockedAmulet, originalLockCid} = lock

  let vestingPeriod = vestingDurationFor fullSpec.kind state.governanceLockConfig
  let hasNoVestingPeriod = vestingPeriod == days 0
  let endTime = vestingStartTime `addRelTime` vestingPeriod
  let specification = GLS_VestingLock VestingLockSpecification with
        kind = fullSpec.kind
        vestingPeriod
        endTime
        vestingControllers = fullSpec.vestingControllers
  let forOwner = ForOwner with dso; owner

  (optVestingLockedAmulet, optStillLocked, unlockedAmulet) <- if hasNoVestingPeriod
    then do
      (optStillLocked, unlockedAmulet) <- partialUnlock forOwner lockedAmulet unlockAmount context reason
      pure (None, optStillLocked, Some unlockedAmulet)
    else do
      (optStillLocked, vestingLockedAmulet) <- splitLockedAmulet forOwner lockedAmulet (unlockAmount, endTime) context reason
      pure (Some vestingLockedAmulet, optStillLocked, None)

  governanceLock <- forA optStillLocked (\(lockedAmulet, stillLockedAmount) -> create
    lock with
      lockedAmulet
      amount = stillLockedAmount
      originalLockCid = Some $ fromOptional (toAnyContractId lockCid) originalLockCid)

  vestingLock <- forA optVestingLockedAmulet (\(lockedAmulet, amount) -> create GovernanceLock with
    dso
    owner
    lockedAmulet
    amount
    specification
    originalLockCid = guard isFullUnlock $> fromOptional (toAnyContractId lockCid) originalLockCid
    requestedAt = endTime `addRelTime` (- vestingPeriod))

  pure GovernanceLock_UnlockResult_Completed with
    vestingLock
    governanceLock
    unlockedAmulet

data UnlockProposalUpdateArgs = UnlockProposalUpdateArgs with
  proposalCid : Optional (ContractId UnlockProposal)
  proposal : UnlockProposal
  actors : [Party]
  context : ExternalPartyTransferContext
  state : ExternalPartyConfigState
  reason : Text

makeUnlockProposalUpdateArgs : ContractId UnlockProposal -> UnlockProposal -> [Party] -> ExtraArgs -> Update UnlockProposalUpdateArgs
makeUnlockProposalUpdateArgs proposalCid proposal@UnlockProposal{..} actors extraArgs = do
  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext specification.target.dso extraArgs.context
  pure UnlockProposalUpdateArgs with
    proposalCid = Some proposalCid
    proposal
    actors
    reason = reasonFromMeta $ unlockProposalMetadata specification.target.specification
    context
    state

unlockProposal_update'
  :  (GovernanceLock_UnlockResult -> a)
  -> ([Party] -> Update a)
  -> UnlockProposalUpdateArgs
  -> Bool
  -> Update a
unlockProposal_update' onPendingOrAccepted onRejected UnlockProposalUpdateArgs{..} approved = do
  result <- updateProposalApprovals (unlockProposalControllers proposal.specification) proposal.proposers approved actors proposal.approvals
  case result of
    PAR_Pending{pendingApprovals} ->
      onPendingOrAccepted . GovernanceLock_UnlockResult_Pending <$> create proposal with
        approvals = pendingApprovals
        originalProposalCid = optional proposalCid Some proposal.originalProposalCid

    PAR_Accepted{} -> do
      merged <- fetchAndMergeGovernanceLocks proposal.specification.target context state reason
      onPendingOrAccepted <$> governanceLock_executeUnlock GovernanceLockExecuteUnlockArgs with
        merged
        unlockAmount = proposal.specification.amount
        vestingStartTime = proposal.specification.vestingStartTime
        context
        state
        reason

    PAR_Rejected{rejectors} -> onRejected rejectors

unlockProposal_update : UnlockProposalUpdateArgs -> Bool -> Update V2.TransferInstructionResult
unlockProposal_update =
  unlockProposal_update' governanceLock_unlockResult_transferInstructionResult \_ -> pure V2.TransferInstructionResult with
    output = V2.TransferInstructionResult_Failed
    senderChangeCids = []
    meta = emptyMetadata

unlockProposal_approve : ContractId UnlockProposal -> UnlockProposal -> [Party] -> ExtraArgs -> Update V2.TransferInstructionResult
unlockProposal_approve proposalCid proposal@UnlockProposal{specification, approvals} actors extraArgs = do
  checkPendingControllers (unlockProposalControllers specification) actors approvals
  args <- makeUnlockProposalUpdateArgs proposalCid proposal actors extraArgs
  unlockProposal_update args True

unlockProposal_reject : ContractId UnlockProposal -> UnlockProposal -> [Party] -> ExtraArgs -> Update V2.TransferInstructionResult
unlockProposal_reject proposalCid proposal@UnlockProposal{specification, approvals} actors extraArgs = do
  checkPendingControllers (unlockProposalControllers specification) actors approvals
  args <- makeUnlockProposalUpdateArgs proposalCid proposal actors extraArgs
  unlockProposal_update args False

unlockProposal_withdraw : ContractId UnlockProposal -> UnlockProposal -> [Party] -> ExtraArgs -> Update V2.TransferInstructionResult
unlockProposal_withdraw proposalCid proposal@UnlockProposal{proposers} actors extraArgs = do
  require' ("actors", actors) isSubsetOfR ("proposers", proposers)
  args <- makeUnlockProposalUpdateArgs proposalCid proposal actors extraArgs
  unlockProposal_update args False
