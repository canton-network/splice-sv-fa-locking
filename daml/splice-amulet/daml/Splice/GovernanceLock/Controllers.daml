module Splice.GovernanceLock.Controllers (
  ControllersSpecification(..),
  validateControllersSpecification,
  allControllers,
  satisfiesAnyControllersSet,
  addControllersApprovals,
  removeControllersApprovals,
  controllersPendingApproval,
) where

import Prelude hiding (forA_)
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional
import DA.Set qualified as Set

import Splice.Util

data ControllersSpecification = ControllersSpecification with
    controllers : [[Party]]
      -- ^ Sets of parties that can jointly authorize an action. The action happens once all parties of any one set approve it.
  deriving (Eq, Show, Serializable)

instance Semigroup ControllersSpecification where
  (<>) (ControllersSpecification a) (ControllersSpecification b) = ControllersSpecification $ a <> b

validateControllersSpecification : CanAssert m => Text -> Optional ControllersSpecification -> m ()
validateControllersSpecification _ None = pure ()
validateControllersSpecification controllerType (Some ControllersSpecification{controllers}) = do
  require (controllerType <> "Controllers must not be empty") (not $ null controllers)
  require (controllerType <> "Controllers must not contain an empty controller set") (all (not . null) controllers)

allControllers : ControllersSpecification -> Set.Set Party
allControllers spec = Set.fromList $ concat spec.controllers

satisfiesAnyControllersSet : [Party] -> ControllersSpecification -> Bool
satisfiesAnyControllersSet actors controllers =
  let actorsSet = Set.fromList actors
  in any (\cs -> (Set.fromList cs) `Set.isSubsetOf` actorsSet) controllers.controllers

-- | Updates approvals to record the action taken by the given actors and checks if the
-- updated approvals satisfy one of the sets of controllers.
--
-- A set of controllers is considered satisfied when all of its parties have a
-- value within the updated approvals for which approvalIsValid holds true.
--
-- If any controller set is satisfied, the superset of all satisfied controller
-- sets, along with their approvals, is returned as an approved Right value.
--
-- If no controller sets are satisfied, the updated approvals map is returned as
-- a still-pending Left value.
updateControllersApprovals
  :  (CanAssert m, Eq a)
  => (Party -> Map.Map Party a -> Map.Map Party a)
  -> ControllersSpecification -- ^ The sets of controllers that can authorize the current action.
  -> [Party] -- ^ The set of actors that have authorized the current action.
  -> Map.Map Party a -- ^ The pre-existing set of pending approvals.
  -> m (Either (Map.Map Party a) [(Party, a)])
updateControllersApprovals update ControllersSpecification{controllers} actors approvals = do
  require "actors must not be empty" (not $ null actors)
  forA_ actors $ \actor ->
    require ("actor " <> partyToText actor <> " must be a controller") (any (actor `elem`) controllers)
  let updated = foldr update approvals actors
      approvedBy p = Map.member p updated
      satisfiedControllers = ControllersSpecification $ filter (all approvedBy) controllers
  require "at least one actor's approval must change" (approvals /= updated)
  pure $ if null satisfiedControllers.controllers
    then Left updated
    else Right $ mapOptional (\p -> (p,) <$> Map.lookup p updated) (concat satisfiedControllers.controllers)

addControllersApprovals
  :  (CanAssert m, Eq a)
  => ControllersSpecification -- ^ The sets of controllers that can authorize the current action.
  -> [Party] -- ^ The set of actors that have authorized the current action.
  -> a -- ^ The approval authorized by these actors.
  -> Map.Map Party a -- ^ The pre-existing set of pending approvals.
  -> m (Either (Map.Map Party a) [(Party, a)])
addControllersApprovals controllers actors approval approvals =
  updateControllersApprovals (\actor -> Map.insert actor approval) controllers actors approvals

removeControllersApprovals
  :  (CanAssert m, Eq a, Show a)
  => ControllersSpecification -- ^ The sets of controllers that can authorize the current action.
  -> [Party] -- ^ The set of actors that have authorized the current action.
  -> Map.Map Party a -- ^ The pre-existing set of pending approvals.
  -> m (Map.Map Party a)
removeControllersApprovals controllers actors approvals =
  updateControllersApprovals Map.delete controllers actors approvals >>= \case
    Left updated -> pure updated
    -- If removing the actors approvals yields a `Right approved` value it means there was a bug
    -- elsewhere since the `Right approved` should have been produced and processed earlier
    Right approved -> assertFail $ "Unexpected completed approvals: " <> show approved

controllersPendingApproval : Map.Map Party a -> ControllersSpecification -> ControllersSpecification
controllersPendingApproval approvals controllers =
  ControllersSpecification $ filter (not . null) $ fmap (filter (\p -> not $ Map.member p approvals)) controllers.controllers
