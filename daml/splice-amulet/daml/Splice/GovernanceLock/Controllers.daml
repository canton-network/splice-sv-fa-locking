module Splice.GovernanceLock.Controllers (
  ControllersSpecification,
  NewControllersSpecifications(..),
  makeControllersSpecification,
  validateControllersSpecification,
  encodeControllersSpecification,
  parseControllersSpecification,
  allControllers,
  controllersPendingVote,
  proposersPendingWithdrawal,
  checkPendingControllers,
) where

import DA.Map qualified as Map
import DA.Set qualified as Set

import Splice.TokenStandard.Utils
import Splice.Util.Json

-- | Specification of controllers that can jointly authorize an action.
-- Serializable so it can be encoded on templates, but should not be constructed directly; use ControllerSets.
data ControllersSpecification = ControllersSpecification with
    controllers : [[Party]]
      -- ^ Sets of parties that can jointly authorize an action. The action happens once all parties of any one set approve it.
  deriving (Eq, Show, Serializable)

data NewControllersSpecifications = NewControllersSpecifications with
    unlockControllers : Optional ControllersSpecification
      -- ^ Controllers that can unlock the lock.
    substitutionControllers : Optional ControllersSpecification
      -- ^ Controllers that can authorize a substitution.
    vestingControllers : Optional ControllersSpecification
      -- ^ Controllers that can control the disbursal of vesting funds via withdrawals, substitutions, or transfers.
  deriving (Eq, Show, Serializable)

-- | Sets of controllers that can jointly authorize an action.
-- This is the form of ControllersSpecification that all callers must go through to ensure deduplication.
data ControllerSets = ControllerSets (Set.Set (Set.Set Party))

makeControllerSets : [[Party]] -> ControllerSets
makeControllerSets controllers = ControllerSets $ Set.fromList $ fmap Set.fromList controllers

getControllersSpecification : ControllerSets -> ControllersSpecification
getControllersSpecification (ControllerSets controllers) = ControllersSpecification $ fmap Set.toList $ Set.toList controllers

makeControllersSpecification : [[Party]] -> ControllersSpecification
makeControllersSpecification = getControllersSpecification . makeControllerSets

encodeControllerSets : ControllerSets -> Text
encodeControllerSets controllers = jsonEncodePartiesLists (getControllersSpecification controllers).controllers

encodeControllersSpecification : ControllersSpecification -> Text
encodeControllersSpecification = encodeControllerSets . makeControllerSets . (.controllers)

parseControllersSpecification : Text -> Either Text ControllersSpecification
parseControllersSpecification = fmap makeControllersSpecification . jsonDecodePartiesLists

validateControllersSpecification : CanAssert m => Text -> Optional ControllersSpecification -> m ()
validateControllersSpecification _ None = pure ()
validateControllersSpecification controllerType (Some ControllersSpecification{controllers}) = do
  require (controllerType <> "Controllers must not be empty") (not $ null controllers)
  require (controllerType <> "Controllers must not contain an empty controller set") (all (not . null) controllers)

allControllers : ControllersSpecification -> Set.Set Party
allControllers spec = Set.fromList $ concat spec.controllers

controllersPendingVote : Map.Map Party a -> ControllersSpecification -> ControllersSpecification
controllersPendingVote votes controllers =
  ControllersSpecification $ filter (not . null) $ fmap (filter (\p -> not $ Map.member p votes)) controllers.controllers

proposersPendingWithdrawal : Map.Map Party Bool -> [Party] -> [[Party]]
proposersPendingWithdrawal votes = fmap (\p -> [p]) . filter (\p -> Map.lookup p votes /= Some False)

checkPendingControllers : ControllersSpecification -> [Party] -> Map.Map Party Bool -> Update ()
checkPendingControllers controllers actors votes =
  require' ("actors", actors) (oneOfR isSubsetOfR) ("controllers", (controllersPendingVote votes controllers).controllers)
