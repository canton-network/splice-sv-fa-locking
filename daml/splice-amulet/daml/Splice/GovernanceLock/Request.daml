{-# LANGUAGE ApplicativeDo #-}

module Splice.GovernanceLock.Request (
  -- * Token standard implementation
  governanceLock_transferFactoryV1_transferImpl,

  -- * Lock requests
  GovernanceLockRequest(..),
  GovernanceLockRequestTag(..),
  governanceLockRequestTagToText,
  parseGovernanceLockRequestTSv1,

  -- * Parsers (for testing only)
  governanceLockMemoParser,
  governanceLockTagParser,
  governanceLockKindParser,
  fullLockSpecificationParser,
  governanceLockRequestTSv1Parser,
) where

import DA.Action (unless)
import DA.Assert
import DA.Optional
import DA.Text qualified as Text
import DA.Time
import DA.Validation

import Splice.Amulet.TokenApiUtils
import Splice.AmuletConfig (GovernanceLockConfig)
import Splice.AmuletRules
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.ExternalPartyConfigState
import Splice.GovernanceLock
import Splice.GovernanceLock.Substitution
import Splice.GovernanceLock.Transfer
import Splice.TokenStandard.Utils hiding (require, reasonMetaKey)
import Splice.Util
import Splice.Util.Memo
import Splice.Util.Parser

data GovernanceLockRequest
  = GLR_CreateGovernanceLock with
      fullSpecification : FullLockSpecification
  | GLR_UnlockGovernanceLock with
      fullSpecification : FullLockSpecification
      unlockAmount : Decimal
      vestingStartTime : Optional Time
        -- ^ `None` for provisional featured app locks, as they do not vest.
  | GLR_TransferLock with
      specification : GovernanceLockSpecification
      newOwner : Party
      transferAmount : Decimal
  | GLR_WithdrawVestingLock with
      vestingSpecification : VestingLockSpecification
      vestedUntilTime : Time
  | GLR_SubstituteLock with
      target : GovernanceLockKey
  deriving (Show)

data GovernanceLockRequestTag
  = GLRT_CreateLock
  | GLRT_UnlockAndStartVesting
  | GLRT_TransferLock
  | GLRT_WithdrawVestedFunds
  | GLRT_SubstituteLock
  deriving (Eq, Enum, Bounded)

governanceLockRequestTagToText : GovernanceLockRequestTag -> Text
governanceLockRequestTagToText GLRT_CreateLock = "create-lock"
governanceLockRequestTagToText GLRT_UnlockAndStartVesting = "unlock-and-start-vesting"
governanceLockRequestTagToText GLRT_TransferLock = "transfer-lock"
governanceLockRequestTagToText GLRT_WithdrawVestedFunds = "withdraw-vested-funds"
governanceLockRequestTagToText GLRT_SubstituteLock = "substitute-lock"

governanceLockRequestTagFromText : Text -> Optional GovernanceLockRequestTag =
  dataFromText governanceLockRequestTagToText [minBound .. maxBound]

-- TSv1 support
---------------

governanceLock_transferFactoryV1_transferImpl
  :  Party
  -> [Party]
  -> V1.TransferFactory_Transfer
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_transferImpl dso actors arg@V1.TransferFactory_Transfer{expectedAdmin, transfer, extraArgs} = do
  checkActors actors [[transfer.sender]]

  -- validate call to factory and retrieve context
  requireMatchExpected ("admin", expectedAdmin) dso
  requireMatchExpected ("instrumentId", transfer.instrumentId) (amuletInstrumentId dso)
  assertInPast24Hours "transfer.requestedAt" transfer.requestedAt
  assertWithinDeadline "transfer.executeBefore" transfer.executeBefore

  (context, state) <- unfeaturedPaymentContextAndConfigFromChoiceContext dso extraArgs.context
  request <- parseGovernanceLockRequestTSv1 dso transfer.receiver state.governanceLockConfig transfer.meta

  case request of
    GLR_CreateGovernanceLock{fullSpecification} ->
      governanceLock_transferFactoryV1_lockImpl dso arg fullSpecification
    GLR_UnlockGovernanceLock{fullSpecification, unlockAmount, vestingStartTime} ->
      governanceLock_transferFactoryV1_unlockImpl dso arg fullSpecification unlockAmount vestingStartTime context state
    GLR_TransferLock{specification,  newOwner, transferAmount} ->
      governanceLock_transferFactoryV1_transferLockImpl
        arg
        GovernanceLockKey with
          dso
          owner = transfer.sender
          specification
        newOwner
        transferAmount
    GLR_WithdrawVestingLock{vestingSpecification, vestedUntilTime} ->
      governanceLock_transferFactoryV1_withdrawVestedFundsImpl dso arg vestingSpecification vestedUntilTime context state
    GLR_SubstituteLock{target} ->
      governanceLock_transferFactoryV1_substituteImpl dso arg target context state

governanceLock_transferFactoryV1_lockImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> FullLockSpecification
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_lockImpl dso V1.TransferFactory_Transfer{transfer, extraArgs} specification = do
  (lock, lockCid, changeCid) <- governanceLock_lockForGovernance_impl
    dso transfer.amount transfer.inputHoldingCids specification extraArgs transfer.sender transfer.requestedAt (reasonFromMeta transfer.meta)

  -- Sanity check that the output transfer matches the input (excluding some fields which we expect to differ)
  let lockTransfer = (view $ toInterface @V1.TransferInstruction lock).transfer
  requireMatchExpected ("lock transfer", lockTransfer) transfer with
    amount = lockTransfer.amount
    executeBefore = lockTransfer.executeBefore
    inputHoldingCids = lockTransfer.inputHoldingCids
    meta = lockTransfer.meta

  pure $ V1.TransferInstructionResult with
    output = V1.TransferInstructionResult_Pending with
      transferInstructionCid = toInterfaceContractId $ lockCid
    senderChangeCids = optionalToList $ toInterfaceContractId <$> changeCid
    meta = emptyMetadata

governanceLock_transferFactoryV1_unlockImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> FullLockSpecification
  -> Decimal
  -> Optional Time
  -> ExternalPartyTransferContext
  -> ExternalPartyConfigState
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_unlockImpl dso V1.TransferFactory_Transfer{transfer} specification unlockAmount vestingStartTime context state = do
  let key = GovernanceLockKey with
        dso
        owner = transfer.sender
        specification = GLS_FullLock specification
      reason = reasonFromMeta transfer.meta
  FetchAndMergeLocksResult{lockCid, lock} <- fetchAndMergeGovernanceLocks key context state reason
  potentiallyUnsafeArchive lockCid
  result <- governanceLock_unlockImpl lockCid lock unlockAmount vestingStartTime [transfer.sender] context state reason
  pure V1.TransferInstructionResult with
    output = case result.vestingLock of
      Some vestingLock -> V1.TransferInstructionResult_Pending with
        transferInstructionCid = toInterfaceContractId vestingLock
      None -> V1.TransferInstructionResult_Completed with
        receiverHoldingCids = []
    senderChangeCids = optionalToList $ fmap toInterfaceContractId result.unlockedAmulet
    meta = emptyMetadata

governanceLock_transferFactoryV1_transferLockImpl
  :  V1.TransferFactory_Transfer
  -> GovernanceLockKey
  -> Party
  -> Decimal
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_transferLockImpl V1.TransferFactory_Transfer{transfer = inputTransfer, extraArgs} source newOwner transferAmount = do
  (transferCid, transfer) <- createGovernanceLockTransfer LockTransferArgs with
    source
    receiver = newOwner
    amount = transferAmount
    requestedAt = inputTransfer.requestedAt
    extraArgs

  -- Sanity check that the output transfer matches the input (excluding some fields which we expect to differ)
  let outputTransfer = (view $ toInterface @V1.TransferInstruction transfer).transfer
  requireMatchExpected ("transfer", outputTransfer) inputTransfer with
    -- The receiver of the transfer is the new owner, not `lockManagerParty`
    receiver = newOwner
    amount = outputTransfer.amount
    executeBefore = outputTransfer.executeBefore
    inputHoldingCids = outputTransfer.inputHoldingCids
    meta = transferGovernanceLockMetadata source.specification

  pure V1.TransferInstructionResult with
    output = V1.TransferInstructionResult_Pending with
      transferInstructionCid = toInterfaceContractId transferCid
    senderChangeCids = []
    meta = emptyMetadata

governanceLock_transferFactoryV1_withdrawVestedFundsImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> VestingLockSpecification
  -> Time
  -> ExternalPartyTransferContext
  -> ExternalPartyConfigState
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_withdrawVestedFundsImpl dso V1.TransferFactory_Transfer{..} specification vestedUntilTime context state = do
  let key = GovernanceLockKey with
        dso
        owner = transfer.sender
        specification = GLS_VestingLock specification
      reason = reasonFromMeta transfer.meta
  FetchAndMergeLocksResult{lockCid, lock} <- fetchAndMergeGovernanceLocks key context state reason
  potentiallyUnsafeArchive lockCid
  result <- vestingLock_withdrawImpl lockCid lock vestedUntilTime [transfer.sender] context reason
  pure V1.TransferInstructionResult with
    output = case result.vestingLock of
      Some vestingLock -> V1.TransferInstructionResult_Pending with transferInstructionCid = toInterfaceContractId vestingLock
      None -> V1.TransferInstructionResult_Completed with receiverHoldingCids = []
    senderChangeCids = [result.vested]
    meta = emptyMetadata

governanceLock_transferFactoryV1_substituteImpl
  :  Party
  -> V1.TransferFactory_Transfer
  -> GovernanceLockKey
  -> ExternalPartyTransferContext
  -> ExternalPartyConfigState
  -> Update V1.TransferInstructionResult
governanceLock_transferFactoryV1_substituteImpl dso V1.TransferFactory_Transfer{..} target context state = do
  (substitutionCid, substitution, changeCid) <- createSubstitution
    CreateSubstitutionArgs with
      dso
      target
      owner = transfer.sender
      amount = transfer.amount
      inputHoldingCids = transfer.inputHoldingCids
      extraArgs
      requestedAt = transfer.requestedAt
      reason = reasonFromMeta transfer.meta
      context
      state

  -- Sanity check that the output transfer matches the input (excluding some fields which we expect to differ)
  let substitutionTransfer = (view substitution).transfer
  requireMatchExpected ("substitution transfer", substitutionTransfer) transfer with
    -- The receiver of the substitution is the owner of the target lock, not `lockManagerParty`
    receiver = substitutionTransfer.receiver
    executeBefore = substitutionTransfer.executeBefore
    inputHoldingCids = substitutionTransfer.inputHoldingCids
    meta = substitutionTransfer.meta

  pure V1.TransferInstructionResult with
    output = V1.TransferInstructionResult_Pending with
      transferInstructionCid = substitutionCid
    senderChangeCids = optionalToList $ toInterfaceContractId <$> changeCid
    meta = emptyMetadata

-- Parsers
----------

iso8601TimeFromTextParser : Text -> Text -> Parser i Time
iso8601TimeFromTextParser key input = validationParser $ validate $ case parseIso8601UtcTime input of
  Left e -> Left (errorInMemoKeyMessage key e)
  Right t -> Right t

iso8601TimeMemoParser : Text -> Parser Memo Time
iso8601TimeMemoParser key = requiredMemoFieldParser key >>= iso8601TimeFromTextParser key

governanceLockTagParser : Parser Memo GovernanceLockTag
governanceLockTagParser = requiredMemoFieldParser lockKindMemoKey >>= \tag ->
  validationParser $ (governanceLockTagFromText tag) <?> invalidMemoValueMessage "value" lockKindMemoKey tag

governanceLockSubjectParser : Parser Memo Text
governanceLockSubjectParser = requiredMemoFieldParser lockSubjectMemoKey

governanceLockKindParser : Parser Memo GovernanceLockKind
governanceLockKindParser = governanceLockTagParser >>= \tag ->
  governanceLockSubjectParser >>= governanceLockKindFromTagAndSubject tag

governanceLockMemoParser : Parser Metadata Memo
governanceLockMemoParser = Parser \meta -> runParser (memoParserWithAnyKeys cipMemoPrefix) (reasonFromMeta meta)

parseGovernanceLockMemo : CanAssert m => Metadata -> m Memo
parseGovernanceLockMemo = assertParsed governanceLockMemoParser

fullLockSpecificationParser : Parser Memo FullLockSpecification
fullLockSpecificationParser =
  FullLockSpecification <$>
    governanceLockKindParser <*>
    -- TODO(canton-network/splice-sv-fa-locking#76): specify these
    pure None <*>
    pure None <*>
    pure None

vestingLockSpecificationParser : Parser Memo VestingLockSpecification
vestingLockSpecificationParser = do
  kind <- governanceLockKindParser
  vestingPeriod <- vestingDurationParser
  endTime <- vestingEndTimeParser
  pure $ VestingLockSpecification with
    kind
    vestingPeriod
    endTime
    -- TODO(canton-network/splice-sv-fa-locking#76): specify this
    vestingControllers = None

governanceLockSpecificationParser : LockState -> Parser Memo GovernanceLockSpecification
governanceLockSpecificationParser LS_Locked = GLS_FullLock <$> fullLockSpecificationParser
governanceLockSpecificationParser LS_Vesting = GLS_VestingLock <$> vestingLockSpecificationParser

glr_createGovernanceLock_parser : Parser Memo GovernanceLockRequest
glr_createGovernanceLock_parser =
  GLR_CreateGovernanceLock <$> fullLockSpecificationParser

glr_unlockGovernanceLock_parser : Optional GovernanceLockConfig -> Parser Memo GovernanceLockRequest
glr_unlockGovernanceLock_parser config =
  liftA2 (,) fullLockSpecificationParser unlockAmountParser >>= \(spec, unlockAmount) ->
    GLR_UnlockGovernanceLock spec unlockAmount <$> vestingStartTimeParser spec.kind config

glr_withdrawVestingLock_parser : Parser Memo GovernanceLockRequest
glr_withdrawVestingLock_parser =
  GLR_WithdrawVestingLock <$>
    vestingLockSpecificationParser <*>
    vestedUntilTimeParser

lockStateParser : Parser Memo LockState
lockStateParser = optionalMemoFieldParser lockStatusMemoKey >>= \case
  None -> pure LS_Locked
  Some t | Some state <- lockStateFromText t -> pure state
  Some t -> assertFail $ invalidMemoValueMessage "value" lockStatusMemoKey t

glr_transferLock_parser : Parser Memo GovernanceLockRequest
glr_transferLock_parser = do
  targetState <- lockStateParser
  specification <- governanceLockSpecificationParser targetState
  newOwner <- partyMemoFieldParser newLockOwnerMemoKey
  transferAmount <- transferAmountParser
  pure GLR_TransferLock with
    specification
    newOwner
    transferAmount

glr_substituteLock_parser : Party -> Parser Memo GovernanceLockRequest
glr_substituteLock_parser dso = do
  targetState <- lockStateParser
  targetOwner <- partyMemoFieldParser targetLockOwnerMemoKey
  specification <- governanceLockSpecificationParser targetState
  pure $ GLR_SubstituteLock GovernanceLockKey with
    dso
    owner = targetOwner
    specification

governanceLockRequestTagParser : Parser Memo GovernanceLockRequestTag
governanceLockRequestTagParser = do
  request <- requiredMemoFieldParser requestMemoKey
  case governanceLockRequestTagFromText request of
    Some tag -> pure tag
    None -> assertFail $ "Invalid request: '" <> request <> "'"

governanceLockRequestTSv1Parser : Party -> Party -> Optional GovernanceLockConfig -> Parser Memo GovernanceLockRequest
governanceLockRequestTSv1Parser dso receiver config = governanceLockRequestTagParser >>= (\tag -> checkReceiverIsLockManager *> case tag of
    GLRT_CreateLock -> do glr_createGovernanceLock_parser
    GLRT_UnlockAndStartVesting -> glr_unlockGovernanceLock_parser config
    GLRT_TransferLock -> glr_transferLock_parser
    GLRT_WithdrawVestedFunds -> glr_withdrawVestingLock_parser
    GLRT_SubstituteLock -> glr_substituteLock_parser dso)
  where
    checkReceiverIsLockManager : Parser Memo ()
    checkReceiverIsLockManager =
      unless (receiver == lockManagerParty) $ assertFail ("Invalid receiver: '" <> show receiver <> "'")

parseGovernanceLockRequestTSv1 : CanAssert m => Party -> Party -> Optional GovernanceLockConfig -> Metadata -> m GovernanceLockRequest
parseGovernanceLockRequestTSv1 dso receiver config meta = do
  memo <- parseGovernanceLockMemo meta
  assertParsed (governanceLockRequestTSv1Parser dso receiver config) memo

amountParser : Text -> Parser Memo Decimal
amountParser key = requiredMemoFieldParser key >>= \t ->
  validationParser $ (Text.parseDecimal t) <?> invalidMemoValueMessage "decimal" key t

unlockAmountParser : Parser Memo Decimal
unlockAmountParser = amountParser unlockAmountMemoKey

transferAmountParser : Parser Memo Decimal
transferAmountParser = amountParser transferAmountMemoKey

vestingStartTimeParser : GovernanceLockKind -> Optional GovernanceLockConfig -> Parser Memo (Optional Time)
vestingStartTimeParser kind config =
  if vestingDurationFor kind config == days 0
    then pure None
    else Some <$> iso8601TimeMemoParser vestingStartTimeMemoKey

vestedUntilTimeParser : Parser Memo Time
vestedUntilTimeParser = iso8601TimeMemoParser vestedUntilTimeMemoKey

vestingDurationParser : Parser Memo RelTime
vestingDurationParser = relTimeFromMicrosecondsMemoFieldParser lockVestingDurationMemoKey

vestingEndTimeParser : Parser Memo Time
vestingEndTimeParser = timeFromMicrosecondsMemoFieldParser lockVestingEndTimeMemoKey
