{-# LANGUAGE ApplicativeDo #-}

module Splice.Util.Parser (
  Parser(..),
  runParser,
  assertParsed,

  -- * Parser instances
  inputParser,
  validationParser,
  boolParser,
  intParser,
  relTimeFromMicrosecondsParser,
  timeFromMicrosecondsParser,
  partyParser,
) where

import DA.Date
import DA.NonEmpty qualified as NonEmpty
import DA.Text qualified as Text
import DA.Time
import DA.Validation

-- | A parser of an input `i` into an output `o`.
--
-- Parsers form a monad ("action" in Daml parlance). Combining them with `<*>`
-- reports the errors of all of them, as for `Validation`, while `>>=` stops at
-- the first error, as the second parser depends on the output of the first one.
--
-- `do` blocks of parsers need the `ApplicativeDo` extension to report all
-- errors. Without it, a `do` block desugars into `>>=` and `>>`, and the
-- Daml-LF conversion replaces `x >> y` with `x >>= \_ -> y`, so even
-- `do { p1; p2; p2}` with independent `p*` stop at the first error. With
-- `ApplicativeDo`, statements that do not depend on each other are combined
-- with `<*>` instead even if it is an `a <- pa` statement.
--
-- For all independent statements to be combined with `<*>` including the last
-- one, the `do`-block must end with literally `pure x` or `pure $ x`:
-- GHC recognises the final return only by its shape, and any other final
-- statement is joined with a bind:
--
-- For example, we want compiler to produce
-- `(\a b c -> E) <$> pa <*> pb <*> pc` from `do { pa; pb; pc; pure E}`.
-- We want to avoid
-- `join ((\a b c -> pure . f $ E) <$> pa <*> pb <*> pc)` coming from
-- `do { pa; pb; pc; pure . f $ E}` where `f` is itself pure.
data Parser i o = Parser (i -> Validation Text o)

runParser : Parser i o -> i -> Validation Text o
runParser (Parser f) input = f input

instance Functor (Parser i) where
  fmap f parser = Parser \input -> f <$> runParser parser input

instance Applicative (Parser i) where
  pure output = Parser \_ -> ok output
  parserF <*> parserX = Parser \input -> runParser parserF input <*> runParser parserX input

instance Action (Parser i) where
  parser >>= f = Parser \input -> case runParser parser input of
    Errors es -> Errors es
    Success output -> runParser (f output) input

instance CanAssert (Parser i) where
  assertFail message = Parser \_ -> invalid message

assertParsed : CanAssert m => Parser i o -> i -> m o
assertParsed parser input =
  case runParser parser input of
    Success output -> pure output
    Errors (NonEmpty.NonEmpty e []) -> assertFail e
    Errors es -> do
      let errorsList = NonEmpty.toList es
      let numErrors = length errorsList
      assertFail $ "Found " <> show numErrors <> " parsing error" <> (if numErrors == 1 then "" else "s") <>
        (if length errorsList > 5 then ". First five errors" else  "") <> ":\n\n" <>
        Text.intercalate "\n" (take 5 errorsList)

-- | Returns the input of the parser.
inputParser : Parser i i
inputParser = Parser ok

-- | A parser that ignores its input and returns the given result.
validationParser : Validation Text o -> Parser i o
validationParser result = Parser \_ -> result

boolParser : Parser Text Bool
boolParser = do
  input <- inputParser
  case input of
    "true" -> pure True
    "false" -> pure False
    _ -> assertFail $ "Expected true or false, got: " <> input

-- | Parses an Int and maps it with the given function.
intParser' : Text -> (Int -> a) -> Parser Text a
intParser' kind map = do
  input <- inputParser
  validationParser $ (map <$> Text.parseInt input) <?> ("Invalid " <> kind <> ": '" <> input <> "'")

-- | Parses an Int.
intParser : Parser Text Int
intParser = intParser' "Int" identity

-- | Parses a RelTime written as microseconds.
relTimeFromMicrosecondsParser : Parser Text RelTime
relTimeFromMicrosecondsParser = intParser' "microseconds" convertMicrosecondsToRelTime

-- | Parses a Time written as microseconds since the epoch.
timeFromMicrosecondsParser : Parser Text Time
timeFromMicrosecondsParser = addRelTime (datetime 1970 Jan 1 0 0 0) <$> relTimeFromMicrosecondsParser

partyParser : Parser Text Party
partyParser = do
  input <- inputParser
  validationParser $ (partyFromText input) <?> ("Invalid party: '" <> input <> "'")
