-- | Tests for governance locks with custom controllers (CIP-0127).
--
-- A custom controller (charlie) can only vote through Token Standard v2. The scenarios that take
-- `GovernanceLockOperations` use it to create proposals and for the votes of the owner or receiver,
-- and `tsv2Operations` for the votes of charlie.
module Splice.Scripts.TestGovernanceLockCustomControllers where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (isSome)

import Daml.Script
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.GovernanceLock.Proposal
import Splice.GovernanceLock.Substitution
import Splice.Scripts.TestGovernanceLocks
import Splice.Scripts.TokenStandard.TestAmuletTokenStandardTestEnv
import Splice.Testing.Registries.AmuletRegistryV2 qualified as AmuletRegistryV2
import Splice.Testing.TokenStandard.WalletClientV2 qualified as WalletClientV2

-- Common setup
---------------

customControllersKind : GovernanceLockKind
customControllersKind = GLK_SuperValidatorRightsOwner "TestSV"

-- | `setupTest`, plus batching utilities for the parties that act through the wallet client in these tests,
-- which `setupTest` only creates for alice and bob. The instrument admin is the party that is a stakeholder
-- of every proposal but never a controller.
setupCustomControllersTest : Script TestEnv
setupCustomControllersTest = do
  env@TestEnv{..} <- setupTest
  forA_ [charlie, provider1, instrId.admin] WalletClientV2.createBatchingUtility
  pure env


testCustomControllers_unauthorized_tsv2
  :  (Template t, HasEnsure t, Eq t, Show t)
  => Script (TestEnv, ContractId GovernanceLock, GovernanceLock, ContractId t, t)
  -> Script ()
testCustomControllers_unauthorized_tsv2 setup = do
  (env@TestEnv{..}, lockCid, lock, proposalCid, proposal) <- setup
  let instructionCid = coerceContractId proposalCid
  expectFailureContaining "'actors' is not a subset of one of 'controllers'" =<<
    tsv2Operations.acceptInstruction env instructionCid instrId.admin
  expectFailureContaining "'actors' is not a subset of one of 'controllers'" =<<
    tsv2Operations.rejectInstruction env instructionCid instrId.admin
  expectFailureContaining "'actors' is not a subset of 'proposers'" =<<
    tsv2Operations.withdrawInstruction env instructionCid charlie
  checkLockUntouched alice proposalCid proposal
  checkLockUntouched alice lockCid lock

-- Transfer and substitution fixtures
-------------------------------------

-- | alice's lock in the transfer and substitution tests: transfers and substitutions also need charlie.
charlieSubstitutionSpecification : TestEnv -> GovernanceLockSpecification
charlieSubstitutionSpecification TestEnv{..} = GLS_FullLock FullLockSpecification with
  kind = customControllersKind
  unlockControllers = None
  substitutionControllers = Some $ makeControllersSpecification [[charlie]]
  vestingControllers = None

-- | The memo entries that set new controllers for bob's lock. No new unlock controllers.
newControllersMemoEntries : TestEnv -> [(Text, Text)]
newControllersMemoEntries TestEnv{..} =
  encodeGovernanceLockNewCustomControllersMemoEntries
    None
    (Some $ makeControllersSpecification [[bob, charlie]])
    (Some $ makeControllersSpecification [[bob], [charlie]])

-- | The specification of bob's new lock: the new controllers, and no unlock controllers, as none were given.
expectedNewLockSpecification : TestEnv -> GovernanceLockSpecification
expectedNewLockSpecification TestEnv{..} = GLS_FullLock FullLockSpecification with
  kind = customControllersKind
  unlockControllers = None
  substitutionControllers = Some $ makeControllersSpecification [[bob, charlie]]
  vestingControllers = Some $ makeControllersSpecification [[bob], [charlie]]

-- Substitution
---------------

-- | alice holds a 50000.0 lock that needs charlie for substitutions, and bob proposes to substitute 20000.0 of it,
-- with new controllers for his lock. The controllers of the proposal are {alice, bob, charlie}.
-- The proposal stays pending with bob's vote and holds bob's funds, and alice's lock is unchanged.
setupCustomSubstitution
  :  GovernanceLockOperations i r t
  -> Script (TestEnv, ContractId GovernanceLock, GovernanceLock, ContractId GovernanceLockSubstitution)
setupCustomSubstitution ops = do
  env@TestEnv{..} <- setupCustomControllersTest
  (lockCid, lock) <- lockWithSpec ops env alice 50000.0 (charlieSubstitutionSpecification env)
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 bob 20000.0
  result <- expectSuccess $ ops.proposeSubstitution (testEnvRegistries env) bob LockSubstitutionArgs with
    target = key lock
    amount = 20000.0
    requestedAt = None
    extraMemoEntries = newControllersMemoEntries env
  substitutionCid <- coerceContractId @_ @GovernanceLockSubstitution <$> ops.expectPendingTransfer result
  Some substitution <- queryContractId alice substitutionCid
  substitution.votes === Some (Map.fromList [(bob, PV_Accept)])
  assertMsg "the proposal must hold bob's funds" (isSome substitution.lockedAmulet)
  checkBalances env bob (0.0, 20000.0)
  checkLockUntouched alice lockCid lock
  pure (env, lockCid, lock, substitutionCid)

testCustomControllers_substitution_accept_tsv1 : Script ()
testCustomControllers_substitution_accept_tsv1 = testCustomControllers_substitution_accept tsv1Operations

testCustomControllers_substitution_accept_tsv2 : Script ()
testCustomControllers_substitution_accept_tsv2 = testCustomControllers_substitution_accept tsv2Operations

-- | The substitution needs both charlie and alice. alice gets the substituted funds, and bob's new lock gets
-- the new controllers of the proposal.
testCustomControllers_substitution_accept : GovernanceLockOperations i r t -> Script ()
testCustomControllers_substitution_accept ops = do
  (env@TestEnv{..}, _, lock, substitutionCid) <- setupCustomSubstitution ops

  -- charlie's vote leaves alice's vote pending
  charlieResult <- expectSuccess $ tsv2Operations.acceptInstruction env (coerceContractId substitutionCid) charlie
  pendingCid <- tsv2Operations.expectPendingTransfer charlieResult
  None <- queryContractId alice substitutionCid

  -- alice's vote completes the substitution
  [unlocked] <- ops.expectCompletedTransfer =<< expectSuccess (ops.acceptInstruction env (coerceContractId pendingCid) alice)
  WalletClientV2.checkHolding alice (coerceContractId unlocked) 20000.0
  None <- queryContractId alice (coerceContractId @_ @GovernanceLockSubstitution pendingCid)

  [(_, newLock)] <- governanceLocksOf bob
  newLock.amount === 20000.0
  newLock.specification === expectedNewLockSpecification env
  [(_, remaining)] <- governanceLocksOf alice
  remaining.amount === 30000.0
  remaining.specification === lock.specification

-- | charlie rejects the substitution, and bob gets his funds back.
testCustomControllers_substitution_reject_tsv2 : Script ()
testCustomControllers_substitution_reject_tsv2 = do
  (env@TestEnv{..}, lockCid, lock, substitutionCid) <- setupCustomSubstitution tsv2Operations

  [change] <- tsv2Operations.expectFailedTransfer =<<
    expectSuccess (tsv2Operations.rejectInstruction env (coerceContractId substitutionCid) charlie)
  WalletClientV2.checkHolding bob (coerceContractId change) 20000.0
  checkBalances env bob (20000.0, 0.0)
  None <- queryContractId alice substitutionCid
  checkLockUntouched alice lockCid lock

testCustomControllers_substitution_withdraw_tsv1 : Script ()
testCustomControllers_substitution_withdraw_tsv1 = testCustomControllers_substitution_withdraw tsv1Operations

testCustomControllers_substitution_withdraw_tsv2 : Script ()
testCustomControllers_substitution_withdraw_tsv2 = testCustomControllers_substitution_withdraw tsv2Operations

-- | bob withdraws the substitution after charlie accepted it, and gets his funds back.
testCustomControllers_substitution_withdraw : GovernanceLockOperations i r t -> Script ()
testCustomControllers_substitution_withdraw ops = do
  (env@TestEnv{..}, lockCid, lock, substitutionCid) <- setupCustomSubstitution ops
  charlieResult <- expectSuccess $ tsv2Operations.acceptInstruction env (coerceContractId substitutionCid) charlie
  pendingCid <- tsv2Operations.expectPendingTransfer charlieResult

  [change] <- ops.expectFailedTransfer =<< expectSuccess (ops.withdrawInstruction env (coerceContractId pendingCid) bob)
  WalletClientV2.checkHolding bob (coerceContractId change) 20000.0
  checkBalances env bob (20000.0, 0.0)
  None <- queryContractId alice (coerceContractId @_ @GovernanceLockSubstitution pendingCid)
  checkLockUntouched alice lockCid lock

-- | Only controllers can accept or reject, and only proposers can withdraw.
testCustomControllers_substitution_unauthorized_tsv2 : Script ()
testCustomControllers_substitution_unauthorized_tsv2 = testCustomControllers_unauthorized_tsv2 do
  let ops = tsv2Operations
  (env@TestEnv{..}, lockCid, lock, substitutionCid) <- setupCustomSubstitution ops
  Some substitution <- queryContractId alice substitutionCid
  pure (env, lockCid, lock, substitutionCid, substitution)

-- Self-substitution
--------------------

-- | alice holds a 50000.0 lock, all her funds, that needs charlie for substitutions.
setupCustomSelfSubstitution : GovernanceLockOperations i r t -> Script (TestEnv, ContractId GovernanceLock, GovernanceLock)
setupCustomSelfSubstitution ops = do
  env@TestEnv{..} <- setupCustomControllersTest
  AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 alice 49000.0 -- alice starts with 1000.0
  lockCid <- expectSuccess $ ops.governanceLock (testEnvRegistries env) alice 50000.0 (charlieSubstitutionSpecification env)
  Some lock <- queryContractId alice lockCid
  checkBalances env alice (0.0, 50000.0)
  pure (env, lockCid, lock)

-- | The specification of the lock that alice moves funds into: provider1 replaces charlie as substitution controller.
selfSubstitutionNewSpecification : TestEnv -> GovernanceLockSpecification
selfSubstitutionNewSpecification TestEnv{..} = GLS_FullLock FullLockSpecification with
  kind = customControllersKind
  unlockControllers = None
  substitutionControllers = Some $ makeControllersSpecification [[provider1]]
  vestingControllers = None

-- | alice proposes to move 20000.0 of her lock into a lock with substitution controller provider1.
-- The controllers of the proposal are {alice, charlie}. The proposal stays pending with alice's vote,
-- locks none of her funds, and her lock is unchanged.
proposeCustomSelfSubstitution
  :  HasField "senderChangeCids" r [ContractId h]
  => GovernanceLockOperations i r t -> TestEnv -> ContractId GovernanceLock -> GovernanceLock
  -> Script (ContractId GovernanceLockSubstitution)
proposeCustomSelfSubstitution ops env lockCid lock = do
  result <- expectSuccess $ ops.proposeSubstitution (testEnvRegistries env) env.alice LockSubstitutionArgs with
    target = key lock
    amount = 20000.0
    requestedAt = None
    extraMemoEntries = encodeGovernanceLockNewCustomControllersMemoEntries
      None
      (Some $ makeControllersSpecification [[env.provider1]])
      None
  result.senderChangeCids === []
  substitutionCid <- coerceContractId @_ @GovernanceLockSubstitution <$> ops.expectPendingTransfer result
  Some substitution <- queryContractId env.alice substitutionCid
  substitution.lockedAmulet === None
  substitution.votes === Some (Map.fromList [(env.alice, PV_Accept)])
  checkLockUntouched env.alice lockCid lock
  checkBalances env env.alice (0.0, 50000.0)
  pure substitutionCid

testCustomControllers_selfSubstitution_accept_tsv1 : Script ()
testCustomControllers_selfSubstitution_accept_tsv1 = testCustomControllers_selfSubstitution_accept tsv1Operations

testCustomControllers_selfSubstitution_accept_tsv2 : Script ()
testCustomControllers_selfSubstitution_accept_tsv2 = testCustomControllers_selfSubstitution_accept tsv2Operations

-- | charlie's vote completes the self-substitution. The target lock funds the new lock, so no funds are returned.
testCustomControllers_selfSubstitution_accept
  :  HasField "senderChangeCids" r [ContractId h]
  => GovernanceLockOperations i r t -> Script ()
testCustomControllers_selfSubstitution_accept ops = do
  (env@TestEnv{..}, lockCid, lock) <- setupCustomSelfSubstitution ops
  substitutionCid <- proposeCustomSelfSubstitution ops env lockCid lock

  result <- expectSuccess $ tsv2Operations.acceptInstruction env (coerceContractId substitutionCid) charlie
  result.senderChangeCids === []
  [] <- tsv2Operations.expectCompletedTransfer result
  None <- queryContractId alice substitutionCid
  None <- queryContractId alice lockCid

  [(_, newLock)] <- queryFilter @GovernanceLock alice \l -> l.specification == selfSubstitutionNewSpecification env
  newLock.amount === 20000.0
  [(_, remaining)] <- queryFilter @GovernanceLock alice \l -> l.specification == lock.specification
  remaining.amount === 30000.0
  checkBalances env alice (0.0, 50000.0)

testCustomControllers_selfSubstitution_rejectAndWithdraw_tsv1 : Script ()
testCustomControllers_selfSubstitution_rejectAndWithdraw_tsv1 = testCustomControllers_selfSubstitution_rejectAndWithdraw tsv1Operations

testCustomControllers_selfSubstitution_rejectAndWithdraw_tsv2 : Script ()
testCustomControllers_selfSubstitution_rejectAndWithdraw_tsv2 = testCustomControllers_selfSubstitution_rejectAndWithdraw tsv2Operations

-- | charlie rejects one self-substitution and alice withdraws another. Neither returns funds or changes the lock.
testCustomControllers_selfSubstitution_rejectAndWithdraw
  :  HasField "senderChangeCids" r [ContractId h]
  => GovernanceLockOperations i r t -> Script ()
testCustomControllers_selfSubstitution_rejectAndWithdraw ops = do
  (env@TestEnv{..}, lockCid, lock) <- setupCustomSelfSubstitution ops

  rejectedCid <- proposeCustomSelfSubstitution ops env lockCid lock
  [] <- tsv2Operations.expectFailedTransfer =<<
    expectSuccess (tsv2Operations.rejectInstruction env (coerceContractId rejectedCid) charlie)
  None <- queryContractId alice rejectedCid
  checkLockUntouched alice lockCid lock
  checkBalances env alice (0.0, 50000.0)

  withdrawnCid <- proposeCustomSelfSubstitution ops env lockCid lock
  [] <- ops.expectFailedTransfer =<< expectSuccess (ops.withdrawInstruction env (coerceContractId withdrawnCid) alice)
  None <- queryContractId alice withdrawnCid
  checkLockUntouched alice lockCid lock
  checkBalances env alice (0.0, 50000.0)
