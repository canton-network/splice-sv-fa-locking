-- | Tests for governance locks with custom controllers.
--
-- A custom controller can only vote through Token Standard v2. The scenarios use the given
-- `GovernanceLockOperations` to create the locks and the proposal, and `tsv2Operations` for the votes
-- of the custom controllers.
module Splice.Scripts.TestGovernanceLockCustomControllers where

import DA.Action (unless, void)
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Time
import Daml.Script

import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers
import Splice.GovernanceLock.Proposal qualified as Proposal
import Splice.GovernanceLock.Unlock
import Splice.GovernanceLock.Withdraw
import Splice.Scripts.TestGovernanceLocks
import Splice.Scripts.TokenStandard.TestAmuletTokenStandardTestEnv
import Splice.Testing.Registries.AmuletRegistryV2 qualified as AmuletRegistryV2
import Splice.Testing.TokenStandard.WalletClientV2 qualified as WalletClientV2
import Splice.TokenStandard.Utils (toAnyContractId)

setupCustomControllersTest : Script TestEnv
setupCustomControllersTest = do
  env@TestEnv{..} <- setupTest
  forA_ [charlie, provider1, instrId.admin] WalletClientV2.createBatchingUtility
  pure env

-- Substitution
---------------

testCustomControllers_substitution_fullLock_tsv1 : Script ()
testCustomControllers_substitution_fullLock_tsv1 = testCustomControllers_substitution tsv1Operations False False

testCustomControllers_substitution_fullLock_tsv2 : Script ()
testCustomControllers_substitution_fullLock_tsv2 = testCustomControllers_substitution tsv2Operations False False

testCustomControllers_substitution_vestingLock_tsv1 : Script ()
testCustomControllers_substitution_vestingLock_tsv1 = testCustomControllers_substitution tsv1Operations False True

testCustomControllers_substitution_vestingLock_tsv2 : Script ()
testCustomControllers_substitution_vestingLock_tsv2 = testCustomControllers_substitution tsv2Operations False True

testCustomControllers_selfSubstitution_fullLock_tsv1 : Script ()
testCustomControllers_selfSubstitution_fullLock_tsv1 = testCustomControllers_substitution tsv1Operations True False

testCustomControllers_selfSubstitution_fullLock_tsv2 : Script ()
testCustomControllers_selfSubstitution_fullLock_tsv2 = testCustomControllers_substitution tsv2Operations True False

testCustomControllers_selfSubstitution_vestingLock_tsv1 : Script ()
testCustomControllers_selfSubstitution_vestingLock_tsv1 = testCustomControllers_substitution tsv1Operations True True

testCustomControllers_selfSubstitution_vestingLock_tsv2 : Script ()
testCustomControllers_selfSubstitution_vestingLock_tsv2 = testCustomControllers_substitution tsv2Operations True True

-- | alice proposes to substitute 20000.0 of a lock that needs bob and charlie for substitutions, so the
-- controllers of the proposal are {alice, bob, charlie}. The target lock is alice's own for a self-substitution,
-- and provider1's otherwise. The proposal stays pending with bob's vote, and charlie's vote executes it.
testCustomControllers_substitution : GovernanceLockOperations i r t -> Bool -> Bool -> Script ()
testCustomControllers_substitution ops selfSubstitution vestingLock = do
  env@TestEnv{..} <- setupCustomControllersTest

  let targetOwner = if selfSubstitution then alice else provider1
      controllers = Some $ makeControllersSpecification [[bob, charlie]]
      kind = GLK_SuperValidatorRightsOwner "TestSV"
  (fullLockCid, fullLock) <- lockWithSpec ops env targetOwner 50000.0 $ GLS_FullLock FullLockSpecification with
    kind
    controllers = makeGovernanceLockControllers
      None
      (if vestingLock then None else controllers)
      (if vestingLock then controllers else None)
  (_, target) <- if vestingLock
    then vestingLockFor ops env targetOwner fullLockCid 50000.0
    else pure (fullLockCid, fullLock)
  unless selfSubstitution $ void $ AmuletRegistryV2.tapFaucet registriesEnv.amuletV2 alice 20000.0

  let newControllers = Some GovernanceLockControllers with
        unlockControllers = None
        substitutionControllers = None
        vestingControllers = Some $ makeControllersSpecification [[charlie]]
  requestedAt <- getTime
  substitutionCid <- ops.expectPendingTransfer =<<
    expectSuccess (ops.proposeSubstitution (testEnvRegistries env) alice LockSubstitutionArgs with
      target = key target
      amount = 20000.0
      requestedAt = Some requestedAt
      extraMemoEntries = encodeGovernanceLockNewCustomControllersMemoEntries newControllers)

  pendingCid <- tsv2Operations.expectPendingTransfer =<<
    expectSuccess (tsv2Operations.acceptInstruction env (coerceContractId substitutionCid) bob)
  _ <- tsv2Operations.expectCompletedTransfer =<<
    expectSuccess (tsv2Operations.acceptInstruction env pendingCid charlie)

  let expectedSpecification = setNewGovernanceLockControllers target.specification newControllers
  [(_, newLock)] <- queryFilter @GovernanceLock alice \l -> l.owner == alice && l.specification == expectedSpecification
  newLock === GovernanceLock with
    dso = target.dso
    owner = alice
    amount = 20000.0
    lockedAmulet = newLock.lockedAmulet
    specification = expectedSpecification
    originalLockCid = Some (toAnyContractId substitutionCid)
    requestedAt

  [(_, remainingLock)] <- queryFilter @GovernanceLock targetOwner \l -> l.owner == targetOwner && l.specification == target.specification
  remainingLock === GovernanceLock with
    dso = target.dso
    owner = targetOwner
    amount = 30000.0
    lockedAmulet = remainingLock.lockedAmulet
    specification = target.specification
    originalLockCid = Some (toAnyContractId fullLockCid)
    requestedAt = target.requestedAt

-- Unlock
---------

testCustomControllers_unlock_tsv1 : Script ()
testCustomControllers_unlock_tsv1 = testCustomControllers_unlock tsv1Operations

testCustomControllers_unlock_tsv2 : Script ()
testCustomControllers_unlock_tsv2 = testCustomControllers_unlock tsv2Operations

testCustomControllers_unlock : GovernanceLockOperations i r t -> Script ()
testCustomControllers_unlock ops = do
  env@TestEnv{..} <- setupCustomControllersTest

  let kind = GLK_FeaturedApp alice
      vestingPeriod = vestingDurationFor kind None
      unlockControllers = Some $ makeControllersSpecification [[alice, bob, charlie]]
      vestingControllers = Some $ makeControllersSpecification [[bob, charlie, provider1]]
      fullSpec = FullLockSpecification with
        kind
        controllers = makeGovernanceLockControllers unlockControllers None vestingControllers
      proposeUnlock lockCid proposer vestingStartTime extraMemoEntries = do
        result <- ops.optGovernanceUnlock (testEnvRegistries env) lockCid proposer (unlockMemo 20000.0 vestingStartTime <> extraMemoEntries)
        -- the helper types the pending instruction as a lock, but it's the unlock proposal
        pure $ fmap (fmap (coerceContractId @GovernanceLock @UnlockProposal)) result

  -- Happy path
  -------------

  (lockCid, lock) <- lockWithSpec ops env alice 50000.0 (GLS_FullLock fullSpec)
  vestingStartTime <- (`addRelTime` hours 1) <$> getTime
  Some unlockCid <- expectSuccess $ proposeUnlock lockCid bob vestingStartTime (targetLockOwnerMemoEntries $ key lock)
  Some unlock <- queryContractId bob unlockCid
  unlock === UnlockProposal with
    specification = UnlockProposalSpecification with
      dso = lock.dso
      owner = lock.owner
      fullSpec
      amount = 20000.0
      vestingStartTime
    proposers = [bob]
    votes = Map.singleton bob Proposal.PV_Accept
    requestedAt = unlock.requestedAt
    expiresAt = unlock.expiresAt
    originalProposalCid = None
  checkLockUntouched alice lockCid lock

  pendingCid <- tsv2Operations.expectPendingTransfer =<<
    expectSuccess (tsv2Operations.acceptInstruction env (coerceContractId unlockCid) alice)
  _ <- tsv2Operations.expectPendingTransfer =<<
    expectSuccess (tsv2Operations.acceptInstruction env pendingCid charlie)

  ([(_, vestingLock)], [(_, remainingLock)]) <- partition (isVestingLock . snd) <$> query @GovernanceLock alice

  vestingLock === GovernanceLock with
    dso = lock.dso
    owner = alice
    amount = 20000.0
    lockedAmulet = vestingLock.lockedAmulet
    specification = GLS_VestingLock VestingLockSpecification with
      kind
      vestingPeriod
      endTime = vestingStartTime `addRelTime` vestingPeriod
      vestingControllers
    originalLockCid = Some (toAnyContractId unlockCid)
    requestedAt = vestingStartTime

  remainingLock === GovernanceLock with
    dso = lock.dso
    owner = alice
    amount = 30000.0
    lockedAmulet = remainingLock.lockedAmulet
    specification = GLS_FullLock fullSpec
    originalLockCid = Some (toAnyContractId lockCid)
    requestedAt = lock.requestedAt

  -- Failures
  -----------

  now <- getTime
  (lockCid, lock) <- lockWithSpec ops env alice 50000.0 (GLS_FullLock fullSpec)

  -- target-lock-owner is required when the lock has custom controllers, regardless of whether the proposer is the lock owner
  expectFailureContaining "Missing memo key 'target-lock-owner'" =<< proposeUnlock lockCid alice vestingStartTime []
  expectFailureContaining "Missing memo key 'target-lock-owner'" =<< proposeUnlock lockCid bob vestingStartTime []

  -- vestingStartTime must be within the next 90 days
  expectFailureContaining "Ledger time is at or past deadline 'vestingStartTime'" =<<
    proposeUnlock lockCid bob (now `addRelTime` hours (-1)) (targetLockOwnerMemoEntries $ key lock)
  expectFailureContaining "Ledger time is strictly before deadline 'vestingStartTime - 90 days'" =<<
    proposeUnlock lockCid bob (now `addRelTime` days 91) (targetLockOwnerMemoEntries $ key lock)

  -- acceptance fails after vestingStartTime/expiresAt
  Some unlockCid <- expectSuccess $ proposeUnlock lockCid bob vestingStartTime (targetLockOwnerMemoEntries $ key lock)
  setTime $ vestingStartTime `addRelTime` seconds 1
  expectFailureContaining "Ledger time is at or past deadline 'expiresAt'" =<<
    tsv2Operations.acceptInstruction env (coerceContractId unlockCid) alice

-- Withdraw
-----------

testCustomControllers_withdraw_tsv1 : Script ()
testCustomControllers_withdraw_tsv1 = testCustomControllers_withdraw tsv1Operations

testCustomControllers_withdraw_tsv2 : Script ()
testCustomControllers_withdraw_tsv2 = testCustomControllers_withdraw tsv2Operations

testCustomControllers_withdraw : GovernanceLockOperations i r t -> Script ()
testCustomControllers_withdraw ops = do
  env@TestEnv{..} <- setupCustomControllersTest

  let fullSpec = GLS_FullLock FullLockSpecification with
        kind = GLK_FeaturedApp alice
        controllers = makeGovernanceLockControllers None None (Some $ makeControllersSpecification [[alice, bob, charlie]])
      setupLock = do
        (fullLockCid, _) <- lockWithSpec ops env alice 60000.0 fullSpec
        (vestingLockCid, vestingLock) <- vestingLockFor ops env alice fullLockCid 60000.0
        pure (fullLockCid, vestingLockCid, vestingLock)
      proposeWithdraw lockCid proposer vestedUntilTime extraMemoEntries = do
        result <- ops.vestingWithdraw env lockCid proposer (withdrawMemo vestedUntilTime <> extraMemoEntries)
        -- the helper types the pending instruction as a lock, but it's the withdrawal proposal
        pure $ fmap (fmap (coerceContractId @GovernanceLock @WithdrawVestedFundsProposal)) result

  -- Happy path
  -------------

  (fullLockCid, vestingLockCid, vestingLock) <- setupLock
  vestingSpec <- requireVestingLock vestingLock.specification

  -- vestingLockFor sets unlockAt to 1 hour in the future
  -- We calculate vestedUntilTime as that time + 20 days, which is 1/3 of the way into the vesting period (60 days)
  passTime (days 20 + hours 1 + seconds 1)
  vestedUntilTime <- (`addRelTime` seconds (-1)) <$> getTime

  Some withdrawCid <- expectSuccess $ proposeWithdraw vestingLockCid alice vestedUntilTime (targetLockOwnerMemoEntries $ key vestingLock)
  Some withdraw <- queryContractId alice withdrawCid
  withdraw === WithdrawVestedFundsProposal with
    specification = WithdrawVestedFundsSpecification with
      dso = vestingLock.dso
      owner = vestingLock.owner
      vestingSpec
      lockedAmount = vestingLock.amount
      vestedUntilTime
    proposers = [alice]
    votes = Map.singleton alice Proposal.PV_Accept
    requestedAt = withdraw.requestedAt
    expiresAt = withdraw.expiresAt
    originalProposalCid = None
  checkLockUntouched alice vestingLockCid vestingLock

  pendingCid <- tsv2Operations.expectPendingTransfer =<<
    expectSuccess (tsv2Operations.acceptInstruction env (coerceContractId withdrawCid) bob)
  _ <- tsv2Operations.expectPendingTransfer =<<
    expectSuccess (tsv2Operations.acceptInstruction env pendingCid charlie)

  [(_, remainingLock)] <- query @GovernanceLock alice
  remainingLock === GovernanceLock with
    dso = vestingLock.dso
    owner = alice
    amount = 40000.0
    lockedAmulet = remainingLock.lockedAmulet
    specification = GLS_VestingLock vestingSpec with vestingPeriod = days 40
    originalLockCid = Some (toAnyContractId fullLockCid)
    requestedAt = vestingLock.requestedAt

  -- Failures
  -----------

  now <- getTime
  (_, vestingLockCid, vestingLock) <- setupLock

  -- target-lock-owner is required when the lock has custom controllers, regardless of whether the proposer is the lock owner
  expectFailureContaining "Missing memo key 'target-lock-owner'" =<< proposeWithdraw vestingLockCid alice vestedUntilTime []
  expectFailureContaining "Missing memo key 'target-lock-owner'" =<< proposeWithdraw vestingLockCid bob vestedUntilTime []

  -- vestedUntilTime must be in the past
  expectFailureContaining "Ledger time is strictly before deadline 'vestedUntilTime'" =<<
    proposeWithdraw vestingLockCid bob (now `addRelTime` seconds 1) (targetLockOwnerMemoEntries $ key vestingLock)
