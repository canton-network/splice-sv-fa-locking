-- | Unit tests for the parsers of the governance lock metadata.
module Splice.Scripts.UnitTests.GovernanceLockParsers where

import DA.Assert
import DA.Date (Month(..), date)
import DA.NonEmpty qualified as NonEmpty
import DA.Optional
import DA.TextMap qualified as TextMap
import DA.Time (days, time)
import DA.Validation

import Daml.Script

import Splice.Amulet.TokenApiUtils (reasonMetaKey)
import Splice.Api.Token.MetadataV1
import Splice.GovernanceLock
import Splice.GovernanceLock.Controllers (makeControllersSpecification)
import Splice.GovernanceLock.Request
import Splice.Scripts.UnitTests.GovernanceLock (fullLockSpecification)
import Splice.Scripts.UnitTests.Memo
import Splice.Util.Memo

-- Test parties and helpers
---------------------------

testParty : Text -> Party
testParty = fromSomeNote "invalid test party" . partyFromText

alice : Party
alice = testParty "alice"

bob : Party
bob = testParty "bob"

charlie : Party
charlie = testParty "charlie"

testProvider : Party
testProvider = testParty "provider"

-- | Text that `partyFromText` rejects.
invalidParty : Text
invalidParty = "bad$party"

invalidSVName : Text
invalidSVName = "bad$SV"

-- Lock kind parser
-------------------

test_governanceLockTagParser : Script ()
test_governanceLockTagParser = do
  -- `GovernanceLockTag` has no `Show` instance, so compare the tags by their text
  let run t = runParser governanceLockTagParser (mkMemo [(lockKindMemoKey, t)])
      expectTag tag = expectSuccess (governanceLockTagToText tag) . fmap governanceLockTagToText

  expectTag GLT_FeaturedApp $ run "fa-lock"
  expectTag GLT_ProvisionalFeaturedApp $ run "provisional-fa-lock"
  expectTag GLT_SuperValidator $ run "sv-lock"

  -- The tag must be known, and the TSv1 receiver party format is not accepted
  expectErrors [invalidMemoValueMessage "value" lockKindMemoKey "unknown-lock"] $ governanceLockTagToText <$> run "unknown-lock"
  expectErrors [invalidMemoValueMessage "value" lockKindMemoKey "cip-127_sv-lock"] $ governanceLockTagToText <$> run "cip-127_sv-lock"

test_governanceLockKindParser : Script ()
test_governanceLockKindParser = do
  let run entries = runParser governanceLockKindParser (mkMemo entries)
      kind' k = (lockKindMemoKey, k)
      kind k = kind' $ governanceLockTagToText k
      subject s = (lockSubjectMemoKey, s)

  expectSuccess (GLK_FeaturedApp testProvider) $ run [kind GLT_FeaturedApp, subject "provider"]
  expectSuccess (GLK_ProvisionalFeaturedApp testProvider) $ run [kind GLT_ProvisionalFeaturedApp, subject "provider"]
  expectSuccess (GLK_SuperValidatorRightsOwner "someSv") $ run [kind GLT_SuperValidator, subject "someSv"]

  -- Kind and subject are required; a missing kind is reported before the subject is checked
  expectErrors [missingMemoKeyMessage lockSubjectMemoKey] $ run [kind GLT_FeaturedApp]
  expectErrors [missingMemoKeyMessage lockSubjectMemoKey] $ run [kind GLT_SuperValidator]
  expectErrors [missingMemoKeyMessage lockKindMemoKey] $ run [subject "provider"]
  expectErrors [missingMemoKeyMessage lockKindMemoKey] $ run []

  -- The lock kind must be known
  expectErrors [invalidMemoValueMessage "value" lockKindMemoKey "unknown-lock"] $ run [kind' "unknown-lock", subject "provider"]

  -- The subject of a featured app lock must be a party
  expectErrors [invalidLockSubjectMessage "provider" GLT_FeaturedApp invalidParty] $
    run [kind GLT_FeaturedApp, subject invalidParty]
  expectErrors [invalidLockSubjectMessage "provider" GLT_ProvisionalFeaturedApp invalidParty] $
    run [kind GLT_ProvisionalFeaturedApp, subject invalidParty]

  -- The subject of an SV lock must only contain alphanumeric characters or hyphens
  expectErrors [invalidLockSubjectMessage "SV name" GLT_SuperValidator invalidSVName] $
    run [kind GLT_SuperValidator, subject invalidSVName]

-- Memo parser
------------------

test_governanceLockMemoParser : Script ()
test_governanceLockMemoParser = do
  let run entries = runParser governanceLockMemoParser $ Metadata $ TextMap.fromList entries
      reason r = (reasonMetaKey, cipMemoPrefix <> r)
      otherEntry = ("other-key", "other-value")

  -- Without a reason field, an error is returned
  expectErrors ["Memo must start with " <> cipMemoPrefix] $ run []
  expectErrors ["Memo must start with " <> cipMemoPrefix] $ run [otherEntry, (lockSubjectMemoKey, "provider")]

  -- A reason without the `cipMemoPrefix` prefix fails
  expectErrors ["Memo must start with " <> cipMemoPrefix] $ run [(reasonMetaKey, lockSubjectMemoKey <> "=provider")]

  -- A single pair is parsed
  expectSuccess (mkMemo [(lockSubjectMemoKey, "provider")]) $
    run [reason $ lockSubjectMemoKey <> "=provider"]

  -- `&` separates the pairs, and the other fields are ignored
  expectSuccess
    (mkMemo [(lockSubjectMemoKey, "provider")])
    $ run [otherEntry, reason $ lockSubjectMemoKey <> "=provider"]

  -- An empty value is allowed
  expectSuccess (mkMemo [(lockSubjectMemoKey, "")]) $
    run [reason $ lockSubjectMemoKey <> "="]

  -- A pair without `=`
  expectErrors [invalidMemoFieldMessage lockSubjectMemoKey] $ run [reason lockSubjectMemoKey]

  -- A pair with more than one `=`
  expectErrors [invalidMemoFieldMessage $ lockSubjectMemoKey <> "=provider=x"] $
    run [reason $ lockSubjectMemoKey <> "=provider=x"]

  -- An empty reason, and an empty pair after a trailing `&`
  expectErrors [invalidMemoFieldMessage ""] $ run [reason ""]
  expectErrors [invalidMemoFieldMessage ""] $ run [reason $ lockSubjectMemoKey <> "=provider&"]

  -- All invalid pairs are reported
  expectErrors [invalidMemoFieldMessage "a", invalidMemoFieldMessage "b=c=d"] $
    run [reason $ "a&" <> lockSubjectMemoKey <> "=provider&b=c=d"]

-- Lock specification parser
----------------------------

test_fullLockSpecificationParser'
  :  (Text -> [(Text, Text)] -> Validation Text FullLockSpecification)
  -> Script ()
test_fullLockSpecificationParser' run = do
  -- Each controllers key is parsed into its own field
  let fullSpecification = (fullLockSpecification $ GLK_FeaturedApp testProvider) with
        unlockControllers = Some $ makeControllersSpecification [[alice]]
        substitutionControllers = Some $ makeControllersSpecification [[bob]]
        vestingControllers = Some $ makeControllersSpecification [[charlie]]
  expectSuccess fullSpecification $
    run (governanceLockTagToText GLT_FeaturedApp)
      [ (lockSubjectMemoKey, "provider")
      , (unlockControllersMemoKey, "[[\"alice\"]]")
      , (substitutionControllersMemoKey, "[[\"bob\"]]")
      , (vestingControllersMemoKey, "[[\"charlie\"]]")
      ]

  expectSuccess (fullLockSpecification $ GLK_SuperValidatorRightsOwner "someSv") $
    run (governanceLockTagToText GLT_SuperValidator) [(lockSubjectMemoKey, "someSv")]

  -- Invalid field
  expectErrors [invalidLockSubjectMessage "provider" GLT_FeaturedApp invalidParty] $
    run (governanceLockTagToText GLT_FeaturedApp) [(lockSubjectMemoKey, invalidParty)]

  -- Controllers must be a JSON list of lists of parties
  expectErrors [errorInMemoKeyMessage unlockControllersMemoKey "Invalid JSON list: 'alice'"] $
    run (governanceLockTagToText GLT_FeaturedApp) [(lockSubjectMemoKey, "provider"), (unlockControllersMemoKey, "alice")]

-- | The lock kind is read from the `lockKindMemoKey` field.
test_fullLockSpecificationParser : Script ()
test_fullLockSpecificationParser =
  test_fullLockSpecificationParser' \kind entries ->
    runParser fullLockSpecificationParser (mkMemo $ (lockKindMemoKey, kind) :: entries)

-- TSv1 request parser
----------------------

-- | `GovernanceLockRequest` has no `Eq` or `Show` instance, so the tests match on the parsed request.
expectRequest : Validation Text GovernanceLockRequest -> (GovernanceLockRequest -> Script ()) -> Script ()
expectRequest result check = case result of
  Success request -> check request
  Errors errors -> fail $ "Expected success, but got errors: " <> show errors

expectRequestErrors : [Text] -> Validation Text GovernanceLockRequest -> Script ()
expectRequestErrors expected result = case result of
  Errors errors -> NonEmpty.toList errors === expected
  Success _ -> fail "Expected errors, but got success"

test_governanceLockRequestTSv1Parser : Script ()
test_governanceLockRequestTSv1Parser = do
  let run receiver entries = runParser (governanceLockRequestTSv1Parser testAdmin receiver None) (mkMemo entries)
      request r = (requestMemoKey, r)
      faLock = [(lockKindMemoKey, governanceLockTagToText GLT_FeaturedApp), (lockSubjectMemoKey, "provider")]
      faSpecification = fullLockSpecification $ GLK_FeaturedApp testProvider
      invalidReceiverError p = "Invalid receiver: '" <> show p <> "'"

  -- Create a lock: the specification is parsed
  expectRequest (run lockManagerParty $ request "create-lock" :: (unlockAmountMemoKey, "1.0") :: faLock) \case
    GLR_CreateGovernanceLock{fullSpecification} -> fullSpecification === faSpecification
    _ -> fail "Expected GLR_CreateGovernanceLock"

  -- Create a lock
  expectRequest (run lockManagerParty $ request "create-lock" :: faLock) \case
    GLR_CreateGovernanceLock{fullSpecification} ->
      fullSpecification === faSpecification
    _ -> fail "Expected GLR_CreateGovernanceLock"

  -- Unlock with all fields set
  expectRequest
    (run lockManagerParty $
      request "unlock-and-start-vesting"
        :: (unlockAmountMemoKey, "10000.0")
        :: (vestingStartTimeMemoKey, "2026-01-01T00:00:00Z")
        :: faLock)
    \case
      GLR_UnlockGovernanceLock{fullSpecification, unlockAmount, vestingStartTime} -> do
        fullSpecification === faSpecification
        unlockAmount === 10000.0
        vestingStartTime === Some (time (date 2026 Jan 1) 0 0 0)
      _ -> fail "Expected GLR_UnlockGovernanceLock"

  -- Unlock without the vesting start time
  expectRequestErrors [missingMemoKeyMessage vestingStartTimeMemoKey] $
    run lockManagerParty (request "unlock-and-start-vesting" :: (unlockAmountMemoKey, "10000.0") :: faLock)

  -- Provisional featured app locks do not vest, so their unlock ignores the vesting start time
  let provisionalFaLock = [(lockKindMemoKey, governanceLockTagToText GLT_ProvisionalFeaturedApp), (lockSubjectMemoKey, "provider")]
      expectProvisionalUnlock entries = expectRequest (run lockManagerParty entries) \case
        GLR_UnlockGovernanceLock{fullSpecification, unlockAmount, vestingStartTime} -> do
          fullSpecification === fullLockSpecification (GLK_ProvisionalFeaturedApp testProvider)
          unlockAmount === 10000.0
          vestingStartTime === None
        _ -> fail "Expected GLR_UnlockGovernanceLock"
  expectProvisionalUnlock $ request "unlock-and-start-vesting" :: (unlockAmountMemoKey, "10000.0") :: provisionalFaLock
  expectProvisionalUnlock $
    request "unlock-and-start-vesting"
      :: (unlockAmountMemoKey, "10000.0")
      :: (vestingStartTimeMemoKey, "not-a-time")
      :: provisionalFaLock

  -- Transfer a lock: the new owner is read from the metadata
  expectRequest
    (run lockManagerParty $
      request "transfer-lock"
        :: (newLockOwnerMemoKey, "alice")
        :: (transferAmountMemoKey, "1.0")
        :: faLock)
    \case
      GLR_TransferLock{specification, newOwner, transferAmount} -> do
        specification === GLS_FullLock faSpecification
        newOwner === alice
        transferAmount === 1.0
      _ -> fail "Expected GLR_TransferLock"

  -- Withdraw vested funds: the vesting lock key and the vested-until time are read from the metadata
  expectRequest
    (run lockManagerParty $
      request "withdraw-vested-funds"
        :: (vestedUntilTimeMemoKey, "2025-12-01T00:00:00Z")
        -- 60 days in microseconds
        :: (lockVestingDurationMemoKey, "5184000000000")
        -- 2026-01-01T00:00:00Z in microseconds since the epoch
        :: (lockVestingEndTimeMemoKey, "1767225600000000")
        :: faLock)
    \case
      GLR_WithdrawVestingLock{vestingSpecification, vestedUntilTime} -> do
        vestingSpecification === VestingLockSpecification with
          kind = GLK_FeaturedApp testProvider
          vestingPeriod = days 60
          endTime = time (date 2026 Jan 1) 0 0 0
          vestingControllers = None
        vestedUntilTime === time (date 2025 Dec 1) 0 0 0
      _ -> fail "Expected GLR_WithdrawVestingLock"

  expectRequest
    (run lockManagerParty $
      request "withdraw-vested-funds"
        :: (vestedUntilTimeMemoKey, "2025-12-01T00:00:00Z")
        :: (lockVestingDurationMemoKey, "5184000000000")
        :: (lockVestingEndTimeMemoKey, "1767225600000000")
        :: faLock)
    \case
      GLR_WithdrawVestingLock{} -> pure ()
      _ -> fail "Expected GLR_WithdrawVestingLock"

  -- Withdraw without the vested-until time and the vesting lock key
  expectRequestErrors
    [ missingMemoKeyMessage lockVestingDurationMemoKey
    , missingMemoKeyMessage lockVestingEndTimeMemoKey
    , missingMemoKeyMessage vestedUntilTimeMemoKey
    ]
    $ run lockManagerParty (request "withdraw-vested-funds" :: faLock)

  -- The request is required and must be known
  expectRequestErrors [missingMemoKeyMessage requestMemoKey] $ run lockManagerParty faLock
  expectRequestErrors ["Invalid request: 'unlock'"] $ run lockManagerParty (request "unlock" :: faLock)

  -- Creating, unlocking and transferring a lock needs the lock manager as the receiver
  expectRequestErrors [invalidReceiverError alice] $ run alice (request "create-lock" :: faLock)
  expectRequestErrors [invalidReceiverError alice, missingMemoKeyMessage unlockAmountMemoKey] $
    run alice (request "unlock-and-start-vesting" :: faLock)
  expectRequestErrors [invalidReceiverError alice, missingMemoKeyMessage newLockOwnerMemoKey, missingMemoKeyMessage transferAmountMemoKey] $
    run alice (request "transfer-lock" :: faLock)
  expectRequestErrors
    [ invalidReceiverError alice
    , missingMemoKeyMessage lockVestingDurationMemoKey
    , missingMemoKeyMessage lockVestingEndTimeMemoKey
    , missingMemoKeyMessage vestedUntilTimeMemoKey
    ]
    $ run alice (request "withdraw-vested-funds" :: faLock)
  -- Substituting a lock also needs the lock manager as the receiver; all errors are reported
  expectRequestErrors [invalidReceiverError alice, missingMemoKeyMessage targetLockOwnerMemoKey] $
    run alice (request "substitute-lock" :: faLock)

  -- All invalid fields are reported
  expectRequestErrors
    [ invalidReceiverError alice
    , invalidLockSubjectMessage "provider" GLT_FeaturedApp invalidParty
    , invalidMemoValueMessage "decimal" unlockAmountMemoKey "not-a-decimal"
    ]
    $ run alice
        [ request "unlock-and-start-vesting"
        , (lockKindMemoKey, governanceLockTagToText GLT_FeaturedApp)
        , (lockSubjectMemoKey, invalidParty)
        , (unlockAmountMemoKey, "not-a-decimal")
        ]

-- Substitution parser
----------------------

-- | Registry admin passed to `governanceLockRequestTSv2Parser`.
testAdmin : Party
testAdmin = testParty "registry-admin"

-- | Parses a substitution request and returns its substitution.
-- Arguments: registry admin. Input: metadata to be converted to a compat mode memo.
substitutionTSv1Parser : Party -> Parser Memo GovernanceLockKey
substitutionTSv1Parser admin = governanceLockRequestTSv1Parser admin lockManagerParty None >>= \case
  GLR_SubstituteLock{target} -> pure target
  result -> assertFail $ "Expected GLR_SubstituteLock but got: " <> show result

-- | The metadata entry that requests a substitution.
substitutionRequest : (Text, Text)
substitutionRequest = (requestMemoKey, governanceLockRequestTagToText GLRT_SubstituteLock)

-- | Examples of the memo in the `allocation.meta` of an `AllocationFactory_Allocate` call that proposes a substitution.
--
-- The memo keys are written out on purpose, so that these tests also serve as examples of how to call the API.
-- The `request` key selects the substitution.
-- `target-lock-owner`, `lock-kind`, and `lock-status` specify the owner, kind, and state of the target lock.
test_substitutionTSv1Parser_examples : Script ()
test_substitutionTSv1Parser_examples = do
  let run entries = runParser (substitutionTSv1Parser testAdmin) (mkMemo entries)

  -- Minimal example: bob substitutes funds of the SV lock of alice for "someSv", for example a lock that alice
  -- created in compatibility mode.
  let
    testLockedSvLock : [(Text, Text)] -> Script ()
    testLockedSvLock moreEntries =
      expectSuccess
        (GovernanceLockKey with
          dso = testAdmin
          owner = alice
          specification = GLS_FullLock $ fullLockSpecification $ GLK_SuperValidatorRightsOwner "someSv")
        $ run $
            [ ("request", "substitute-lock")
            , ("lock-kind", "sv-lock")
            , ("lock-subject", "someSv")
            , ("target-lock-owner", "alice")
            ] <> moreEntries

  -- Leaving out `lock-status` defaults to a full lock
  testLockedSvLock []
  -- Including an explicit `lock-status=locked` parses a full lock
  testLockedSvLock [("lock-status", "locked")]

  -- Staking app example: alice locks funds for the featured app "provider", and a staking app (charlie) can
  -- approve substitutions together with the provider. Bob substitutes funds of that lock with a lock whose
  -- substitutions charlie can approve together with either bob or the provider.
  expectSuccess
    (GovernanceLockKey with
      dso = testAdmin
      owner = alice
      specification = GLS_FullLock $ fullLockSpecification $ GLK_FeaturedApp testProvider)
    $ run
        [ ("request", "substitute-lock")
        , ("lock-kind", "fa-lock")
        , ("lock-subject", "provider")
        , ("target-lock-owner", "alice")
        ]

  -- Vesting lock example: bob substitutes funds of a vesting lock of alice. A vesting target is selected with
  -- the state `vesting`, and must name its vesting period (60 days, in microseconds) and its end time
  -- (2026-01-01T00:00:00Z, in microseconds since the epoch).
  expectSuccess
    (GovernanceLockKey with
      dso = testAdmin
      owner = alice
      specification = GLS_VestingLock VestingLockSpecification with
        kind = GLK_SuperValidatorRightsOwner "someSv"
        vestingPeriod = days 60
        endTime = time (date 2026 Jan 1) 0 0 0
        vestingControllers = None)
    $ run
        [ ("request", "substitute-lock")
        , ("lock-kind", "sv-lock")
        , ("lock-subject", "someSv")
        , ("target-lock-owner", "alice")
        , ("lock-status", "vesting")
        , ("lock-vesting-duration-micros", "5184000000000")
        , ("lock-vesting-end-time-micros", "1767225600000000")
        ]

test_substitutionTSv1Parser_failures : Script ()
test_substitutionTSv1Parser_failures = do
  let run' entries = runParser (substitutionTSv1Parser testAdmin) (mkMemo $ substitutionRequest :: entries)
      run entries = run' $ (lockKindMemoKey, governanceLockTagToText GLT_SuperValidator) :: entries
      subject = (lockSubjectMemoKey, "someSv")
      targetOwner = (targetLockOwnerMemoKey, "alice")

  -- The target owner is required and must be a party
  expectErrors [missingMemoKeyMessage targetLockOwnerMemoKey] $ run [subject]
  expectErrors [errorInMemoKeyMessage targetLockOwnerMemoKey ("Invalid party: '" <> invalidParty <> "'")] $
    run [subject, (targetLockOwnerMemoKey, invalidParty)]

  -- The kind must name a known lock kind
  expectErrors [invalidMemoValueMessage "value" lockKindMemoKey "unknown"] $
    run' [(lockKindMemoKey, "unknown"), subject, targetOwner]

  -- The target state must be `locked` or `vesting`; an invalid state and an invalid owner are both reported
  expectErrors
    [ invalidMemoValueMessage "value" lockStatusMemoKey "unlocking"
    , errorInMemoKeyMessage targetLockOwnerMemoKey ("Invalid party: '" <> invalidParty <> "'")
    ]
    $ run [subject, (lockStatusMemoKey, "unlocking"), (targetLockOwnerMemoKey, invalidParty)]

  -- The new lock needs a lock subject
  expectErrors [missingMemoKeyMessage lockSubjectMemoKey] $ run [targetOwner]

  -- A vesting target needs a vesting period and end time
  expectErrors
    [ missingMemoKeyMessage lockVestingDurationMemoKey
    , missingMemoKeyMessage lockVestingEndTimeMemoKey
    ]
    $ run [subject, targetOwner, (lockStatusMemoKey, lockStateToText LS_Vesting)]

  -- The vesting period and end time must be integers; both invalid values are reported
  expectErrors
    [ errorInMemoKeyMessage lockVestingDurationMemoKey "Invalid microseconds: '60d'"
    , errorInMemoKeyMessage lockVestingEndTimeMemoKey "Invalid microseconds: '2026-01-01T00:00:00Z'"
    ]
    $ run
        [ subject
        , targetOwner
        , (lockStatusMemoKey, lockStateToText LS_Vesting)
        , (lockVestingDurationMemoKey, "60d")
        , (lockVestingEndTimeMemoKey, "2026-01-01T00:00:00Z")
        ]
